// =============================================================================
// P02 — GOVERN & CONTROL
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: AgentsInfo, AuditLogs, CloudAppEvents
// SCHEMA NOTES (validated against live tenant 2026-06-28):
//   AgentsInfo.Name (not AgentName) | Owners: dynamic, can be null
//   EntraAgentID (capital ID) | Both Timestamp and TimeGenerated exist
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Agents Without Entra Agent ID — Identity Orphans
// Use: Find agents running without a dedicated Entra identity (identity laundering risk)
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| where isempty(EntraAgentID)
| extend OwnerDisplay = iff(OwnersStr == "" or OwnersStr == "[]", "UNASSIGNED", OwnersStr)
| distinct AgentId, Name, Platform, OwnerDisplay, LifecycleStatus, PublishedStatus
| extend RiskNote = "Agent operates without dedicated Entra Agent ID — identity laundering risk"
| sort by Platform asc


// -----------------------------------------------------------------------------
// Q2: Agents Published Without Approval Flow — Copilot Studio Bypass
// Use: Detect agents activated via Agent Builder (M365 Copilot) bypassing
//      Copilot Studio Requests approval flow
// Note: Agent Builder agents appear immediately without approval events
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "AgentPublished"
| extend AgentSource = tostring(AdditionalDetails["AgentSource"])
| extend ApprovalStatus = tostring(AdditionalDetails["ApprovalStatus"])
| where AgentSource == "AgentBuilder"
    or ApprovalStatus == "Bypassed"
    or isempty(ApprovalStatus)
| project
    TimeGenerated,
    AgentId = tostring(TargetResources[0].id),
    AgentName = tostring(TargetResources[0].displayName),
    PublishedBy = tostring(InitiatedBy.user.userPrincipalName),
    AgentSource,
    ApprovalStatus
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q3: Agents Without Lifecycle Review — Stale in Production
// Use: Identify agents in production without activity in the review window
//      Signals candidates for decommission review
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(90d)
| extend OwnersStr = tostring(Owners)
| summarize LastActivity = max(Timestamp) by AgentId, Name, Platform, OwnersStr
| extend OwnerDisplay = iff(OwnersStr == "" or OwnersStr == "[]", "UNASSIGNED", OwnersStr)
| extend DaysSinceActivity = datetime_diff('day', now(), LastActivity)
| where DaysSinceActivity > 60
| extend LifecycleRisk = case(
    DaysSinceActivity > 180, "Critical — exceeds 6-month review window",
    DaysSinceActivity > 90,  "High — exceeds 3-month review window",
    "Medium — approaching review threshold"
)
| sort by DaysSinceActivity desc
| project AgentId, Name, Platform, OwnerDisplay, DaysSinceActivity, LifecycleRisk


// -----------------------------------------------------------------------------
// Q4: Graph Drift Detection — Agents With Accumulating Permissions
// Use: Identify agents whose permission scope has expanded over time
//      without corresponding approval events
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName in ("Add delegated permission grant", "Add app role assignment to service principal")
| extend AgentObjectId = tostring(TargetResources[0].id)
| extend NewPermission = tostring(TargetResources[0].modifiedProperties[0].newValue)
| extend GrantedBy = tostring(InitiatedBy.user.userPrincipalName)
| join kind=leftouter (
    AuditLogs
    | where OperationName == "AgentPermissionApproved"
    | distinct CorrelationId
) on CorrelationId
| where isempty(CorrelationId1)
| project
    TimeGenerated,
    AgentObjectId,
    NewPermission,
    GrantedBy,
    RiskNote = "Permission granted without corresponding approval event"
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q5: Maker Activity — Power Platform Agents Without DLP Policy Coverage
// Use: Detect agents created by makers using connectors outside DLP boundaries
// -----------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(30d)
| where Application == "Microsoft Power Platform"
    and ActionType == "AgentConnectorAdded"
| extend ConnectorName = tostring(RawEventData["ConnectorName"])
| extend ConnectorClassification = tostring(RawEventData["DLPClassification"])
| where ConnectorClassification == "NonBusiness"
    or isempty(ConnectorClassification)
| summarize
    ConnectorUses = count(),
    LastUsed = max(Timestamp),
    Makers = make_set(AccountDisplayName)
    by ConnectorName, ConnectorClassification
| sort by ConnectorUses desc
| project ConnectorName, ConnectorClassification, ConnectorUses, LastUsed, Makers
