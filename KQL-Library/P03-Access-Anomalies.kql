// =============================================================================
// P03 — SECURE ACCESS
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: CloudAppEvents, EntraIdSpnSignInEvents, AuditLogs
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Agents Accessing Resources Outside Their Declared Scope
// Use: Detect permission scope expansion — agents accessing more than intended
// -----------------------------------------------------------------------------
EntraIdSpnSignInEvents
| where Timestamp > ago(7d)
| where ServicePrincipalName has "agent"
| summarize
    ResourcesAccessed = make_set(ResourceDisplayName),
    AccessCount = count(),
    LastAccess = max(Timestamp)
    by ServicePrincipalId, ServicePrincipalName, AppId
| extend ResourceCount = array_length(ResourcesAccessed)
| where ResourceCount > 3   // Adjust threshold based on expected agent scope
| sort by ResourceCount desc
| project ServicePrincipalName, AppId, ResourceCount, ResourcesAccessed, AccessCount, LastAccess


// -----------------------------------------------------------------------------
// Q2: Identity Laundering — Actions Attributed to User Instead of Agent
// Use: Find operations where an agent acted under user identity
//      Audit trail shows user, but request originated from agent process
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where ActionType in ("FileDownloaded", "FileAccessed", "FileCopied", "SensitiveFileRead")
| extend UserAgent = tostring(RawEventData["UserAgent"])
| extend RequestSource = tostring(RawEventData["RequestSource"])
| where UserAgent has_any ("agent", "copilot", "assistant", "bot")
    and AccountType == "Regular"   // Logged as human user, not service principal
| project
    TimeGenerated,
    AccountDisplayName,
    ActionType,
    ObjectName,
    UserAgent,
    RequestSource,
    IPAddress,
    RiskNote = "Action attributed to user account but originated from agent process"
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q3: Unreviewed OAuth Consent Grants — Agents Accumulating Permissions
// Use: Identify OAuth consent grants to agent service principals without review
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Consent to application"
| extend ConsentedApp = tostring(TargetResources[0].displayName)
| extend ConsentedBy = tostring(InitiatedBy.user.userPrincipalName)
| extend ScopesGranted = tostring(TargetResources[0].modifiedProperties[0].newValue)
| extend IsHighPrivilege = ScopesGranted has_any (
    "Files.ReadWrite.All",
    "Mail.ReadWrite",
    "Directory.ReadWrite.All",
    "Sites.FullControl.All",
    "User.ReadWrite.All"
)
| where IsHighPrivilege == true
| project
    TimeGenerated,
    ConsentedApp,
    ConsentedBy,
    ScopesGranted,
    IsHighPrivilege,
    RiskNote = "High-privilege OAuth consent — verify agent scope is intentional"
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q4: Agent Sign-ins from Unexpected Locations or Times
// Use: Baseline deviation — agents operating outside normal parameters
// Note: Adjust expected hours and locations for your environment
// -----------------------------------------------------------------------------
EntraIdSpnSignInEvents
| where Timestamp > ago(7d)
| where ServicePrincipalName has "agent"
| extend HourOfDay = datetime_part("Hour", Timestamp)
| extend IsOffHours = HourOfDay < 6 or HourOfDay > 22
| where IsOffHours == true
| summarize
    OffHoursSignIns = count(),
    EarliestSignIn = min(Timestamp),
    LatestSignIn = max(Timestamp),
    LocationSet = make_set(Country)
    by ServicePrincipalName, AppId
| sort by OffHoursSignIns desc
| project ServicePrincipalName, AppId, OffHoursSignIns, EarliestSignIn, LatestSignIn, LocationSet


// -----------------------------------------------------------------------------
// Q5b: Capability & Architecture Disclosure — Agent Leaking Its Own Tool Schema
// Use: Detect agent responses that include internal tool definitions, system prompt
//      fragments, or parameter schemas — used by attackers as attack pivot to forge
//      consent tokens or craft tool-specific injection payloads
// Reference: Microsoft AIRT Taxonomy v2.0 §4.9 | No OWASP mapping yet (emerging)
// Recommended: Analytics Rule | Frequency: 15m | Lookback: 1h | Severity: Medium
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(1h)
| where Application in ("Microsoft Copilot", "Copilot Studio", "Azure AI Foundry")
    and ActionType == "AgentInteraction"
| extend ResponseText = tostring(RawEventData["AgentResponse"])
| extend PromptText = tostring(RawEventData["UserPrompt"])
| extend AgentId = tostring(RawEventData["AgentId"])
// Score for schema/tool disclosure patterns in agent response
| extend DisclosureScore = toint(
    (ResponseText has "\"type\": \"function\"") * 3 +
    (ResponseText has "\"parameters\":{") * 3 +
    (ResponseText has "system_prompt") * 3 +
    (ResponseText has "tool_use") * 2 +
    (ResponseText has "function_call") * 2 +
    (ResponseText has "\"description\":") * 1 +
    (ResponseText has "\"required\":") * 1
)
// Score for elicitation attempts in user prompt
| extend ElicitScore = toint(
    (PromptText has "what tools") * 2 +
    (PromptText has "list your functions") * 2 +
    (PromptText has "show your capabilities") * 2 +
    (PromptText has "what can you access") * 1 +
    (PromptText has "your system prompt") * 3 +
    (PromptText has "repeat your instructions") * 3
)
| where DisclosureScore >= 3 or ElicitScore >= 3
| project
    TimeGenerated,
    AccountDisplayName,
    AgentId,
    DisclosureScore,
    ElicitScore,
    PromptPreview = substring(PromptText, 0, 200),
    ResponsePreview = substring(ResponseText, 0, 300),
    IPAddress,
    RiskNote = "Agent may have disclosed tool schema or system prompt — potential attack pivot for forged consent"
| sort by DisclosureScore desc, ElicitScore desc


// -----------------------------------------------------------------------------
// Q6: Model Extraction via API — Anomalous Query Volume to AI Endpoints
// Use: Detect attackers systematically querying Azure AI Foundry or Copilot
//      endpoints to reconstruct the model through input/output pairs
//      Threshold: >500 AI API calls per hour from a single identity (adjust per baseline)
// Reference: OWASP Agentic AI AG06 — Model Extraction; Red Teaming AI Ch.6
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where Application in ("Azure AI Foundry", "Azure OpenAI", "Microsoft Copilot", "Copilot Studio")
    and ActionType in ("AIInference", "ModelInference", "AgentInteraction", "CompletionRequest")
| extend CallerIdentity = coalesce(
    tostring(RawEventData["CallerObjectId"]),
    AccountObjectId,
    AccountDisplayName
)
| extend ModelId = tostring(RawEventData["ModelId"])
| extend EndpointUrl = tostring(RawEventData["EndpointUrl"])
| summarize
    QueryCount = count(),
    DistinctPrompts = dcount(tostring(RawEventData["UserPrompt"])),
    FirstQuery = min(TimeGenerated),
    LastQuery = max(TimeGenerated)
    by CallerIdentity, ModelId, EndpointUrl, bin(TimeGenerated, 1h)
| where QueryCount > 500
| extend QueriesPerMinute = round(toreal(QueryCount) / 60.0, 1)
| extend ExtractionNote = "High-volume systematic queries — potential model extraction attempt"
| project
    CallerIdentity,
    ModelId,
    EndpointUrl,
    QueryCount,
    DistinctPrompts,
    QueriesPerMinute,
    FirstQuery,
    LastQuery,
    ExtractionNote
| sort by QueryCount desc


// -----------------------------------------------------------------------------
// Q5: PIM Activation Patterns for Agent Roles — Anomalous Elevation
// Use: Detect unusual PIM activation patterns for agent-associated privileged roles
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName == "Add member to role in PIM requested (permanent)"
    or OperationName == "Add member to role completed (PIM activation)"
| extend ActivatedRole = tostring(TargetResources[0].displayName)
| extend ActivatedBy = tostring(InitiatedBy.user.userPrincipalName)
| extend TargetPrincipal = tostring(TargetResources[1].displayName)
| where TargetPrincipal has "agent"
    or ActivatedRole has_any ("Global Admin", "Privileged Role", "Security Admin")
| project
    TimeGenerated,
    ActivatedRole,
    TargetPrincipal,
    ActivatedBy,
    OperationName
| sort by TimeGenerated desc
