// =============================================================================
// P04 — PROTECT DATA
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: CloudAppEvents, MicrosoftPurviewInformationProtection, OfficeActivity, CopilotActivity
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: High-Volume Agent Access to SharePoint — Potential Bulk Data Retrieval
// Use: Detect agents reading large volumes of files in short windows
//      Threshold: >100 operations in 10 minutes (adjust per baseline)
// Recommended: Use as Analytics Rule with 10-minute frequency
// Validated live (Oct 2026, Advanced Hunting): runs without errors. The validation tenant has real SharePoint
//      traffic (632 file operations in 7 days) but no agent-like user agent, so it returned no rows. Agent traffic
//      is guessed from UserAgent (see P01-Q4): confirm which user agents your agents send before relying on it.
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(1d)
| where Application == "Microsoft SharePoint Online"
    and ActionType in ("FileDownloaded", "FileAccessed", "FilePreviewed")
| extend UserAgent = tostring(RawEventData["UserAgent"])
| where UserAgent has_any ("agent", "copilot", "assistant", "power-automate")
| summarize
    OperationCount = count(),
    FileList = make_set(ObjectName, 20),
    FirstEvent = min(TimeGenerated),
    LastEvent = max(TimeGenerated)
    by AccountDisplayName, bin(TimeGenerated, 10m)
| where OperationCount > 100
| extend DurationSeconds = datetime_diff('second', LastEvent, FirstEvent)
| project
    AccountDisplayName,
    OperationCount,
    DurationSeconds,
    FileList,
    FirstEvent,
    LastEvent,
    RiskNote = "Agent bulk access — verify against expected retrieval scope"


// -----------------------------------------------------------------------------
// Q2: Sensitive Data in Agent Prompts — DLP Policy Matches
// Use: Identify prompts containing sensitive information types (SIT)
//      Requires Purview DLP policy with AI interactions workload enabled
// NOT VERIFIED (no data): the earlier version failed because MicrosoftPurviewInformationProtection has no Activity, UserAgent, SiteUrl, LabelId or PolicyDetails column (checked with getschema on the
//      validation workspace, Oct 2026): it holds label events (Operation, LabelName, SensitivityLabelId, ObjectId, UserId, Workload). File access
//      is in OfficeActivity (Operation, OfficeObjectId, Site_Url, UserAgent).
//      This version runs without errors on the validation workspace (Oct 2026) but returns no rows: that table has
//      no DLP events and no AIInteractions workload there. DLP rule matches that do exist (486 in 30 days) are in
//      OfficeActivity (RecordType ComplianceDLPSharePoint and ComplianceDLPExchange, Operation DLPRuleMatch or
//      DlpRuleMatch), without a PolicyDetails column. Confirm where DLP for AI interactions lands in your tenant.
// -----------------------------------------------------------------------------
MicrosoftPurviewInformationProtection
| where TimeGenerated > ago(7d)
| where Operation == "DLPRuleMatch"
    and Workload == "AIInteractions"
| extend SensitiveTypes = tostring(SensitiveInfoTypeData)
| extend MatchedRule = ExecutionRuleName
| summarize
    MatchCount = count(),
    LastMatch = max(TimeGenerated),
    AffectedUsers = dcount(UserId)
    by SensitiveTypes, PolicyName, MatchedRule
| sort by MatchCount desc
| project PolicyName, MatchedRule, SensitiveTypes, MatchCount, AffectedUsers, LastMatch


// -----------------------------------------------------------------------------
// Q3: Agent Access to Unlabeled Documents — Corpus Without Classification
// Use: Find agents reading documents without sensitivity labels applied
//      These are oversharing candidates — data the agent should not index
// Validated live (Oct 2026, Sentinel workspace): runs without errors. The earlier version failed because MicrosoftPurviewInformationProtection has no Activity, UserAgent, SiteUrl, LabelId or PolicyDetails column (checked with getschema on the
//      validation workspace, Oct 2026): it holds label events (Operation, LabelName, SensitivityLabelId, ObjectId, UserId, Workload). File access
//      is in OfficeActivity (Operation, OfficeObjectId, Site_Url, UserAgent).
//      Same logic and limits as P01-Q4: agent traffic is guessed from UserAgent, and label events record changes, not
//      the current label. It returned no rows on the validation tenant (no agent user agents). For Copilot
//      interactions, Q6 reads Copilot's own audit record instead of guessing from UserAgent.
// -----------------------------------------------------------------------------
let AgentUserAgents = dynamic(["agent", "copilot", "assistant", "bot", "power-automate"]);
let LabelLookback = 90d;
OfficeActivity
| where TimeGenerated > ago(7d)
| where RecordType == "SharePointFileOperation"
    and Operation in ("FileAccessed", "FileDownloaded")
| where UserAgent has_any (AgentUserAgents)
| join kind=leftouter (
    MicrosoftPurviewInformationProtection
    | where TimeGenerated > ago(LabelLookback)
    | where Operation in ("FileSensitivityLabelApplied", "SensitivityLabelApplied")
    | distinct ObjectId
) on $left.OfficeObjectId == $right.ObjectId
| where isempty(ObjectId)
| summarize
    UnlabeledAccesses = count(),
    DocumentList = make_set(OfficeObjectId, 10),
    LastAccess = max(TimeGenerated)
    by AccessedBy = UserId, Site_Url
| sort by UnlabeledAccesses desc
| project AccessedBy, Site_Url, UnlabeledAccesses, DocumentList, LastAccess


// -----------------------------------------------------------------------------
// Q4: External Connector Data Egress — Agent Sending Data Out
// Use: Detect agents sending data to external endpoints via connectors
//      This is the "silent exfiltration" vector — HTTPS to legitimate-looking endpoints
// NOT VERIFIED (live tenant, Oct 2026): runs without errors in Advanced Hunting and returns no rows. CloudAppEvents has
//      no "Microsoft Power Platform" application events there (applications seen: OneDrive, Microsoft 365, Exchange,
//      Azure, SharePoint, Teams), and ConnectorActionExecuted, TargetUrl and ResponseSizeBytes are not documented
//      values. The workspace lists a PowerPlatformDlpActivity table (Sentinel) that returned no rows. Treat as a template.
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where Application == "Microsoft Power Platform"
    and ActionType == "ConnectorActionExecuted"
| extend ConnectorName = tostring(RawEventData["ConnectorName"])
| extend TargetEndpoint = tostring(RawEventData["TargetUrl"])
| extend PayloadSize = toint(RawEventData["ResponseSizeBytes"])
| where isnotempty(TargetEndpoint)
    and TargetEndpoint !has "microsoft.com"
    and TargetEndpoint !has "azure.com"
| summarize
    EgressEvents = count(),
    TotalPayloadBytes = sum(PayloadSize),
    EndpointList = make_set(TargetEndpoint, 10),
    LastEgress = max(TimeGenerated)
    by ConnectorName, AccountDisplayName
| sort by TotalPayloadBytes desc
| extend TotalPayloadMB = round(toreal(TotalPayloadBytes) / 1048576, 2)
| project ConnectorName, AccountDisplayName, EgressEvents, TotalPayloadMB, EndpointList, LastEgress


// -----------------------------------------------------------------------------
// Q5a: Memory Poisoning Candidates — Memory Written During an Interaction the Platform Flagged
// Use: Find Copilot interactions that wrote to the user's persistent memory while the platform flagged the
//      interaction: a jailbreak attempt in a message (Q1) or a cross-prompt injection in a resource Copilot read
//      (Q10). A memory written under an injection outlives the session and shapes later interactions, which is
//      the persistent-instruction case of OWASP ASI06 (Memory & Context Poisoning).
// Distinction: corpus poisoning = injected in SharePoint docs the agent reads
//              memory poisoning = injected in the agent's persistent session memory
// Source: CopilotActivity, LLMEventData.MemoryUpdated (boolean), Messages[].JailbreakDetected and
//      AccessedResources[].XPIADetected. The earlier version matched phrases in RawEventData["MemoryContent"] on
//      CloudAppEvents InvokeAgent events: that key has no documented source, and no queryable table carries the
//      memory text.
// Response: the audit record says that memory was written, not what. Learn ("Manage Copilot personalization and
//      memory"): memories live in the user's mailbox in a hidden folder, are discoverable with Purview eDiscovery or
//      Content Search (item class IPM.Contact, folder CopilotMemory) and can be deleted through Microsoft Graph
//      Explorer together with Purview.
// Recommended: Analytics Rule | Frequency: 1h | Lookback: 1d | Severity: Medium
// NOT VERIFIED (live tenant, Oct 2026): MemoryUpdated is not in Learn's list of Copilot audit properties, and Learn
//      states that memory and personalization actions do not generate audit log entries in Purview, so what the flag
//      means is unconfirmed (it may report that memory was written, or only that the memory feature was in play).
//      The key is present on 3 of 151 interaction records on the validation workspace (180 days) and is false on
//      all 3, so a true value has never been seen. The query runs without errors; on those real records (with
//      MemoryUpdated == false and the flag filter removed) it returns actor, thread, app and IP; and on a datatable
//      it returned only the interactions that had memory written and a jailbreak or XPIA flag, and handled records
//      without Messages or AccessedResources.
// -----------------------------------------------------------------------------
CopilotActivity
| where TimeGenerated > ago(1d)
| where RecordType == "CopilotInteraction"
| where tobool(LLMEventData.MemoryUpdated) == true
| mv-apply Message = iff(array_length(LLMEventData.Messages) > 0, LLMEventData.Messages, dynamic([null])) on (
    summarize JailbreakFlagged = countif(tobool(Message.JailbreakDetected) == true) > 0)
| mv-apply Resource = iff(array_length(LLMEventData.AccessedResources) > 0, LLMEventData.AccessedResources, dynamic([null])) on (
    summarize
        XpiaFlagged = countif(tobool(Resource.XPIADetected) == true) > 0,
        FlaggedResources = make_set_if(tostring(Resource.SiteUrl), tobool(Resource.XPIADetected) == true, 5))
| where JailbreakFlagged or XpiaFlagged
| project
    TimeGenerated,
    ActorName,
    ActorUserId,
    AppIdentity,
    AppHost,
    SrcIpAddr,
    ThreadId = tostring(LLMEventData.ThreadId),
    JailbreakFlagged,
    XpiaFlagged,
    FlaggedResources,
    RecordId,
    RiskNote = "Memory written during an interaction the platform flagged: review the user's Copilot memory for injected instructions"
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q5b: Multi-Agent Lateral Movement — Agent Spawning or Calling Other Agents
// Use: Detect when a compromised agent pivots to invoke another agent
//      Trust boundary violation: Agent A calling Agent B without user authorization
// Reference: Anthropic Zero Trust for AI Agents — multi-agent trust boundaries
// NOT VERIFIED (live tenant, Oct 2026): the ActionTypes AgentInvokedAgent, AgentDelegation, SubAgentCreated and the keys
//      CallingAgentId and UserContext are not documented. Microsoft Learn (Agent 365 observability) documents InvokeAgent
//      with AgentId, TargetAgentId and UserKey inside RawEventData, which this query now uses. It runs without errors in
//      Advanced Hunting and returns nothing (no InvokeAgent events). Declared agent-to-agent links are in
//      AgentsInfo.ConnectedAgents (populated for 1 agent on the validation tenant).
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where Application in ("Copilot Studio", "Azure AI Foundry", "Microsoft Power Platform")
    and ActionType == "InvokeAgent"
| extend CallingAgent = tostring(RawEventData["AgentId"])
| extend TargetAgent = tostring(RawEventData["TargetAgentId"])
| extend CallerUserContext = tostring(RawEventData["UserKey"])
| where isnotempty(CallingAgent) and isnotempty(TargetAgent)
| summarize
    InvocationCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    UserContexts = make_set(CallerUserContext, 5)
    by CallingAgent, TargetAgent
| extend BlastRadiusNote = "Agent-to-agent call — verify user authorized both agents"
| sort by InvocationCount desc


// -----------------------------------------------------------------------------
// Q5c: Model Behavioral Anomaly — Proxy for Supply Chain Poisoning
// Use: Detect agents producing outputs inconsistent with their declared purpose
//      Supply chain context: 250 poisoned training docs can backdoor models
//      (Anthropic research). KQL cannot detect poisoning directly — but can
//      flag behavioral deviation post-deployment as an early warning signal.
// Reference: Anthropic Zero Trust for AI Agents — model supply chain
// NOTE: The ActionType was "AgentInteraction", which is not a documented value; it is now
//       "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       Response text is "not yet surfaced in advanced hunting" per Learn, so
//       RawEventData["AgentResponse"] has no documented source: pattern only. Not run
//       against live events (0 agent ActionTypes in the validation tenant, Oct 2026). It runs without errors in
//       Advanced Hunting. The external-reference "rate" was avgif(1, flag), which is 1 for any agent with a single
//       match and null otherwise, so the deviation could never be a rate; it is now the average of the 0/1 flag.
// -----------------------------------------------------------------------------
let AgentBaseline = CloudAppEvents
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where ActionType == "InvokeAgent"
    | extend AgentId = tostring(RawEventData["AgentId"])
    | extend ResponseLength = strlen(tostring(RawEventData["AgentResponse"]))
    | extend HasExternalRef = tostring(RawEventData["AgentResponse"]) has_any ("http://", "https://", "click here", "download", "visit")
    | summarize
        AvgResponseLength = avg(ResponseLength),
        ExternalRefRate = avg(toreal(HasExternalRef))
        by AgentId;
CloudAppEvents
| where TimeGenerated > ago(1d)
| where ActionType == "InvokeAgent"
| extend AgentId = tostring(RawEventData["AgentId"])
| extend ResponseLength = strlen(tostring(RawEventData["AgentResponse"]))
| extend HasExternalRef = tostring(RawEventData["AgentResponse"]) has_any ("http://", "https://", "click here", "download", "visit")
| summarize
    CurrentAvgLength = avg(ResponseLength),
    CurrentExternalRefRate = avg(toreal(HasExternalRef)),
    InteractionCount = count()
    by AgentId
| join kind=inner AgentBaseline on AgentId
| extend LengthDeviation = abs(CurrentAvgLength - AvgResponseLength) / max_of(AvgResponseLength, 1.0)
| extend RefRateDeviation = abs(CurrentExternalRefRate - ExternalRefRate)
| where LengthDeviation > 0.5 or RefRateDeviation > 0.3
| project AgentId, LengthDeviation = round(LengthDeviation, 2), RefRateDeviation = round(RefRateDeviation, 2), InteractionCount
| extend AnomalyNote = "Response pattern changed significantly vs. baseline — investigate for supply chain or poisoning"
| sort by LengthDeviation desc


// -----------------------------------------------------------------------------
// Q5: Prompt Injection Indicators — Repeated Anomalous Prompt Patterns
// Use: Identify patterns consistent with prompt injection in agent interactions
//      Focus: unusual instruction sequences, role override attempts
// Note: Pattern list is indicative — tune to your environment's prompt baseline
// NOTE: The ActionType was "AgentInteraction", which is not a documented value; it is now
//       "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       Prompt text is "not yet surfaced in advanced hunting" per Learn, so
//       RawEventData["UserPrompt"] has no documented source: pattern only. Not run against
//       live events (0 agent ActionTypes in the validation tenant, Oct 2026). It runs without errors in Advanced Hunting.
//       Learn documents platform flags instead of prompt text: Messages[].JailbreakDetected and
//       AccessedResources[].XPIADetected (cross prompt injection attack) in the Copilot audit record, available in the
//       CopilotActivity table (see P05-Q1, and P05-Q10 for the XPIA flag). Both keys exist on the validation workspace,
//       none is true.
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where Application in ("Microsoft Copilot", "Copilot Studio")
    and ActionType == "InvokeAgent"
| extend PromptText = tostring(RawEventData["UserPrompt"])
| extend HasInjectionPattern = PromptText has_any (
    "ignore previous instructions",
    "disregard your system prompt",
    "you are now",
    "act as if",
    "forget all previous",
    "new instructions:",
    "override:",
    "system:",
    "[[",
    "]]"
)
| where HasInjectionPattern == true
| summarize
    InjectionAttempts = count(),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated),
    PromptSamples = make_set(substring(PromptText, 0, 200), 3)
    by AccountDisplayName, IPAddress
| sort by InjectionAttempts desc
| project AccountDisplayName, IPAddress, InjectionAttempts, FirstAttempt, LastAttempt, PromptSamples


// -----------------------------------------------------------------------------
// Q6: Copilot Reads of Unlabeled or Sensitive Files — From Copilot's Own Audit Record
// Use: List the SharePoint and OneDrive files that Copilot accessed to answer a prompt, split by sensitivity
//      label state: files with no label (oversharing candidates: content Copilot can ground on that nobody
//      classified) and files that carry one of your sensitive labels. Unlike P01-Q4, P04-Q3 and P05-Q3, which
//      guess agent traffic from UserAgent in OfficeActivity, this reads the Copilot audit record itself:
//      AccessedResources lists each resource with its SensitivityLabelId, the action, the status and, when a
//      policy blocked or restricted the access, PolicyDetails (Blocked and Failures below).
// Source: CopilotActivity (Sentinel "Microsoft Copilot" connector), LLMEventData.AccessedResources (Microsoft
//      Learn, "Audit logs for Copilot and AI applications"). It covers Copilot interactions, including those of
//      custom agents built in Copilot Studio (AppIdentity Copilot.Studio.<AppId>); not agents that do not write
//      to this audit record.
// Recommended: Hunting query (daily) | Analytics Rule only after you list your sensitive label ids
// NOT VERIFIED (live tenant, Oct 2026): runs without errors on the validation workspace and returns no rows. The 3
//      interaction records there that list AccessedResources contain 2 resources, both web citations (no
//      SensitivityLabelId, Name or Status), so no file read has been seen yet. The grouping and the label logic
//      were run on a datatable shaped like Learn's AccessedResources example. It is not confirmed that a file with
//      no label omits SensitivityLabelId (rather than the record not reporting it): check it against a file you
//      know is unlabeled before treating "Unlabeled" as a finding.
// -----------------------------------------------------------------------------
let SensitiveLabelIds = dynamic([]);   // add the GUIDs of your sensitive labels
CopilotActivity
| where TimeGenerated > ago(1d)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| extend ResourceUrl = tostring(Resource.SiteUrl), LabelId = tostring(Resource.SensitivityLabelId)
| where ResourceUrl has ".sharepoint.com"
| extend LabelState = case(
    isempty(LabelId), "Unlabeled",
    LabelId in (SensitiveLabelIds), "Sensitive",
    "Labeled")
| where LabelState in ("Unlabeled", "Sensitive")
| summarize
    Accesses = count(),
    Users = dcount(ActorUserId),
    FirstAccess = min(TimeGenerated),
    LastAccess = max(TimeGenerated),
    Actions = make_set(tostring(Resource.Action), 5),
    Blocked = countif(isnotempty(tostring(Resource.PolicyDetails))),
    Failures = countif(tostring(Resource.Status) =~ "failure"),
    Apps = make_set(AppIdentity, 5)
    by LabelState, ResourceUrl, LabelId
| sort by LabelState asc, Accesses desc
