// =============================================================================
// P05 — DETECT & RESPOND
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: CopilotActivity, CloudAppEvents, OfficeActivity, MicrosoftPurviewInformationProtection, SecurityIncident, AuditLogs
// Re-run on 2026-10-05: Q1, Q3, Q4 and Q5 on a Sentinel workspace; Q2 and Q6 to Q9 in Advanced Hunting. Q2 and Q6 to Q9 have
//      no source data on the validation tenant (no agent ActionTypes in CloudAppEvents) and are patterns.
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Jailbreak Attempts — Platform-Detected Signal
// Use: Near-real-time detection of jailbreak attempts against Copilot/agent
//      interactions, using the platform's own JailbreakDetected signal.
// Note: CloudAppEvents has no "AgentInteraction" ActionType for this scenario
//       (verified live against a production tenant, Sep 2026). Jailbreak
//       detection lives in CopilotActivity (Azure Monitor / Log Analytics, filled by the Sentinel
//       "Microsoft Copilot" connector), inside LLMEventData.Messages: an array, requires mv-expand
//       (each message holds Id, isPrompt and JailbreakDetected; Microsoft Learn, "Audit logs for
//       Copilot and AI applications").
// Validated live (Oct 2026, Sentinel workspace): the earlier version read LLMActivity, which does not resolve
//       there (the editor underlines it and the query fails). The table is CopilotActivity (Learn table
//       reference), and Learn's sample-queries page for that table still shows the old name LLMActivity, so
//       copying the example fails. CopilotActivity holds 245 rows in 90 days on the validation workspace. Q1 now
//       runs and returned no rows: of 155 messages in 90 days, 7 carry the JailbreakDetected key and none is true
//       (checked with == false, which returns them with actor and message id). AgentName is empty on those
//       interactions (Copilot apps, not custom agents), and prompt and response text are not in the audit record
//       (Learn: use Content Search or DSPM for AI).
// Recommended: Analytics Rule | Frequency: 5m | Lookback: 1h | Severity: High
// -----------------------------------------------------------------------------
CopilotActivity
| where TimeGenerated > ago(1h)
| where RecordType == "CopilotInteraction"
| extend Messages = LLMEventData.Messages
| mv-expand Messages
| where tobool(Messages.JailbreakDetected) == true
| project
    TimeGenerated,
    ActorName,
    ActorUserId,
    AgentName,
    MessageId = tostring(Messages.Id),
    JailbreakDetected = tobool(Messages.JailbreakDetected)
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q2: Agent Behavioral Anomaly — Volume Spike Detection
// Use: Detect agents with call volume significantly above their 7-day baseline
//      Signals: compromised agent, looping behavior, orchestration attack
// Recommended: Analytics Rule | Frequency: 15m | Lookback: 1h
// NOTE: The ActionType was "AgentInteraction", which is not a documented value; it is now
//       "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       The count needs no prompt text, so this is the P05 query most likely to work once
//       agent telemetry exists. Not run against live events: the validation tenant has 0
//       agent ActionTypes in CloudAppEvents (30 days, Oct 2026), and Learn says telemetry is
//       dropped unless a tenant user holds a Microsoft 365 E7 or Agent 365 license and the
//       agent emits an invoke_agent span.
// Validated live (Oct 2026, Advanced Hunting): the earlier version nested aggregates (avg(count()) and
//       stdev(count())), which is invalid ("Function 'count' cannot be invoked in current context"), so it never
//       ran. It now counts calls per agent and hour first, then takes the average and standard deviation of those
//       counts, and runs without errors (no rows: there are no InvokeAgent events). Hours without calls are not in the
//       baseline, so it is the average of the active hours.
// -----------------------------------------------------------------------------
let Baseline = CloudAppEvents
    | where TimeGenerated between (ago(8d) .. ago(1d))
    | where ActionType == "InvokeAgent"
    | extend AgentId = tostring(RawEventData["AgentId"])
    | summarize HourlyCount = count() by AgentId, bin(TimeGenerated, 1h)
    | summarize
        BaselineAvg = avg(HourlyCount),
        BaselineStdDev = stdev(HourlyCount)
        by AgentId;
CloudAppEvents
| where TimeGenerated > ago(1h)
| where ActionType == "InvokeAgent"
| extend AgentId = tostring(RawEventData["AgentId"])
| summarize CurrentHourlyCount = count() by AgentId, bin(TimeGenerated, 1h)
| join kind=inner Baseline on AgentId
| extend DeviationsAboveBaseline = (CurrentHourlyCount - BaselineAvg) / max_of(BaselineStdDev, 1.0)
| where DeviationsAboveBaseline > 3
| project
    AgentId,
    CurrentHourlyCount,
    BaselineAvg = round(BaselineAvg, 1),
    DeviationsAboveBaseline = round(DeviationsAboveBaseline, 1),
    TimeGenerated,
    RiskNote = "Agent call volume exceeds 3 standard deviations above 7-day baseline"
| sort by DeviationsAboveBaseline desc


// -----------------------------------------------------------------------------
// Q3: Highly Confidential Document Access by Agent — Off-Hours
// Use: Detect agent accessing sensitive labeled documents outside business hours
//      Combine with P04-Q3 for full data protection coverage
// Recommended: Analytics Rule | Frequency: 15m | Severity: High
// Validated live (Oct 2026, Sentinel workspace): runs without errors. The earlier version failed because MicrosoftPurviewInformationProtection has no Activity, UserAgent, SiteUrl, LabelId or PolicyDetails column (checked with getschema on the
//      validation workspace, Oct 2026): it holds label events (Operation, LabelName, SensitivityLabelId, ObjectId, UserId, Workload). File access
//      is in OfficeActivity (Operation, OfficeObjectId, Site_Url, UserAgent).
//      Limits: 413 of the 421 label events on the validation tenant have an empty LabelName (the label id is in
//      SensitivityLabelId), so the name filter rarely matches: put the ids of your sensitive labels in
//      HighlyConfidentialLabelIds. Agent traffic is guessed from UserAgent and label events record changes, not the
//      current label (see P01-Q4). It returned no rows on the validation tenant.
// -----------------------------------------------------------------------------
let HighlyConfidentialLabelIds = dynamic([]);   // add the GUIDs of your sensitive labels
OfficeActivity
| where TimeGenerated > ago(1d)
| where RecordType == "SharePointFileOperation"
    and Operation in ("FileAccessed", "FileDownloaded")
| join kind=inner (
    MicrosoftPurviewInformationProtection
    | where TimeGenerated > ago(90d)
    | where Operation in ("FileSensitivityLabelApplied", "SensitivityLabelApplied")
    | where LabelName has_any ("Highly Confidential", "Restricted", "Secret") or SensitivityLabelId in (HighlyConfidentialLabelIds)
    | summarize arg_max(TimeGenerated, LabelName, SensitivityLabelId) by ObjectId
) on $left.OfficeObjectId == $right.ObjectId
| extend HourOfDay = datetime_part("Hour", TimeGenerated)
| extend IsOffHours = HourOfDay < 7 or HourOfDay > 20
| extend IsWeekend = dayofweek(TimeGenerated) in (0d, 6d)
| extend IsAgentAccess = UserAgent has_any ("agent", "copilot", "assistant", "bot", "power-automate")
| where (IsOffHours or IsWeekend) and IsAgentAccess
| project
    TimeGenerated,
    UserId,
    OfficeObjectId,
    LabelName,
    Operation,
    HourOfDay,
    IsWeekend,
    Site_Url,
    RiskNote = "Sensitive document accessed by agent outside business hours"
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// Q4: Structural False Negative Detection — Controls That Detect But Don't Block
// Use: Audit your own detection coverage — identify rules firing without enforcement
//      If an alert fires repeatedly for the same entity with no remediation, it's a false negative pattern
// Validated live (Oct 2026, Sentinel workspace): the earlier version failed (it read IncidentProviderName, but the
//      column is ProviderName, and tested "has" on a dynamic array) and, once fixed, would have counted table rows:
//      SecurityIncident writes a row per change to an incident (839 rows for 105 incidents in 30 days on the
//      validation workspace), so "IncidentCount > 3" held for any incident edited a few times. It now keeps the
//      latest row per IncidentNumber first. No incident title matched agent, copilot or AI interaction in 30 days
//      there, so it returned nothing; with the title filter dropped it groups 37 titles (5 repeated, 34 never closed).
// -----------------------------------------------------------------------------
SecurityIncident
| where TimeGenerated > ago(30d)
| summarize arg_max(TimeGenerated, *) by IncidentNumber
| where Title has_any ("agent", "copilot", "AI interaction")
| summarize
    IncidentCount = count(),
    FirstIncident = min(CreatedTime),
    LastIncident = max(CreatedTime),
    ClosedCount = countif(Status == "Closed"),
    StatusHistory = make_set(Status)
    by Title, ProviderName
| extend NeverClosed = ClosedCount == 0
| extend RepeatAlerts = IncidentCount > 3
| where NeverClosed or RepeatAlerts
| project
    Title,
    ProviderName,
    IncidentCount,
    FirstIncident,
    LastIncident,
    StatusHistory,
    RiskNote = case(
        NeverClosed and RepeatAlerts, "Recurring alert never closed — likely no enforcement action",
        NeverClosed, "Alert never closed — verify enforcement is in place",
        "High repeat rate — review if enforcement is effective"
    )
| sort by IncidentCount desc


// -----------------------------------------------------------------------------
// Q5: Agent Token Revocation Audit — Verify Enforcement Actions Completed
// Use: Confirm that playbook enforcement actions (token revocation) actually executed
//      If jailbreak alert fired but no revocation appears, enforcement failed
// Validated live (Oct 2026, Sentinel workspace): "Revoke refresh tokens for user" is not an AuditLogs operation, so
//      that branch never matched. Revoking a user's sessions is logged as "Update user" with the property
//      StsRefreshTokensValidFrom (4 such events in 90 days on the validation workspace, all manual). The query
//      now reads that, and also "Hard delete service principal" (5 in 90 days). "Update service principal" counts any
//      update (95 in 90 days), not only a disable: narrow it before using the automation rate as proof of enforcement.
// -----------------------------------------------------------------------------
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName in (
    "Update user",
    "Delete service principal",
    "Hard delete service principal",
    "Update service principal",
    "Remove member from role"
)
| extend IsSessionRevocation = OperationName == "Update user" and tostring(TargetResources) has "StsRefreshTokensValidFrom"
| where OperationName != "Update user" or IsSessionRevocation
| extend Action = iff(IsSessionRevocation, "Revoke sessions (Update user: StsRefreshTokensValidFrom)", OperationName)
| extend RevokedEntity = tostring(TargetResources[0].displayName)
| extend RevokedBy = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedByApp = tostring(InitiatedBy.app.displayName)
| extend IsAutomated = isnotempty(InitiatedByApp) and isempty(RevokedBy)
| summarize
    RevocationCount = count(),
    LastRevocation = max(TimeGenerated),
    AutomatedCount = countif(IsAutomated == true),
    ManualCount = countif(IsAutomated == false)
    by Action
| extend AutomationRate = round(100.0 * AutomatedCount / RevocationCount, 1)
| project Action, RevocationCount, AutomatedCount, ManualCount, AutomationRate, LastRevocation
| sort by RevocationCount desc


// -----------------------------------------------------------------------------
// Q6: Goal Hijacking — Sustained Objective Drift Across Session Steps
// Use: Detect agents executing high-privilege or destructive actions deep into
//      a session, after an innocuous initial interaction — pattern consistent
//      with goal hijacking via adversarial instructions surviving multi-step reasoning
// Reference: Microsoft AIRT Taxonomy v2.0 §4.4 | OWASP ASI01
// Recommended: Analytics Rule | Frequency: 30m | Lookback: 2h | Severity: High
// NOTE: The session-start ActionType was "AgentInteraction", which is not a documented value;
//       it is now "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       SessionId and StepIndex are not documented RawEventData keys (documented: ConversationId,
//       SessionIdentity), and it is not verified that the high-privilege events on the other
//       side of the join carry the agent's session key, so the join may never match. Not run
//       against live events (it runs without errors in Advanced Hunting, Oct 2026, and returns nothing).
// -----------------------------------------------------------------------------
let HighPrivilegeActions = dynamic([
    "FilePermanentlyDeleted", "FileDeleted", "MessageSent",
    "InviteExternalUser", "AdminUpdated", "RoleAssigned",
    "BulkFileDownload", "SiteCollectionAdminAdded"
]);
let SessionFirstAction = CloudAppEvents
    | where TimeGenerated > ago(2h)
    | where ActionType == "InvokeAgent"
    | extend SessionId = tostring(RawEventData["SessionId"])
    | extend AgentId = tostring(RawEventData["AgentId"])
    | summarize SessionStart = min(TimeGenerated) by SessionId, AgentId, AccountDisplayName;
CloudAppEvents
| where TimeGenerated > ago(2h)
| where ActionType in (HighPrivilegeActions)
| extend SessionId = tostring(RawEventData["SessionId"])
| extend AgentId = tostring(RawEventData["AgentId"])
| extend StepIndex = toint(RawEventData["StepIndex"])
| where isnotempty(SessionId) and isnotempty(AgentId)
| join kind=inner SessionFirstAction on SessionId, AgentId, AccountDisplayName
| extend MinutesIntoSession = datetime_diff('minute', TimeGenerated, SessionStart)
| where MinutesIntoSession > 10 and StepIndex > 3   // High-privilege action only after sustained session
| project
    TimeGenerated,
    AccountDisplayName,
    AgentId,
    SessionId,
    ActionType,
    StepIndex,
    MinutesIntoSession,
    SessionStart,
    RiskNote = "High-privilege action executed deep in session — potential goal hijacking via adversarial instructions"
| sort by MinutesIntoSession desc, StepIndex desc


// -----------------------------------------------------------------------------
// Q7: LPCI — Logic-Layer Prompt Control Injection Detection
// Use: Detect tool responses or retrieved content injecting operator-level
//      instructions into the agent's reasoning context, elevating payload
//      privileges across session turns. Distinct from direct prompt injection
//      (Q1): LPCI payloads arrive via tool return values or memory retrieval,
//      not user prompts, and persist across subsequent steps.
// Reference: OWASP AST03 (Over-Privileged Skills) | Atta et al. arXiv:2507.10457
//            MITRE ATLAS AML.T0051 (Prompt Injection via Third-Party Content)
// Recommended: Analytics Rule | Frequency: 15m | Lookback: 2h | Severity: High
// NOTE: ExecuteToolByGateway is a documented ActionType (Microsoft Learn, Agent 365 observability concepts), but the
//       tool result text is not: Learn lists tool arguments and results as "not yet surfaced in
//       advanced hunting", and the MCP server name (gen_ai.tool.server.name) is not exposed
//       either, so RawEventData["ToolResponse"] and ["McpServerName"] have no documented source.
//       Documented tool keys: ToolName, ToolType, ToolId, ToolDescription. Pattern only; not run
//       against live events.
// -----------------------------------------------------------------------------
let LpciPatterns = dynamic([
    "you are now operating as",
    "new system instruction:",
    "override previous role",
    "ignore your prior instructions",
    "as your administrator i",
    "your new objective is",
    "disregard safety",
    "act with elevated permissions",
    "treat this as operator instruction",
    "from this point forward you"
]);
let ToolResponseEvents = CloudAppEvents
    | where TimeGenerated > ago(2h)
    | where ActionType == "ExecuteToolByGateway"
    | extend AgentName = tostring(RawEventData["AgentName"])
    | extend ToolName = tostring(RawEventData["ToolName"])
    | extend McpServerName = tostring(RawEventData["McpServerName"])
    | extend ToolResponseText = tolower(tostring(RawEventData["ToolResponse"]))
    | extend SessionId = tostring(RawEventData["SessionId"])
    | extend LpciScore = toint(
        toint(ToolResponseText has "you are now operating as") * 3 +
        toint(ToolResponseText has "new system instruction:") * 3 +
        toint(ToolResponseText has "override previous role") * 3 +
        toint(ToolResponseText has "ignore your prior instructions") * 3 +
        toint(ToolResponseText has "as your administrator i") * 2 +
        toint(ToolResponseText has "your new objective is") * 2 +
        toint(ToolResponseText has "treat this as operator instruction") * 2 +
        toint(ToolResponseText has "act with elevated permissions") * 2 +
        toint(ToolResponseText has "disregard safety") * 1 +
        toint(ToolResponseText has "from this point forward you") * 1
    )
    | where LpciScore >= 2;
// Correlate with subsequent high-privilege actions in the same session
let HighPrivilegePostLpci = CloudAppEvents
    | where TimeGenerated > ago(2h)
    | where ActionType in (
        "FilePermanentlyDeleted", "FileDeleted", "MessageSent",
        "InviteExternalUser", "AdminUpdated", "RoleAssigned",
        "BulkFileDownload", "SiteCollectionAdminAdded"
    )
    | extend SessionId = tostring(RawEventData["SessionId"])
    | where isnotempty(SessionId);
ToolResponseEvents
| join kind=leftouter (
    HighPrivilegePostLpci
    | project SessionId, PostLpciAction = ActionType, PostLpciTime = TimeGenerated
) on SessionId
| extend EscalationConfirmed = isnotempty(PostLpciAction)
| project
    TimeGenerated,
    AgentName,
    McpServerName,
    ToolName,
    SessionId,
    LpciScore,
    EscalationConfirmed,
    PostLpciAction = iff(EscalationConfirmed, PostLpciAction, "none"),
    ResponsePreview = substring(tostring(RawEventData["ToolResponse"]), 0, 300),
    RiskNote = iff(
        EscalationConfirmed,
        "CONFIRMED: LPCI in tool response followed by high-privilege action in same session",
        "SUSPECTED: LPCI pattern in tool response — monitor for subsequent escalation"
    )
| sort by LpciScore desc, EscalationConfirmed desc, TimeGenerated desc


// -----------------------------------------------------------------------------
// Q8: Agentic Ransomware Chain Detection — JadePuffer Pattern
// Use: Detect autonomous multi-stage attack chain executed by a single agent
//      identity within a compressed time window: environment discovery →
//      credential access → lateral movement → bulk file operations.
//      Distinguishes AI-operated ransomware (adaptive, continuous, no human pause)
//      from human-operated ransomware (intermittent, variable command patterns).
// Reference: OWASP AST03 | JadePuffer (Sysdig, 2026) | MITRE ATLAS AML.T0051
// Recommended: Analytics Rule | Frequency: 15m | Lookback: 60m | Severity: Critical
// NOTE: "AgentInteraction" in DiscoveryActions was not a documented ActionType; it is now
//       "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       Not run against live events (0 agent ActionTypes in the validation tenant, Oct 2026). It now runs without
//       errors in Advanced Hunting: the stage count added booleans directly, which is invalid KQL ("Non-boolean
//       context is not expected"); each stage is now toint(...), and the left-joined counts are coalesced.
// -----------------------------------------------------------------------------
let WindowMinutes = 60;
let DiscoveryActions = dynamic([
    "InvokeAgent", "FileAccessed", "SearchQueryPerformed",
    "DirectoryQueried", "ServiceEnumerated"
]);
let CredentialActions = dynamic([
    "CredentialAccessed", "SecretRead", "KeyVaultSecretAccessed",
    "TokenRequested", "ApiKeyAccessed", "EnvironmentVariableRead"
]);
let LateralActions = dynamic([
    "InviteExternalUser", "GroupMemberAdded", "RoleAssigned",
    "ServicePrincipalAdded", "ApplicationImpersonation"
]);
let EncryptionSignals = dynamic([
    "BulkFileDownload", "FilePermanentlyDeleted", "FileDeleted",
    "BulkFileCopy", "SiteCollectionAdminAdded", "FileRenamed"
]);
// Stage 1: identify agent identities with discovery activity
let AgentsWithDiscovery = CloudAppEvents
    | where TimeGenerated > ago(WindowMinutes * 1m)
    | extend AgentId = tostring(RawEventData["AgentId"])
    | where isnotempty(AgentId)
    | where ActionType in (DiscoveryActions)
    | summarize DiscoveryCount = count(), DiscoveryStart = min(TimeGenerated) by AgentId, AccountDisplayName;
// Stage 2: same agent identity with credential access
let AgentsWithCredAccess = CloudAppEvents
    | where TimeGenerated > ago(WindowMinutes * 1m)
    | extend AgentId = tostring(RawEventData["AgentId"])
    | where isnotempty(AgentId)
    | where ActionType in (CredentialActions)
    | summarize CredAccessCount = count(), CredAccessTime = min(TimeGenerated) by AgentId;
// Stage 3: lateral movement
let AgentsWithLateral = CloudAppEvents
    | where TimeGenerated > ago(WindowMinutes * 1m)
    | extend AgentId = tostring(RawEventData["AgentId"])
    | where isnotempty(AgentId)
    | where ActionType in (LateralActions)
    | summarize LateralCount = count(), LateralTime = min(TimeGenerated) by AgentId;
// Stage 4: encryption/destruction signals
let AgentsWithEncryption = CloudAppEvents
    | where TimeGenerated > ago(WindowMinutes * 1m)
    | extend AgentId = tostring(RawEventData["AgentId"])
    | where isnotempty(AgentId)
    | where ActionType in (EncryptionSignals)
    | summarize EncryptionCount = count(), EncryptionTime = min(TimeGenerated) by AgentId;
// Correlate all 4 stages — agent must appear in at least 3 for alert
AgentsWithDiscovery
| join kind=leftouter AgentsWithCredAccess on AgentId
| join kind=leftouter AgentsWithLateral on AgentId
| join kind=leftouter AgentsWithEncryption on AgentId
| extend StagesPresent = toint(DiscoveryCount > 0) + toint(coalesce(CredAccessCount, 0) > 0)
    + toint(coalesce(LateralCount, 0) > 0) + toint(coalesce(EncryptionCount, 0) > 0)
| where StagesPresent >= 3
| extend ChainDurationMinutes = iff(
    isnotempty(EncryptionTime),
    datetime_diff('minute', EncryptionTime, DiscoveryStart),
    datetime_diff('minute', now(), DiscoveryStart)
)
| project
    DiscoveryStart,
    AccountDisplayName,
    AgentId,
    StagesPresent,
    DiscoveryCount,
    CredAccessCount = coalesce(CredAccessCount, 0),
    LateralCount = coalesce(LateralCount, 0),
    EncryptionCount = coalesce(EncryptionCount, 0),
    ChainDurationMinutes,
    RiskNote = case(
        StagesPresent == 4, "CRITICAL: All 4 ransomware chain stages detected from single agent identity — agentic ransomware pattern confirmed",
        StagesPresent == 3, "HIGH: 3 of 4 ransomware chain stages detected — potential agentic ransomware in progress",
        "MEDIUM: Partial chain detected — monitor for stage completion"
    )
| sort by StagesPresent desc, ChainDurationMinutes asc


// -----------------------------------------------------------------------------
// Q9: Algorithmic Payload Decomposition — Multi-Turn Fragment Correlation (PT0200)
// Use: Detect injection payloads fragmented across multiple prompts within a
//      session. Individual fragments score below Q1 thresholds and evade
//      single-turn scanners; only when correlated across turns does the full
//      malicious instruction appear. Detection strategy: score each prompt in
//      a session, then sum session-level scores across a short window.
// Reference: CrowdStrike PT0200 (Algorithmic Payload Decomposition, 2025)
//            MITRE ATLAS AML.T0051 | OWASP ASI01 (Agent Goal Hijack, 2026)
// Recommended: Analytics Rule | Frequency: 15m | Lookback: 2h | Severity: High
// NOTE: The ActionType was "AgentInteraction", which is not a documented value; it is now
//       "InvokeAgent" (Microsoft Learn, Agent 365 observability concepts).
//       Prompt text is "not yet surfaced in advanced hunting" per Learn, so
//       RawEventData["UserPrompt"] has no documented source: pattern only. Not run against
//       live events (0 agent ActionTypes in the validation tenant, Oct 2026).
// -----------------------------------------------------------------------------
let SessionWindow = 2h;
let FragmentPatterns = dynamic([
    "ignore", "disregard", "override", "forget", "bypass",
    "new instructions", "previous rules", "system prompt",
    "act as", "you are now", "your role is", "pretend you",
    "from now on", "starting now", "going forward"
]);
let PromptScores = CloudAppEvents
    | where TimeGenerated > ago(SessionWindow)
    | where Application in ("Microsoft Copilot", "Copilot Studio", "Azure AI Foundry")
        and ActionType == "InvokeAgent"
    | extend PromptText = tolower(tostring(RawEventData["UserPrompt"]))
    | extend AgentId = tostring(RawEventData["AgentId"])
    | extend SessionId = tostring(RawEventData["SessionId"])
    | extend TurnIndex = toint(RawEventData["StepIndex"])
    | extend FragmentScore = toint(
        toint(PromptText has "ignore") * 1 +
        toint(PromptText has "disregard") * 1 +
        toint(PromptText has "override") * 1 +
        toint(PromptText has "forget") * 1 +
        toint(PromptText has "bypass") * 1 +
        toint(PromptText has "new instructions") * 2 +
        toint(PromptText has "previous rules") * 2 +
        toint(PromptText has "system prompt") * 2 +
        toint(PromptText has "act as") * 1 +
        toint(PromptText has "you are now") * 2 +
        toint(PromptText has "your role is") * 2 +
        toint(PromptText has "pretend you") * 1 +
        toint(PromptText has "from now on") * 1 +
        toint(PromptText has "starting now") * 1 +
        toint(PromptText has "going forward") * 1
    )
    | where FragmentScore >= 1  // Include low-score individual turns
    | project TimeGenerated, AccountDisplayName, AgentId, SessionId, TurnIndex, FragmentScore,
        PromptPreview = substring(tostring(RawEventData["UserPrompt"]), 0, 200);
// Aggregate per session: individual turns are below Q1 threshold (< 2),
// but cumulative session score reveals decomposed payload
PromptScores
| summarize
    SessionFragmentScore = sum(FragmentScore),
    TurnsWithFragments = count(),
    FirstFragment = min(TimeGenerated),
    LastFragment = max(TimeGenerated),
    FragmentPreviews = make_list(PromptPreview, 5)
    by AccountDisplayName, AgentId, SessionId
| where SessionFragmentScore >= 4 and TurnsWithFragments >= 2
| extend SessionDurationMinutes = datetime_diff('minute', LastFragment, FirstFragment)
| extend RiskNote = case(
    SessionFragmentScore >= 8 and TurnsWithFragments >= 3,
        "HIGH: Multi-turn decomposed injection payload — fragments distributed across 3+ prompts (PT0200)",
    TurnsWithFragments >= 2,
        "MEDIUM: Two-turn injection fragments — may be algorithmic payload decomposition attempt (PT0200)",
    "LOW: Borderline session fragment score — monitor for continuation"
)
| project
    FirstFragment,
    AccountDisplayName,
    AgentId,
    SessionId,
    SessionFragmentScore,
    TurnsWithFragments,
    SessionDurationMinutes,
    FragmentPreviews,
    RiskNote
| sort by SessionFragmentScore desc, TurnsWithFragments desc


// -----------------------------------------------------------------------------
// Q10: Cross-Prompt Injection (XPIA) Flagged by the Platform — Which Resource Carried It
// Use: Surface Copilot interactions in which the platform flagged a resource that Copilot read as a cross-prompt
//      injection attack (XPIA, indirect prompt injection), and show that resource: the document, page or message
//      to clean up or block. Complements Q1 (a jailbreak in the user's own message): an XPIA arrives in content
//      the user never typed, so the flag is on the resource, not on the message. It also replaces the phrase
//      patterns of P04-Q5 and Q5a, which have no prompt text to read.
// Reference: Microsoft Learn, "Audit logs for Copilot and AI applications" (AccessedResources[].XPIADetected) |
//            MITRE ATLAS AML.T0051 | OWASP ASI01
// Recommended: Analytics Rule | Frequency: 5m | Lookback: 1h | Severity: High
// Validated live (Oct 2026, Sentinel workspace): runs without errors and returned no rows. The XPIADetected key is
//      present on the 2 resources that Copilot interactions listed in 90 days (3 records), both false: checked with
//      == false, which returns them with actor, app, IP, URL and type. A resource flagged true has not been seen.
//      Those 2 resources are web citations without Name, Status or SensitivityLabelId, so the query reads those with
//      tostring and they come back empty when the record omits them.
// -----------------------------------------------------------------------------
CopilotActivity
| where TimeGenerated > ago(1h)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| where tobool(Resource.XPIADetected) == true
| project
    TimeGenerated,
    ActorName,
    ActorUserId,
    AgentName,
    AgentId,
    AppIdentity,
    AppHost,
    SrcIpAddr,
    ResourceUrl = tostring(Resource.SiteUrl),
    ResourceName = tostring(Resource.Name),
    ResourceType = tostring(Resource.Type),
    Action = tostring(Resource.Action),
    LabelId = tostring(Resource.SensitivityLabelId),
    PolicyDetails = tostring(Resource.PolicyDetails),
    RecordId,
    RiskNote = "Resource flagged as a cross-prompt injection source: review and clean up the content"
| sort by TimeGenerated desc
