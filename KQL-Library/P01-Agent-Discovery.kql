// =============================================================================
// P01 — DISCOVER & PRIORITIZE
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: AgentsInfo, CloudAppEvents, OfficeActivity, MicrosoftPurviewInformationProtection
// SCHEMA NOTES (verified live against tenant AgentsInfo via pack_all(), Sep 2026):
//   AgentsInfo.Name | Owners: dynamic, can be null
//   EntraAgentID (capital D at the end) | LifecycleStatus: Active/Blocked/Uninstalled/Deleted
//   Both Timestamp and TimeGenerated exist in AgentsInfo
//   AgentsInfo has 39 columns on a live tenant (Oct 2026). Populated there: ObservabilityID, Instructions, Model,
//   DeclaredTools (platform "Other"), McpServers (local agents), ConnectedAgents (1 agent). Present but empty for
//   every agent: Guardrails, Memory, Triggers, Skills, Endpoints, Permissions, ToolsAuthenticationType.
//   A query on an empty column returns nothing, so none is built on them yet.
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Full Agent Inventory by Platform and Lifecycle Status
// Use: Baseline visibility — what agents exist, which lack owner or Entra identity
// Note: LifecycleStatus valid values: Active, Blocked, Uninstalled, Deleted
//       Identity has three states, from EntraAgentID and EntraBlueprintID (capital D, not Id):
//         NoEntraIdentity  both empty              -> no Entra identity at all
//         BlueprintOnly    only EntraBlueprintID   -> a blueprint exists, no agent identity in this tenant
//         AgentIdentity    EntraAgentID present    -> dedicated identity (blueprint may or may not exist)
//       Validated on a live tenant (Oct 2026): third-party agents (platform "Other") appeared with a
//       blueprint and no agent identity, so "no EntraAgentID" alone overstated the identity risk.
//       High = no owner AND no Entra identity at all. A blueprint-only agent never reaches High on its own.
//       Counts are DISTINCT agents (dcountif on AgentId), not snapshot rows: AgentsInfo stores a snapshot
//       per agent per day, and countif reported 9195 "no identity" rows for 336 agents on a validated tenant.
//       RiskRank orders High, Medium, Low (a plain string sort gives High, Low, Medium).
//       RiskLevel here is a triage heuristic from ownership and identity. It is not the AI agent posture risk
//       that Microsoft Defender calculates (Preview, July 2026), which is reviewed in Assets > AI agents.
//       NoEntraIdentity means AgentsInfo records neither an agent identity nor a blueprint. It does not always mean
//       "no identity in Entra": Copilot Studio agents created before May 2026 use an app registration, every new
//       Copilot Studio agent now gets an Entra Agent ID, and Agent Builder agents have no identity properties
//       (Microsoft Learn, 2026). On the validated tenant, 1 of 3 Copilot Studio agents had an EntraAgentID.
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| summarize
    LastSeen = max(Timestamp),
    AgentCount = dcount(AgentId),
    WithoutOwner = dcountif(AgentId, isnull(Owners) or array_length(Owners) == 0),
    NoEntraIdentity = dcountif(AgentId, isempty(EntraAgentID) and isempty(EntraBlueprintID)),
    BlueprintOnly = dcountif(AgentId, isempty(EntraAgentID) and isnotempty(EntraBlueprintID))
    by Platform, LifecycleStatus, PublishedStatus, Name
| extend RiskLevel = case(
    WithoutOwner > 0 and NoEntraIdentity > 0, "High",
    WithoutOwner > 0 or NoEntraIdentity > 0 or BlueprintOnly > 0, "Medium",
    LifecycleStatus in ("Blocked", "Deleted"), "Medium",
    "Low"
)
| extend RiskRank = case(RiskLevel == "High", 0, RiskLevel == "Medium", 1, 2)
| sort by RiskRank asc, LastSeen desc
| project Name, Platform, LifecycleStatus, PublishedStatus, RiskLevel,
          WithoutOwner, NoEntraIdentity, BlueprintOnly, AgentCount, LastSeen


// -----------------------------------------------------------------------------
// Q2: Shadow AI — Agents Without Owner or Entra Identity
// Use: Identify agents operating without formal registration or assigned ownership
// Note: Owners can be null (third-party/external agents) or empty array
//       IdentityState uses the same three states as Q1. Blueprint-only agents are listed on
//       purpose (they still have no agent identity here) but are not called "identity laundering".
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| where isnull(Owners) or array_length(Owners) == 0
    or isempty(EntraAgentID)
| extend OwnersStr = tostring(Owners)
| distinct AgentId, Name, Platform, CreatedDateTime, OwnersStr, EntraAgentID, EntraBlueprintID
| extend OwnerDisplay = iff(OwnersStr == '' or OwnersStr == '[]', 'UNASSIGNED', OwnersStr)
| extend NoOwner = (OwnersStr == "" or OwnersStr == "[]")
| extend IdentityState = case(
    isnotempty(EntraAgentID), "AgentIdentity",
    isnotempty(EntraBlueprintID), "BlueprintOnly",
    "NoEntraIdentity"
)
| extend RiskSignal = case(
    IdentityState == "NoEntraIdentity" and NoOwner,
        "No owner + no Entra identity — shadow AI",
    IdentityState == "NoEntraIdentity",
        "No Entra identity (no agent identity, no blueprint) — identity laundering risk",
    IdentityState == "BlueprintOnly" and NoOwner,
        "No owner; blueprint only, no agent identity in this tenant — confirm how it authenticates",
    IdentityState == "BlueprintOnly",
        "Blueprint only, no agent identity in this tenant — confirm how it authenticates",
    "No owner assigned"
)
| extend DaysSinceCreation = datetime_diff('day', now(), CreatedDateTime)
| sort by DaysSinceCreation desc
| project AgentId, Name, Platform, OwnerDisplay, IdentityState, RiskSignal, DaysSinceCreation


// -----------------------------------------------------------------------------
// Q3: Local AI Agents on Endpoints
// Use: Detect local AI agents (coding agents, desktop assistants, IDE extensions, local MCP clients) that cloud inventory does not see
// Source: AgentsInfo with Platform == "LocalAgents". Microsoft Defender discovers supported local agents on
//      Windows endpoints and lists them in the AI agent inventory and in advanced hunting (Microsoft Learn,
//      June 2026). Validated live (Oct 2026): 9 local agents in 7 days (Claude Code, Claude Desktop, Codex CLI,
//      GitHub Copilot CLI, IDE extensions), one of them with 14 MCP servers declared.
// Prerequisites: Defender for Endpoint in active mode, and local agents onboarded separately from cloud agents
//      through AI agent runtime protection in Defender for Endpoint.
// Replaces an earlier CloudAppEvents query (ActionType "AgentProcessDetected") that was never confirmed on a live tenant.
// Note: the same product can appear more than once (one AgentId per installation or profile). McpServers holds
//      one JSON string per server (name, type, endpoint): review the endpoints, they are third-party services.
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(7d)
| where Platform == "LocalAgents"
| summarize arg_max(Timestamp, *) by AgentId
| extend McpServerCount = iff(isnull(McpServers), 0, array_length(McpServers))
| project Name, LifecycleStatus, PublishedStatus, McpServerCount, McpServers, CreatedDateTime, LastSeen = Timestamp
| sort by McpServerCount desc, Name asc


// -----------------------------------------------------------------------------
// Q4: SharePoint Sites Accessed by Agents Without Sensitivity Labels
// Use: Identify knowledge sources with data exposure risk before retrieval activation
// Validated live (Oct 2026, Sentinel workspace): runs without errors. The earlier version failed because
//      MicrosoftPurviewInformationProtection has no Activity column (label events are in Operation; values seen:
//      FileSensitivityLabelApplied, SensitivityLabelApplied, AutoSensitivityLabelRuleMatch,
//      SensitivityLabelPolicyMatched) and OfficeActivity has OfficeObjectId and Site_Url, not ObjectId and SiteUrl.
//      The join key works: 972 of 22,418 SharePointFileOperation events (30 days) matched a label event.
// Limits: OfficeActivity has no application or agent identity column, so agent traffic is guessed from UserAgent.
//      On the validation tenant no user agent contained any of the terms below, so the query returns no rows:
//      replace AgentUserAgents with the user agents your agent runtimes send. Label events record changes, not the
//      current label, so a file labeled before LabelLookback appears as unlabeled; workspace retention caps LabelLookback.
// -----------------------------------------------------------------------------
let AgentUserAgents = dynamic(["agent", "copilot", "power-automate", "bot"]);
let LabelLookback = 90d;
let LabeledObjects = MicrosoftPurviewInformationProtection
    | where TimeGenerated > ago(LabelLookback)
    | where Operation in ("FileSensitivityLabelApplied", "SensitivityLabelApplied")
    | distinct ObjectId;
OfficeActivity
| where TimeGenerated > ago(7d)
| where RecordType == "SharePointFileOperation"
    and UserAgent has_any (AgentUserAgents)
| join kind=leftouter LabeledObjects on $left.OfficeObjectId == $right.ObjectId
| where isempty(ObjectId)
| summarize
    AgentAccesses = count(),
    LastAccess = max(TimeGenerated)
    by Site_Url, OfficeObjectId, UserId
| sort by AgentAccesses desc
| project Site_Url, OfficeObjectId, AgentAccesses, LastAccess, UserId


// -----------------------------------------------------------------------------
// Q5: New Agents Deployed in Last 24 Hours — Alert Candidate
// Use: Near-real-time detection of new agent registrations
// Recommended: Schedule as Analytics Rule, frequency 1h, lookback 1d
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(1d)
| where CreatedDateTime > ago(1d)
| extend OwnerDisplay = iff(isnull(Owners) or array_length(Owners) == 0, "UNASSIGNED", tostring(Owners))
| project
    AgentId,
    Name,
    Platform,
    OwnerDisplay,
    LifecycleStatus,
    PublishedStatus,
    CreatedDateTime,
    DeclaredTools,
    McpServers
| extend AlertDetail = strcat(
    "New agent registered: ", Name,
    " | Platform: ", Platform,
    " | Owner: ", OwnerDisplay,
    " | MCP servers: ", tostring(array_length(McpServers))
)
| sort by CreatedDateTime desc


// -----------------------------------------------------------------------------
// Q6: Agents With External MCP Servers or High Tool Count — Supply Chain Risk
// Use: Surface agents whose declared toolset includes external MCP endpoints
//      or anomalously large tool counts (potential permission sprawl)
// New AgentsInfo columns: McpServers (dynamic), DeclaredTools (dynamic), InstanceCount
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| extend McpServerCount = iff(isnull(McpServers), 0, array_length(McpServers))
| extend DeclaredToolCount = iff(isnull(DeclaredTools), 0, array_length(DeclaredTools))
| where McpServerCount > 0 or DeclaredToolCount > 10
| extend OwnerDisplay = iff(isnull(Owners) or array_length(Owners) == 0, "UNASSIGNED", tostring(Owners))
| extend RiskSignal = case(
    McpServerCount > 0 and DeclaredToolCount > 10, "High — external MCP + large toolset",
    McpServerCount > 0, "Medium — external MCP server(s) declared",
    "Medium — large declared tool count"
)
| project
    Name, Platform,
    OwnerDisplay, LifecycleStatus, PublishedStatus,
    McpServerCount, McpServers,
    DeclaredToolCount, DeclaredTools,
    InstanceCount, RiskSignal,
    LastSeen = Timestamp
| sort by McpServerCount desc, DeclaredToolCount desc
