// =============================================================================
// P01 — DISCOVER & PRIORITIZE
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: AgentsInfo, CloudAppEvents, OfficeActivity
// SCHEMA NOTES (verified live against tenant AgentsInfo via pack_all(), Sep 2026):
//   AgentsInfo.Name | Owners: dynamic, can be null
//   EntraAgentID (capital D at the end) | LifecycleStatus: Active/Blocked/Uninstalled/Deleted
//   Both Timestamp and TimeGenerated exist in AgentsInfo
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Full Agent Inventory by Platform and Lifecycle Status
// Use: Baseline visibility — what agents exist, which lack owner or Entra identity
// Note: LifecycleStatus valid values: Active, Blocked, Uninstalled, Deleted
//       Identity has three states, from EntraAgentID and EntraBlueprintID (capital D, not Id):
//         NoEntraIdentity  both empty              -> no Entra identity at all
//         BlueprintOnly    only EntraBlueprintID   -> a blueprint exists, no agent identity in this tenant
//         AgentIdentity    EntraAgentID present    -> dedicated identity (blueprint may or may not exist)
//       Validated on a live tenant (Oct 2026): third-party agents (platform "Other") appeared with a
//       blueprint and no agent identity, so "no EntraAgentID" alone overstated the identity risk.
//       High = no owner AND no Entra identity at all. A blueprint-only agent never reaches High on its own.
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| summarize
    LastSeen = max(Timestamp),
    AgentCount = dcount(AgentId),
    WithoutOwner = countif(isnull(Owners) or array_length(Owners) == 0),
    NoEntraIdentity = countif(isempty(EntraAgentID) and isempty(EntraBlueprintID)),
    BlueprintOnly = countif(isempty(EntraAgentID) and isnotempty(EntraBlueprintID))
    by Platform, LifecycleStatus, PublishedStatus, Name
| extend RiskLevel = case(
    WithoutOwner > 0 and NoEntraIdentity > 0, "High",
    WithoutOwner > 0 or NoEntraIdentity > 0 or BlueprintOnly > 0, "Medium",
    LifecycleStatus in ("Blocked", "Deleted"), "Medium",
    "Low"
)
| sort by RiskLevel asc, LastSeen desc
| project Name, Platform, LifecycleStatus, PublishedStatus, RiskLevel,
          WithoutOwner, NoEntraIdentity, BlueprintOnly, AgentCount, LastSeen


// -----------------------------------------------------------------------------
// Q2: Shadow AI — Agents Without Owner or Entra Identity
// Use: Identify agents operating without formal registration or assigned ownership
// Note: Owners can be null (third-party/external agents) or empty array
//       IdentityState uses the same three states as Q1. Blueprint-only agents are listed on
//       purpose (they still have no agent identity here) but are not called "identity laundering".
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| where isnull(Owners) or array_length(Owners) == 0
    or isempty(EntraAgentID)
| extend OwnersStr = tostring(Owners)
| distinct AgentId, Name, Platform, CreatedDateTime, OwnersStr, EntraAgentID, EntraBlueprintID
| extend OwnerDisplay = iff(OwnersStr == '' or OwnersStr == '[]', 'UNASSIGNED', OwnersStr)
| extend NoOwner = (OwnersStr == "" or OwnersStr == "[]")
| extend IdentityState = case(
    isnotempty(EntraAgentID), "AgentIdentity",
    isnotempty(EntraBlueprintID), "BlueprintOnly",
    "NoEntraIdentity"
)
| extend RiskSignal = case(
    IdentityState == "NoEntraIdentity" and NoOwner,
        "No owner + no Entra identity — shadow AI",
    IdentityState == "NoEntraIdentity",
        "No Entra identity (no agent identity, no blueprint) — identity laundering risk",
    IdentityState == "BlueprintOnly" and NoOwner,
        "No owner; blueprint only, no agent identity in this tenant — confirm how it authenticates",
    IdentityState == "BlueprintOnly",
        "Blueprint only, no agent identity in this tenant — confirm how it authenticates",
    "No owner assigned"
)
| extend DaysSinceCreation = datetime_diff('day', now(), CreatedDateTime)
| sort by DaysSinceCreation desc
| project AgentId, Name, Platform, OwnerDisplay, IdentityState, RiskSignal, DaysSinceCreation


// -----------------------------------------------------------------------------
// Q3: Local AI Agents on Endpoints
// Use: Detect agents invisible to cloud inventory (Claude Code, MCP servers, etc.)
// Note: Requires MDE endpoint connector active
// -----------------------------------------------------------------------------
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType == "AgentProcessDetected"
    or ApplicationId has_any ("mcp-server", "claude-code", "openai-api-local")
| summarize
    LastActivity = max(Timestamp),
    ActivityCount = count()
    by DeviceName, AccountDisplayName, ApplicationId, IPAddress
| sort by ActivityCount desc
| project DeviceName, AccountDisplayName, ApplicationId, ActivityCount, LastActivity, IPAddress


// -----------------------------------------------------------------------------
// Q4: SharePoint Sites Accessed by Agents Without Sensitivity Labels
// Use: Identify knowledge sources with data exposure risk before retrieval activation
// -----------------------------------------------------------------------------
OfficeActivity
| where TimeGenerated > ago(7d)
| where RecordType == "SharePointFileOperation"
    and UserAgent has "agent"
| join kind=leftouter (
    MicrosoftPurviewInformationProtection
    | where TimeGenerated > ago(7d)
    | where Activity == "LabelApplied"
    | distinct ObjectId
) on $left.ObjectId == $right.ObjectId
| where isempty(ObjectId1)
| summarize
    AgentAccesses = count(),
    LastAccess = max(TimeGenerated)
    by SiteUrl, OfficeObjectId, UserId
| sort by AgentAccesses desc
| project SiteUrl, OfficeObjectId, AgentAccesses, LastAccess, UserId


// -----------------------------------------------------------------------------
// Q5: New Agents Deployed in Last 24 Hours — Alert Candidate
// Use: Near-real-time detection of new agent registrations
// Recommended: Schedule as Analytics Rule, frequency 1h, lookback 1d
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(1d)
| where CreatedDateTime > ago(1d)
| extend OwnerDisplay = iff(isnull(Owners) or array_length(Owners) == 0, "UNASSIGNED", tostring(Owners))
| project
    AgentId,
    Name,
    Platform,
    OwnerDisplay,
    LifecycleStatus,
    PublishedStatus,
    CreatedDateTime,
    DeclaredTools,
    McpServers
| extend AlertDetail = strcat(
    "New agent registered: ", Name,
    " | Platform: ", Platform,
    " | Owner: ", OwnerDisplay,
    " | MCP servers: ", tostring(array_length(McpServers))
)
| sort by CreatedDateTime desc


// -----------------------------------------------------------------------------
// Q6: Agents With External MCP Servers or High Tool Count — Supply Chain Risk
// Use: Surface agents whose declared toolset includes external MCP endpoints
//      or anomalously large tool counts (potential permission sprawl)
// New AgentsInfo columns: McpServers (dynamic), DeclaredTools (dynamic), InstanceCount
// -----------------------------------------------------------------------------
AgentsInfo
| where Timestamp > ago(30d)
| extend McpServerCount = iff(isnull(McpServers), 0, array_length(McpServers))
| extend DeclaredToolCount = iff(isnull(DeclaredTools), 0, array_length(DeclaredTools))
| where McpServerCount > 0 or DeclaredToolCount > 10
| extend OwnerDisplay = iff(isnull(Owners) or array_length(Owners) == 0, "UNASSIGNED", tostring(Owners))
| extend RiskSignal = case(
    McpServerCount > 0 and DeclaredToolCount > 10, "High — external MCP + large toolset",
    McpServerCount > 0, "Medium — external MCP server(s) declared",
    "Medium — large declared tool count"
)
| project
    Name, Platform,
    OwnerDisplay, LifecycleStatus, PublishedStatus,
    McpServerCount, McpServers,
    DeclaredToolCount, DeclaredTools,
    InstanceCount, RiskSignal,
    LastSeen = Timestamp
| sort by McpServerCount desc, DeclaredToolCount desc
