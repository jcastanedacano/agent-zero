// =============================================================================
// P01 — DISCOVER & PRIORITIZE
// Agentic AI Security Labs | KQL Library
// Target: Microsoft Sentinel / Defender Advanced Hunting
// Tables: AgentsInfo, CloudAppEvents, OfficeActivity
// MIGRATED: AIAgentsInfo → AgentsInfo (deprecated July 1, 2026)
//   ManagementStatus → LifecycleStatus | TechnicalOwner → Owners (dynamic)
//   CreatedTime → CreatedDateTime | new: PublishedStatus, McpServers, DeclaredTools, InstanceCount
// =============================================================================


// -----------------------------------------------------------------------------
// Q1: Full Agent Inventory by Type and Lifecycle Status
// Use: Baseline visibility — what agents exist and which are unmanaged
// -----------------------------------------------------------------------------
AgentsInfo
| where TimeGenerated > ago(30d)
| summarize
    LastSeen = max(TimeGenerated),
    AgentCount = dcount(AgentId)
    by AgentType, Platform, LifecycleStatus, PublishedStatus, AgentName
| extend RiskLevel = case(
    LifecycleStatus == "Unmanaged", "High",
    LifecycleStatus == "PartiallyManaged", "Medium",
    PublishedStatus == "Inactive", "Medium",
    "Low"
)
| sort by RiskLevel asc, LastSeen desc
| project AgentName, AgentType, Platform, LifecycleStatus, PublishedStatus, RiskLevel, AgentCount, LastSeen


// -----------------------------------------------------------------------------
// Q2: Unmanaged Agents — No Owner, No Registration
// Use: Identify shadow AI — agents operating without formal registration
// -----------------------------------------------------------------------------
AgentsInfo
| where TimeGenerated > ago(30d)
| where LifecycleStatus == "Unmanaged"
    or isempty(tostring(Owners))
| distinct AgentId, AgentName, AgentType, Platform, CreatedDateTime, Owners
| extend OwnerDisplay = iff(isempty(tostring(Owners)), "UNASSIGNED", tostring(Owners))
| extend DaysSinceCreation = datetime_diff('day', now(), CreatedDateTime)
| sort by DaysSinceCreation desc
| project AgentId, AgentName, AgentType, Platform, OwnerDisplay, DaysSinceCreation


// -----------------------------------------------------------------------------
// Q3: Local AI Agents on Endpoints
// Use: Detect agents invisible to cloud inventory (Claude Code, MCP servers, etc.)
// Note: Requires MDE endpoint connector active
// -----------------------------------------------------------------------------
CloudAppEvents
| where TimeGenerated > ago(7d)
| where ActionType == "AgentProcessDetected"
    or ApplicationId has_any ("mcp-server", "claude-code", "openai-api-local")
| summarize
    LastActivity = max(TimeGenerated),
    ActivityCount = count()
    by DeviceName, AccountDisplayName, ApplicationId, IPAddress
| sort by ActivityCount desc
| project DeviceName, AccountDisplayName, ApplicationId, ActivityCount, LastActivity, IPAddress


// -----------------------------------------------------------------------------
// Q4: SharePoint Sites Accessed by Agents Without Sensitivity Labels
// Use: Identify knowledge sources with data exposure risk before retrieval activation
// -----------------------------------------------------------------------------
OfficeActivity
| where TimeGenerated > ago(7d)
| where RecordType == "SharePointFileOperation"
    and UserAgent has "agent"
| join kind=leftouter (
    // Approximate: sites without label events in the same window
    MicrosoftPurviewInformationProtection
    | where TimeGenerated > ago(7d)
    | where Activity == "LabelApplied"
    | distinct ObjectId
) on $left.ObjectId == $right.ObjectId
| where isempty(ObjectId1)   // No label event found for this object
| summarize
    AgentAccesses = count(),
    LastAccess = max(TimeGenerated)
    by SiteUrl, OfficeObjectId, UserId
| sort by AgentAccesses desc
| project SiteUrl, OfficeObjectId, AgentAccesses, LastAccess, UserId


// -----------------------------------------------------------------------------
// Q5: New Agents Deployed in Last 24 Hours — Alert Candidate
// Use: Near-real-time detection of new agent registrations
// Recommended: Schedule as Analytics Rule, frequency 1h, lookback 1d
// -----------------------------------------------------------------------------
AgentsInfo
| where TimeGenerated > ago(1d)
| where CreatedDateTime > ago(1d)
| extend OwnerDisplay = iff(isempty(tostring(Owners)), "UNASSIGNED", tostring(Owners))
| project
    AgentId,
    AgentName,
    AgentType,
    Platform,
    OwnerDisplay,
    LifecycleStatus,
    PublishedStatus,
    CreatedDateTime,
    DeclaredTools,
    McpServers
| extend AlertDetail = strcat(
    "New agent registered: ", AgentName,
    " | Type: ", AgentType,
    " | Owner: ", OwnerDisplay,
    " | MCP servers: ", tostring(array_length(McpServers))
)
| sort by CreatedDateTime desc


// -----------------------------------------------------------------------------
// Q6: Agents With External MCP Servers or High Tool Count — Supply Chain Risk
// Use: Surface agents whose declared toolset includes external MCP endpoints
//      or anomalously large tool counts (potential permission sprawl)
// New AgentsInfo columns: McpServers (dynamic), DeclaredTools (dynamic), InstanceCount
// -----------------------------------------------------------------------------
AgentsInfo
| where TimeGenerated > ago(30d)
| extend McpServerCount = array_length(McpServers)
| extend DeclaredToolCount = array_length(DeclaredTools)
| where McpServerCount > 0 or DeclaredToolCount > 10
| extend OwnerDisplay = iff(isempty(tostring(Owners)), "UNASSIGNED", tostring(Owners))
| extend RiskSignal = case(
    McpServerCount > 0 and DeclaredToolCount > 10, "High — external MCP + large toolset",
    McpServerCount > 0, "Medium — external MCP server(s) declared",
    "Medium — large declared tool count"
)
| project
    AgentName, AgentType, Platform,
    OwnerDisplay, LifecycleStatus, PublishedStatus,
    McpServerCount, McpServers,
    DeclaredToolCount, DeclaredTools,
    InstanceCount, RiskSignal,
    LastSeen = TimeGenerated
| sort by McpServerCount desc, DeclaredToolCount desc
