// skill: secure-network-isolation-agent
// workspace: {workspace-name} | connectors: Azure Activity, Foundry account diagnostics, VNet flows (NTANetAnalytics), Azure Firewall (AZFWApplicationRule); Q1 runs in Azure Resource Graph
// Validated on a Sentinel workspace and in Azure Resource Graph (Oct 2026): the previous version read AzureNetworkAnalytics_CL (traffic analytics of
// NSG flows, which are retired together with the NSG flow logs on September 30, 2027; VNet flows write to NTANetAnalytics) and FoundryAgents_CL (it
// does not exist in the workspace). Q1, Q4, Q5 and Q6 ran against real data.
// Q2 and Q3 read tables that do not exist in the validation workspace (NTANetAnalytics and AZFWApplicationRule): they were tested with a datatable
// built with the Learn schema and are marked NOT VERIFIED with real data.

// ── Query 1 (Azure Resource Graph, not Log Analytics): network exposure of Foundry accounts ────────────────────────
// Result on the validation account: public access enabled, no private endpoints and no outbound network injection.
resources
| where type =~ "microsoft.cognitiveservices/accounts" and kind =~ "AIServices"
| extend PublicNetworkAccess = tostring(properties.publicNetworkAccess), DefaultAction = tostring(properties.networkAcls.defaultAction), PrivateEndpoints = array_length(properties.privateEndpointConnections), OutboundInjection = array_length(properties.networkInjections)
| project name, resourceGroup, subscriptionId, PublicNetworkAccess, DefaultAction, PrivateEndpoints, OutboundInjection
| extend Inbound = case(PublicNetworkAccess =~ "Disabled", "No public access", DefaultAction =~ "Deny", "Selected networks", "Open to the internet")
| extend Outbound = iff(isnull(OutboundInjection) or OutboundInjection == 0, "No outbound network injection", "With outbound network injection")

// ── Query 2: Flows from the agent subnet to the internet (NOT VERIFIED with real data) ─────────────────────────────
// Requires VNet flows with traffic analytics sent to a Log Analytics workspace. With the Foundry managed network there is no record of outbound
// traffic (Learn: "no logging of outbound traffic support yet"), so this query is only useful with your own VNet. FlowType and SubType columns and
// values follow the NTANetAnalytics schema in Learn; Learn shows FlowDirection as I or O in the schema and as Inbound or Outbound in its sample
// queries, so both forms are accepted. Replace agent_subnet with ResourceGroup/VirtualNetwork/Subnet of the delegated subnet.
let lookback = 24h;
let agent_subnet = "rg-foundry/vnet-foundry/snet-agents";
NTANetAnalytics
| where TimeGenerated > ago(lookback)
| where SubType == "FlowLog" and FlowType == "ExternalPublic"
| where FlowDirection in ("O", "Outbound")
| where SrcSubnet =~ agent_subnet
| summarize
    BytesSent     = sum(BytesSrcToDest),
    BytesReceived = sum(BytesDestToSrc),
    AllowedFlows  = sum(AllowedOutFlows),
    DeniedFlows   = sum(DeniedOutFlows),
    Destinations  = make_set(DestPublicIps, 10)
  by SrcSubnet, DestPort, L7Protocol
| extend RiskLevel = case(BytesSent > 10000000, "High", BytesSent > 1000000, "Medium", "Low")
| order by BytesSent desc

// ── Query 3: Destinations (FQDN) requested by the agents through Azure Firewall (NOT VERIFIED with real data) ──────
// Requires Azure Firewall with structured logs (AZFWApplicationRule table) sent to the workspace. Columns follow the Learn schema. Replace
// agent_subnet_cidr with the CIDR of the delegated subnet.
// An allowed FQDN that is not on the approved list, or a repeated Deny, is what needs review. HTTPS destinations without TLS inspection appear only as FQDN.
let lookback = 7d;
let agent_subnet_cidr = "192.168.0.0/24";
AZFWApplicationRule
| where TimeGenerated > ago(lookback)
| where ipv4_is_in_range(SourceIp, agent_subnet_cidr)
| summarize Requests = count(), LastRequest = max(TimeGenerated), Rules = make_set(Rule, 5) by Fqdn, Action
| extend Review = case(Action =~ "Deny", "Blocked by the firewall: confirm whether it was an unauthorized attempt", "Allowed: confirm that the destination is on the approved list")
| order by Requests desc

// ── Query 4: NSG rules that open the network (inbound from the internet or outbound to the internet or AzureCloud) ───
// Reads the rule body from the Start event and joins it with the Success event by CorrelationId. The previous version looked for "Allow" and
// "Internet" as text in the whole body and also flagged narrowly scoped inbound rules.
// AzureCloud as an outbound destination is flagged because it covers the addresses of all Azure customers: it does not limit exfiltration (Learn: a
// service tag cannot be scoped to a tenant or to a resource).
// Result on the validation account: the inbound rule that exists in 180 days has a specific source, so the query returns 0 rows (removing the last
// where shows the rule with Nsg and Rule correctly extracted).
let lookback = 30d;
let succeeded = AzureActivity
    | where TimeGenerated > ago(lookback)
    | where OperationNameValue has "NETWORKSECURITYGROUPS/SECURITYRULES/WRITE" and ActivityStatusValue == "Success"
    | distinct CorrelationId;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue has "NETWORKSECURITYGROUPS/SECURITYRULES/WRITE" and ActivityStatusValue == "Start"
| join kind=leftsemi succeeded on CorrelationId
| extend Body = parse_json(tostring(parse_json(Properties).requestbody)), Entity = tostring(parse_json(Properties).entity)
| extend Rule = tostring(Body.name), Access = tostring(Body.properties.access), Direction = tostring(Body.properties.direction),
         SourcePrefix = tostring(Body.properties.sourceAddressPrefix), DestinationPrefix = tostring(Body.properties.destinationAddressPrefix),
         DestinationPort = tostring(Body.properties.destinationPortRange), Nsg = tostring(split(Entity, "/")[-3])
| extend Exposure = case(
    Access == "Allow" and Direction == "Inbound" and SourcePrefix in ("*", "Internet", "0.0.0.0/0"), "Inbound open to the internet",
    Access == "Allow" and Direction == "Outbound" and DestinationPrefix in ("*", "Internet", "AzureCloud"), "Outbound open (Internet or AzureCloud)",
    "")
| where isnotempty(Exposure)
| project TimeGenerated, Caller, Nsg, Rule, Direction, SourcePrefix, DestinationPrefix, DestinationPort, Exposure
| order by TimeGenerated desc

// ── Query 5: Changes to private endpoints of the network and of the Foundry account ────────────────────────────────
// Creating, deleting or approving a private endpoint changes who can reach the account. A publicNetworkAccess change on the account appears as
// ACCOUNTS/WRITE (see Q4 of the secure-managed-identity-foundry skill) and the Activity Log does not carry the property: compare it with Q1.
// Result on the validation account: 0 rows in 180 days (consistent with Q1: no private endpoints).
let lookback = 180d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue in~ ("MICROSOFT.NETWORK/PRIVATEENDPOINTS/WRITE", "MICROSOFT.NETWORK/PRIVATEENDPOINTS/DELETE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PRIVATEENDPOINTCONNECTIONS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PRIVATEENDPOINTCONNECTIONS/DELETE")
| where ActivityStatusValue == "Success"
| extend Target = tostring(parse_json(Properties).entity)
| project TimeGenerated, Caller, OperationNameValue, Target
| order by TimeGenerated desc

// ── Query 6: Calls to the account from non-private addresses ───────────────────────────────────────────────────────
// With public access disabled and a private endpoint, the expected result is 0 rows. The caller IP comes with the last octets masked, so only the
// prefix is compared. Which IP the diagnostics record for traffic entering through the private endpoint is NOT verified: the validation account has
// public access enabled.
// Result on the validation account: 598 calls in 30 days from 17 public prefixes (the account is open to the internet).
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| where not(CallerIPAddress startswith "10." or CallerIPAddress startswith "192.168." or CallerIPAddress matches regex @"^172\.(1[6-9]|2[0-9]|3[01])\.")
| summarize Requests = count(), LastCall = max(TimeGenerated), Prefixes = dcount(CallerIPAddress) by Resource
| order by Requests desc
