// skill: secure-managed-identity-foundry
// workspace: {workspace-name} | conectores: Azure Activity, Microsoft Entra ID (inicios de sesion de identidades administradas y de entidades de servicio), diagnosticos de la cuenta Foundry; Q1 corre en Azure Resource Graph
// Validado en un workspace Sentinel y en Azure Resource Graph (oct 2026): la version anterior leia FoundryAgents_CL, una tabla personalizada que no existe en ese workspace, y daba por hecho que un
// endpoint Foundry tiene un modo de autenticacion key o aad_token (eso es un concepto de los endpoints en linea de Azure Machine Learning). En Foundry la autenticacion por clave es una propiedad de la
// cuenta (disableLocalAuth) y la clave se obtiene con la operacion listKeys, que el Activity Log si registra. Q1 a Q6 compilan y se ejecutaron; el resultado de la cuenta de validacion esta junto a cada consulta.

// ── Query 1 (Azure Resource Graph, no Log Analytics): cuentas Foundry que todavia aceptan claves ────────────────────
// Resultado en la cuenta de validacion: 1 cuenta, disableLocalAuth falso, identidad SystemAssigned.
resources
| where type =~ "microsoft.cognitiveservices/accounts" and kind =~ "AIServices"
| extend LocalAuthDisabled = tobool(properties.disableLocalAuth), IdentityType = tostring(identity.type)
| project name, resourceGroup, subscriptionId, LocalAuthDisabled, IdentityType
| extend Gap = iff(LocalAuthDisabled == true, "Solo Entra ID", "Acepta claves (disableLocalAuth falso o ausente)")

// ── Query 2: Quien obtiene las claves de la cuenta (listKeys) ──────────────────────────────────────────────────────
// La operacion es MICROSOFT.COGNITIVESERVICES/ACCOUNTS/LISTKEYS/ACTION. Quien tenga un rol que permita listar claves puede usarlas sin pasar por RBAC en cada llamada.
// Resultado en la cuenta de validacion: 19 llamadas de un usuario en 30 dias, desde 13 direcciones IP (el Activity Log no trae el recurso en Resource: se lee de Properties.entity).
let lookback = 30d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/LISTKEYS/ACTION" and ActivityStatusValue == "Success"
| extend Account = tostring(split(tolower(tostring(parse_json(Properties).entity)), "/")[-1])
| extend CallerKind = case(Caller matches regex @"^[0-9a-fA-F-]{36}$", "Identidad de aplicacion", Caller has "@", "Usuario", "Otro")
| summarize ListKeyCalls = count(), FirstCall = min(TimeGenerated), LastCall = max(TimeGenerated), IPs = dcount(CallerIpAddress) by Caller, CallerKind, Account
| order by ListKeyCalls desc

// ── Query 3: Asignaciones de rol sobre Foundry y roles que no corresponden ─────────────────────────────────────────
// El cuerpo de la peticion solo esta en el evento Start, asi que se une con el Success por CorrelationId para quedarse con las asignaciones que si se crearon. Los IDs son los del
// articulo de RBAC de Foundry (los nombres cambiaron de Azure AI User a Foundry User: por eso se usa el ID) y los de los roles integrados de Cognitive Services y Azure AI Developer.
// Resultado en la cuenta de validacion: 3 filas en 90 dias (Foundry User en la cuenta y en el proyecto, y Azure AI Developer en la cuenta, que Learn dice que no aplica a proyectos Foundry).
let foundry_roles = datatable(RoleDefinitionId: string, Role: string, Review: string)[
    "53ca6127-db72-4b80-b1b0-d745d6d5456d", "Foundry User", "Esperado",
    "eed3b665-ab3a-47b6-8f48-c9382fb1dad6", "Foundry Agent Consumer", "Esperado",
    "eadc314b-1a2d-4efa-be10-5d325db5065e", "Foundry Project Manager", "Esperado",
    "e47c6f54-e4a2-4754-9501-8e0985b135e1", "Foundry Account Owner", "Alto privilegio",
    "c883944f-8b7b-4483-af10-35834be79c4a", "Foundry Owner", "Alto privilegio",
    "a97b65f3-24c7-4388-baec-2e87135dc908", "Cognitive Services User", "Puede listar claves",
    "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68", "Cognitive Services Contributor", "Puede listar y regenerar claves",
    "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd", "Cognitive Services OpenAI User", "Solo llamadas directas al modelo de la cuenta",
    "a001fd3d-188f-4b5d-821b-7da978bf7442", "Cognitive Services OpenAI Contributor", "Revisar",
    "64702f94-c441-49e6-a78b-ef80e0188fee", "Azure AI Developer", "No aplica a proyectos Foundry"
];
let lookback = 90d;
let succeeded = AzureActivity
    | where TimeGenerated > ago(lookback)
    | where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE" and ActivityStatusValue == "Success"
    | distinct CorrelationId;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE" and ActivityStatusValue == "Start"
| join kind=leftsemi succeeded on CorrelationId
| extend Body = parse_json(tostring(parse_json(Properties).requestbody)), Entity = tostring(parse_json(Properties).entity)
| extend RoleDefinitionId = tolower(tostring(split(tostring(Body.properties.roleDefinitionId), "/")[-1])),
         PrincipalId = tostring(Body.properties.principalId),
         PrincipalType = tostring(Body.properties.principalType),
         Scope = tostring(split(Entity, "/providers/Microsoft.Authorization")[0])
| join kind=inner foundry_roles on RoleDefinitionId
| project TimeGenerated, Caller, Role, Review, PrincipalType, PrincipalId, Scope
| order by TimeGenerated desc

// ── Query 4: Escrituras sobre la cuenta Foundry (puede reactivar las claves o abrir la red) ────────────────────────
// El Activity Log no trae el cuerpo de esta operacion en el workspace de validacion: dice quien escribio la cuenta y cuando, no que propiedad cambio. Compara siempre con Q1 (estado actual).
// Resultado en la cuenta de validacion: 1 fila en 90 dias (la creacion de la cuenta).
let lookback = 90d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/WRITE" and ActivityStatusValue == "Success"
| extend Account = tostring(split(tolower(tostring(parse_json(Properties).entity)), "/")[-1])
| project TimeGenerated, Caller, CallerIpAddress, Account, CorrelationId
| order by TimeGenerated desc

// ── Query 5: Inicios de sesion con identidad administrada o con identidad de agente (la migracion avanza) ─────────
// Muestra a que recursos piden token las identidades administradas y las identidades de agente. Sirve para confirmar que las aplicaciones migradas usan tokens. El nombre con el que aparece Foundry
// como recurso en estos registros NO esta verificado (en la cuenta de validacion no hay inicios de sesion de identidades administradas hacia Foundry).
// Resultado en la cuenta de validacion: 11 recursos para identidades administradas (por ejemplo Azure Storage y Azure Key Vault) y 2 filas de identidades de agente, sin fallos.
let lookback = 30d;
union
    (AADManagedIdentitySignInLogs | extend Kind = "Managed identity"),
    (AADServicePrincipalSignInLogs
        | extend AgentType = tostring(parse_json(Agent).agentType)
        | where AgentType in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
        | extend Kind = strcat("Agent identity (", AgentType, ")"))
| where TimeGenerated > ago(lookback)
| summarize SignIns = count(), Failures = countif(ResultType != "0"), Principals = dcount(ServicePrincipalId) by Kind, ResourceDisplayName
| order by SignIns desc

// ── Query 6: Quien sigue llamando a la cuenta (impacto antes de desactivar las claves) ─────────────────────────────
// Antes de poner disableLocalAuth en true, mira que trafico de datos hay y desde donde. El diagnostico RequestResponse trae la IP del llamador (con los ultimos octetos enmascarados) y el nombre de la API.
// No distingue clave de token: callerObjectId viene vacio en el 100% de los registros de la cuenta de validacion (598 en 30 dias), asi que no sirve para separar ambos. Para eso decide disableLocalAuth.
// Resultado en la cuenta de validacion: 10 combinaciones de IP y API en las primeras filas (Azure AI Projects API y Azure OpenAI API).
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| extend Props = parse_json(properties_s)
| summarize Requests = count(), LastCall = max(TimeGenerated), Operations = make_set(OperationName, 5) by Resource, CallerIPAddress, Api = tostring(Props.apiName)
| order by Requests desc
