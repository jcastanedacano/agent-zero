// skill: secure-managed-identity-foundry
// workspace: {workspace-name} | connectors: Azure Activity, Microsoft Entra ID (sign-ins of managed identities and service principals), Foundry account diagnostics; Q1 runs in Azure Resource Graph
// Validated on a Sentinel workspace and in Azure Resource Graph (Oct 2026): the previous version read FoundryAgents_CL, a custom table that does not exist in that workspace, and assumed that a
// Foundry endpoint has an authentication mode of key or aad_token (that is a concept of Azure Machine Learning online endpoints). In Foundry, key authentication is a property of the
// account (disableLocalAuth) and the key is obtained with the listKeys operation, which the Activity Log does record. Q1 to Q6 compile and ran; the result on the validation account is next to each query.

// ── Query 1 (Azure Resource Graph, not Log Analytics): Foundry accounts that still accept keys ──────────────────────
// Result on the validation account: 1 account, disableLocalAuth false, SystemAssigned identity.
resources
| where type =~ "microsoft.cognitiveservices/accounts" and kind =~ "AIServices"
| extend LocalAuthDisabled = tobool(properties.disableLocalAuth), IdentityType = tostring(identity.type)
| project name, resourceGroup, subscriptionId, LocalAuthDisabled, IdentityType
| extend Gap = iff(LocalAuthDisabled == true, "Entra ID only", "Accepts keys (disableLocalAuth false or absent)")

// ── Query 2: Who gets the account keys (listKeys) ──────────────────────────────────────────────────────────────────
// The operation is MICROSOFT.COGNITIVESERVICES/ACCOUNTS/LISTKEYS/ACTION. Anyone with a role that allows listing keys can use them without going through RBAC on each call.
// Result on the validation account: 19 calls from one user in 30 days, from 13 IP addresses (the Activity Log does not carry the resource in Resource: it is read from Properties.entity).
let lookback = 30d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/LISTKEYS/ACTION" and ActivityStatusValue == "Success"
| extend Account = tostring(split(tolower(tostring(parse_json(Properties).entity)), "/")[-1])
| extend CallerKind = case(Caller matches regex @"^[0-9a-fA-F-]{36}$", "Application identity", Caller has "@", "User", "Other")
| summarize ListKeyCalls = count(), FirstCall = min(TimeGenerated), LastCall = max(TimeGenerated), IPs = dcount(CallerIpAddress) by Caller, CallerKind, Account
| order by ListKeyCalls desc

// ── Query 3: Role assignments on Foundry and roles that do not belong ──────────────────────────────────────────────
// The request body is only in the Start event, so it is joined with the Success event by CorrelationId to keep the assignments that were actually created. The IDs are those from the
// Foundry RBAC article (the names changed from Azure AI User to Foundry User: that is why the ID is used) and those of the built-in Cognitive Services and Azure AI Developer roles.
// Result on the validation account: 3 rows in 90 days (Foundry User on the account and on the project, and Azure AI Developer on the account, which Learn says does not apply to Foundry projects).
let foundry_roles = datatable(RoleDefinitionId: string, Role: string, Review: string)[
    "53ca6127-db72-4b80-b1b0-d745d6d5456d", "Foundry User", "Expected",
    "eed3b665-ab3a-47b6-8f48-c9382fb1dad6", "Foundry Agent Consumer", "Expected",
    "eadc314b-1a2d-4efa-be10-5d325db5065e", "Foundry Project Manager", "Expected",
    "e47c6f54-e4a2-4754-9501-8e0985b135e1", "Foundry Account Owner", "High privilege",
    "c883944f-8b7b-4483-af10-35834be79c4a", "Foundry Owner", "High privilege",
    "a97b65f3-24c7-4388-baec-2e87135dc908", "Cognitive Services User", "Can list keys",
    "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68", "Cognitive Services Contributor", "Can list and regenerate keys",
    "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd", "Cognitive Services OpenAI User", "Direct calls to the account model only",
    "a001fd3d-188f-4b5d-821b-7da978bf7442", "Cognitive Services OpenAI Contributor", "Review",
    "64702f94-c441-49e6-a78b-ef80e0188fee", "Azure AI Developer", "Does not apply to Foundry projects"
];
let lookback = 90d;
let succeeded = AzureActivity
    | where TimeGenerated > ago(lookback)
    | where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE" and ActivityStatusValue == "Success"
    | distinct CorrelationId;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE" and ActivityStatusValue == "Start"
| join kind=leftsemi succeeded on CorrelationId
| extend Body = parse_json(tostring(parse_json(Properties).requestbody)), Entity = tostring(parse_json(Properties).entity)
| extend RoleDefinitionId = tolower(tostring(split(tostring(Body.properties.roleDefinitionId), "/")[-1])),
         PrincipalId = tostring(Body.properties.principalId),
         PrincipalType = tostring(Body.properties.principalType),
         Scope = tostring(split(Entity, "/providers/Microsoft.Authorization")[0])
| join kind=inner foundry_roles on RoleDefinitionId
| project TimeGenerated, Caller, Role, Review, PrincipalType, PrincipalId, Scope
| order by TimeGenerated desc

// ── Query 4: Writes on the Foundry account (can re-enable keys or open the network) ────────────────────────────────
// The Activity Log does not carry the body of this operation in the validation workspace: it says who wrote the account and when, not which property changed. Always compare with Q1 (current state).
// Result on the validation account: 1 row in 90 days (the account creation).
let lookback = 90d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue =~ "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/WRITE" and ActivityStatusValue == "Success"
| extend Account = tostring(split(tolower(tostring(parse_json(Properties).entity)), "/")[-1])
| project TimeGenerated, Caller, CallerIpAddress, Account, CorrelationId
| order by TimeGenerated desc

// ── Query 5: Sign-ins with managed identity or agent identity (the migration is advancing) ────────────────────────
// Shows which resources managed identities and agent identities request tokens for. It is useful to confirm that migrated applications use tokens. The name under which Foundry
// appears as a resource in these logs is NOT VERIFIED (in the validation account there are no managed identity sign-ins to Foundry).
// Result on the validation account: 11 resources for managed identities (for example Azure Storage and Azure Key Vault) and 2 agent identity rows, with no failures.
let lookback = 30d;
union
    (AADManagedIdentitySignInLogs | extend Kind = "Managed identity"),
    (AADServicePrincipalSignInLogs
        | extend AgentType = tostring(parse_json(Agent).agentType)
        | where AgentType in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
        | extend Kind = strcat("Agent identity (", AgentType, ")"))
| where TimeGenerated > ago(lookback)
| summarize SignIns = count(), Failures = countif(ResultType != "0"), Principals = dcount(ServicePrincipalId) by Kind, ResourceDisplayName
| order by SignIns desc

// ── Query 6: Who is still calling the account (impact before disabling keys) ───────────────────────────────────────
// Before setting disableLocalAuth to true, look at what data traffic there is and from where. The RequestResponse diagnostic carries the caller IP (with the last octets masked) and the API name.
// It does not distinguish key from token: callerObjectId is empty in 100% of the records of the validation account (598 in 30 days), so it cannot separate the two. That is decided by disableLocalAuth.
// Result on the validation account: 10 combinations of IP and API in the first rows (Azure AI Projects API and Azure OpenAI API).
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| extend Props = parse_json(properties_s)
| summarize Requests = count(), LastCall = max(TimeGenerated), Operations = make_set(OperationName, 5) by Resource, CallerIPAddress, Api = tostring(Props.apiName)
| order by Requests desc
