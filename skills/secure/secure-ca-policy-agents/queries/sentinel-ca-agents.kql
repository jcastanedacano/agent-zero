// skill: secure-ca-policy-agents
// workspace: {workspace-name} | connectors: Microsoft Entra ID (AADServicePrincipalSignInLogs)
// Validated on a Sentinel workspace (Oct 2026): the previous version of the skill carried a query inside SKILL.md, with no file, that read only the first policy
// (ConditionalAccessPolicies[0]) and did not separate agents from the other service principals. The Agent column of AADServicePrincipalSignInLogs carries a JSON with agentType
// (agenticAppInstance for an agent identity, agentIdentityBlueprintPrincipal for the blueprint principal). Q1 to Q3 compile and ran; the result from the
// validation account is next to each query.

// ── Query 1: Conditional Access result on agent sign-ins ────────────────────────────────────
// Result on the validation account: 2 rows and 9 sign-ins in 30 days, all with ConditionalAccessStatus notApplied. They are the blueprint principal's token to
// Microsoft Graph and the agent identity's token exchange on "AAD Token Exchange Endpoint: Public": Learn leaves them outside Conditional Access. They are not a policy failure.
let lookback = 30d;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| extend AgentType = tostring(parse_json(Agent).agentType)
| where AgentType in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
| summarize SignIns = count(), CABlocked = countif(ResultType == "53003"), Disabled = countif(ResultType == "7000112") by AgentType, ResourceDisplayName, ConditionalAccessStatus
| order by SignIns desc

// ── Query 2: Which policies evaluated the agent sign-ins, and with what result ──────────────────────────
// ConditionalAccessPolicies is an array with all the evaluated policies. A policy in report-only mode appears with reportOnly results (for example reportOnlyNotApplied or
// reportOnlyFailure): this is what to review during the test week before moving it to enabled.
// Result on the validation account: the blueprint principal to Microsoft Graph row carries the 4 agent policies (one enabled with result notApplied and three in report-only with reportOnlyNotApplied); the 8 agent identity rows on the token exchange carry no evaluated policy.
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| extend AgentType = tostring(parse_json(Agent).agentType)
| where AgentType in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
| mv-expand Pol = parse_json(ConditionalAccessPolicies)
| summarize Evaluations = count() by Policy = tostring(Pol.displayName), PolicyResult = tostring(Pol.result), AgentType, ResourceDisplayName
| order by Evaluations desc

// ── Query 3: Blocks by Conditional Access and by disabled identity ───────────────────────────────────────────
// 53003 is the code Entra returns when a Conditional Access policy blocks access; 7000112 is the one for a disabled application (for example after containment).
// It includes all service principals and marks which ones are agents. Result on the validation account: 0 rows in 30 days (no policy blocked a sign-in).
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| where ResultType in ("53003", "7000112")
| extend AgentType = tostring(parse_json(Agent).agentType)
| project TimeGenerated, ServicePrincipalName, AppId, AgentType, ResourceDisplayName, ResultType, ResultDescription, IPAddress
| order by TimeGenerated desc
