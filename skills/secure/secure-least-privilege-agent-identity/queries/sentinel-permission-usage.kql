// skill: secure-least-privilege-agent-identity
// workspace: {workspace-name} | conectores: Microsoft Entra ID (AADServicePrincipalSignInLogs, AuditLogs), MicrosoftGraphActivityLogs
// Validado en un workspace Sentinel (oct 2026): la version anterior leia una columna Scopes que AADServicePrincipalSignInLogs no tiene (Q1 y Q2 no compilaban) y sacaba los permisos
// de AuditLogs con tostring(AdditionalDetails). Ahora Q1 cruza los permisos de aplicacion que lleva el token (columna Roles de MicrosoftGraphActivityLogs) con lo que la aplicacion hace,
// Q2 usa los recursos y el tipo de credencial de los inicios de sesion, Q3 busca los 401 y 403 despues de un recorte y Q4 lee los permisos concedidos en AuditLogs.
// Q1 a Q4 compilan y se ejecutaron; el resultado de la cuenta de validacion esta junto a cada consulta.

// ── Query 1: Permisos de escritura que la aplicacion tiene y no usa (Microsoft Graph, 30 dias) ────────────────────────
// Roles es la lista de permisos de aplicacion del ultimo token, separados por espacio. WriteRoles son los que por nombre permiten escribir o actuar (ReadWrite, Write, Manage, FullControl, Create,
// Send, Remove, Invite, EnableDisable, RevokeSessions). NonGetCalls = 0 es una buena senal de que solo leyo; NonGetCalls > 0 no prueba que escriba (hay POST que solo leen, como las busquedas y los lotes).
// Solo cubre Microsoft Graph: lo que la aplicacion haga contra otras APIs no sale aqui. Resultado en la cuenta de validacion: las 12 primeras filas (las de mas permisos de escritura) son todas candidatas, sin una sola llamada que no sea GET en 30 dias.
let lookback = 30d;
let write_roles = @"(\S*(?:ReadWrite|Write|Manage|FullControl|Create|Send|Remove|Invite|EnableDisable|RevokeSessions)\S*)";
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(lookback)
| where isnotempty(ServicePrincipalId)
| summarize Calls = count(), NonGetCalls = countif(RequestMethod != "GET"), Endpoints = dcount(tostring(split(RequestUri, "?")[0])), arg_max(TimeGenerated, Roles) by AppId, ServicePrincipalId
| extend WriteRoles = extract_all(write_roles, Roles)
| extend WriteRoleCount = array_length(WriteRoles)
| extend Verdict = case(WriteRoleCount > 0 and NonGetCalls == 0, "Candidato: tiene permisos de escritura y solo leyo", WriteRoleCount > 0, "Usa escritura: revisar el alcance", "Solo lectura")
| project AppId, ServicePrincipalId, Calls, NonGetCalls, Endpoints, WriteRoleCount, WriteRoles, Verdict
| order by Verdict asc, WriteRoleCount desc

// ── Query 2: A que recursos pide token cada entidad de servicio y con que credencial ────────────────────────────────
// Sustituye a la consulta que leia Scopes. ClientCredentialType dice con que se autentica (clientSecret, clientAssertion, federatedIdentityCredential, certificado): un secreto es un
// candidato a pasar a identidad administrada o a federacion (ver secure-managed-identity-foundry y secure-secret-management-keyvault). AgentType separa los agentes del resto.
// Resultado en la cuenta de validacion: decenas de combinaciones con secretos, afirmaciones de cliente y credenciales federadas; una sola identidad de agente (federada).
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| where ResultType == "0"
| extend AgentType = tostring(parse_json(Agent).agentType)
| summarize SignIns = count(), LastSignIn = max(TimeGenerated), Credentials = make_set(ClientCredentialType, 3), IPs = dcount(IPAddress) by ServicePrincipalName, AppId, AgentType, ResourceDisplayName
| order by SignIns desc

// ── Query 3: Llamadas denegadas a Microsoft Graph despues de reducir permisos ───────────────────────────────────────
// Un permiso de aplicacion recortado no rompe el inicio de sesion: el token se sigue emitiendo y la llamada falla con 403 en Graph. Por eso se busca aqui y no en los inicios de sesion.
// El token ya emitido conserva sus permisos hasta que caduca (60 a 90 minutos por defecto): mira despues de ese tiempo. Resultado en la cuenta de validacion: 2 combinaciones de aplicacion y endpoint en 3 dias.
let after = 3d;
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(after)
| where isnotempty(ServicePrincipalId)
| where ResponseStatusCode in (401, 403)
| summarize Denied = count(), FirstDenied = min(TimeGenerated), LastDenied = max(TimeGenerated), Methods = make_set(RequestMethod, 4) by AppId, Endpoint = tostring(split(RequestUri, "?")[0]), ResponseStatusCode
| order by Denied desc

// ── Query 4: Permisos concedidos (de aplicacion y delegados) en los ultimos 90 dias ──────────────────────────────────
// Lee los eventos "Add app role assignment to service principal" y "Add delegated permission grant": el permiso esta en las propiedades modificadas del primer recurso objetivo
// (AppRole.Value o DelegatedPermissionGrant.Scope) y quien lo recibe en el segundo objetivo. HighPrivilegePermissions lista los permisos con ReadWrite, FullControl, Manage, AccessAsUser, RoleManagement o Directory.
// Resultado en la cuenta de validacion: 31 concesiones en 90 dias, 24 delegadas (varias con consentimiento de administrador para todos los usuarios y listas de hasta 140 permisos, la mitad de ellos de alto privilegio) y 7 de aplicacion.
let grants_lookback = 90d;
let high = @"(\S*(?:ReadWrite|FullControl|Manage|AccessAsUser|RoleManagement|Directory)\S*)";
AuditLogs
| where TimeGenerated > ago(grants_lookback)
| where OperationName in ("Add app role assignment to service principal", "Add delegated permission grant")
| extend Resource = tostring(TargetResources[0].displayName), Grantee2 = tostring(TargetResources[1].displayName), Props = TargetResources[0].modifiedProperties
| mv-apply P = Props on (
    summarize Permission = take_anyif(trim(@'"', tostring(P.newValue)), tostring(P.displayName) in ("AppRole.Value", "DelegatedPermissionGrant.Scope")),
              GranteeName = take_anyif(trim(@'"', tostring(P.newValue)), tostring(P.displayName) == "ServicePrincipal.DisplayName"),
              GranteeId = take_anyif(trim(@'"', tostring(P.newValue)), tostring(P.displayName) == "ServicePrincipal.ObjectID"),
              ConsentType = take_anyif(trim(@'"', tostring(P.newValue)), tostring(P.displayName) == "DelegatedPermissionGrant.ConsentType"))
| extend GrantType = iff(OperationName has "delegated", "Delegada", "Aplicacion")
| extend Grantee = coalesce(GranteeName, Grantee2, GranteeId)
| extend Initiator = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
| extend PermissionCount = array_length(extract_all(@"(\S+)", Permission)), HighPrivilegePermissions = extract_all(high, Permission)
| extend HighPrivilegeCount = array_length(HighPrivilegePermissions)
| project TimeGenerated, GrantType, Resource, Grantee, ConsentType, Initiator, PermissionCount, HighPrivilegeCount, HighPrivilegePermissions
| order by HighPrivilegeCount desc, TimeGenerated desc
