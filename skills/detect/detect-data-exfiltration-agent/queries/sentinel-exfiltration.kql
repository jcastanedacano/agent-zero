// skill: detect-data-exfiltration-agent
// workspace: {workspace-name} | connectors: Microsoft 365 (OfficeActivity), Foundry diagnostics (AzureDiagnostics), Application Insights (AppDependencies, optional)
// Validated on a Sentinel workspace (Oct 2026): the previous version read PurviewAuditLog, MicrosoftDataLossPrevention and FoundryAgents_CL, tables that do not
// exist in that workspace. SharePoint, OneDrive and Exchange events are in OfficeActivity (Microsoft 365 connector): an application or agent with
// application permissions appears with UserType Application (UserId app@sharepoint and ApplicationId in SharePoint and OneDrive; ClientAppId in Exchange), and the
// DLP matches for Exchange and SharePoint are DLPRuleMatch or DlpRuleMatch operations. Q1, Q2 and Q4 compile and returned rows, Q5 returned rows with a low
// threshold, and Q3 compiles and has no rows (AppDependencies is empty): NOT VERIFIED.
// OfficeActivity does not distinguish what Copilot reads on behalf of the user: that is in CopilotActivity (KQL Library P04-Q6).

// ── Query 1: Bulk file access by an application or a user in a short window ───────────────────────────
// Validated: it returned bulk access by a third-party application (Java client) with hundreds of files in 30 minutes. Microsoft sync and cache
// applications can also cross the threshold: fill allowed_apps with the ApplicationId values you already know.
// To watch agents only, filter by UserType == "Application".
let detection_window = 2h;
let bulk_threshold   = 50;
let allowed_apps     = dynamic([]);
OfficeActivity
| where TimeGenerated > ago(detection_window)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded")
| where isempty(ApplicationId) or ApplicationId !in (allowed_apps)
| extend Initiator = iff(UserType == "Application", "Application or agent", "User")
| extend Actor = iff(UserType == "Application", strcat("app:", ApplicationId), UserId)
| summarize
    FileCount     = dcount(OfficeObjectId),
    SitesAccessed = dcount(Site_Url),
    Events        = count(),
    FirstSeen     = min(TimeGenerated),
    LastSeen      = max(TimeGenerated),
    SampleFiles   = make_set(SourceFileName, 5),
    UserAgents    = make_set(UserAgent, 3)
  by Actor, Initiator, Window = bin(TimeGenerated, 30m)
| where FileCount > bulk_threshold
| extend TimeSpanMin = datetime_diff("minute", LastSeen, FirstSeen)
| extend Alert = strcat("Bulk access: ", FileCount, " unique files in ", TimeSpanMin, " minutes")
| extend Severity = case(FileCount > 200, "High", FileCount > 100, "Medium", "Low")
| order by FileCount desc

// ── Query 2: Mail sent by an application or agent to external domains ──────────────────────────────────────
// Recipients are in Item.Recipients of the Exchange Send event (Address and Name). The mail is sent by an application with the Mail.Send permission
// through the Graph REST API: UserId is the mailbox, UserType is Application and ClientAppId identifies the application.
let lookback         = 24h;
let internal_domains = dynamic(["contoso.com"]);   // adjust to the tenant
OfficeActivity
| where TimeGenerated > ago(lookback)
| where OfficeWorkload == "Exchange"
| where Operation in ("Send", "SendAs", "SendOnBehalf")
| where UserType == "Application"
| extend ItemJson = parse_json(Item)
| mv-expand Recipient = ItemJson.Recipients
| extend RecipientAddress = tolower(tostring(Recipient.Address))
| extend RecipientDomain = tostring(split(RecipientAddress, "@")[1])
| where RecipientDomain !in (internal_domains)
| summarize ExternalRecipients = make_set(RecipientAddress, 10)
    by TimeGenerated, Mailbox = UserId, ClientAppId, Subject = tostring(ItemJson.Subject), MessageId = tostring(ItemJson.InternetMessageId)
| extend Alert = "An application or agent sent mail to an external domain: possible exfiltration"
| order by TimeGenerated desc

// ── Query 3: Outbound HTTP calls from instrumented agents to non-Microsoft domains ─────────────
// NOT VERIFIED: AppDependencies (workspace-based Application Insights) is empty in the validation workspace. Which agent tools
// emit an HTTP dependency depends on the instrumentation: if the agent does not emit spans for its HTTP calls, this query sees nothing.
AppDependencies
| where TimeGenerated > ago(24h)
| where DependencyType has "HTTP"
| extend Domain = tolower(tostring(split(Target, ":")[0]))
| where isnotempty(Domain)
| where not(Domain endswith ".azure.com" or Domain endswith ".microsoft.com" or Domain endswith ".windows.net"
    or Domain endswith ".azurewebsites.net" or Domain endswith ".openai.azure.com")
| summarize
    CallCount  = count(),
    LastCall   = max(TimeGenerated),
    Agents     = dcount(AppRoleName),
    AgentNames = make_set(AppRoleName, 5)
  by Domain
| where CallCount > 5
| extend Risk = case(
    Domain has_any ("pastebin", "ngrok", "webhook.site", "requestbin"), "High: suspicious destination",
    "Review: external destination not cataloged")
| order by CallCount desc

// ── Query 4: Mail sent by an application or agent that matched a DLP rule ───────────────────────
// Joins the Send event of an application with the Exchange DlpRuleMatch event by the message identifier (Item.InternetMessageId in Send and
// OfficeObjectId in DlpRuleMatch). Validated: the key matches, 41 matches in 90 days of mail sent by users and by applications, and the
// query returned mail sent by an application. The DLP event carries the user and the record type, not the policy name.
let lookback = 24h;
let app_sent = OfficeActivity
    | where TimeGenerated > ago(lookback)
    | where OfficeWorkload == "Exchange"
    | where Operation in ("Send", "SendAs", "SendOnBehalf")
    | where UserType == "Application"
    | extend ItemJson = parse_json(Item)
    | project SentTime = TimeGenerated, Mailbox = UserId, ClientAppId, Subject = tostring(ItemJson.Subject), MessageId = tostring(ItemJson.InternetMessageId);
OfficeActivity
| where TimeGenerated > ago(lookback)
| where OfficeWorkload == "Exchange"
| where Operation in ("DlpRuleMatch", "DLPRuleMatch")
| project DlpTime = TimeGenerated, DlpUser = UserId, MessageId = OfficeObjectId
| join kind=inner app_sent on MessageId
| project SentTime, DlpTime, Mailbox, ClientAppId, Subject, MessageId
| extend Alert = "Mail from an application or agent matches a DLP rule: possible exfiltration of sensitive data"
| order by SentTime desc

// ── Query 5: Response volume per caller in a Foundry account (Azure OpenAI diagnostics) ──────────────
// The RequestResponse records of MICROSOFT.COGNITIVESERVICES (AzureDiagnostics table) carry requestLength and responseLength in bytes inside
// properties_s, plus OperationName, CallerIPAddress and callerObjectId. They carry no tokens or content. Validated: it runs over 596 records from 30 days; in that
// account the observed calls are administrative (listing vector stores, projects) and the volume is KB, so the 10 MB threshold does not
// fire. Adjust the threshold to your normal usage. The token-based estimate of the previous version was not a measure of bytes.
let lookback  = 24h;
let threshold_mb = 10.0;
AzureDiagnostics
| where TimeGenerated > ago(lookback)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| extend Props = parse_json(properties_s)
| extend RequestBytes = tolong(Props.requestLength), ResponseBytes = tolong(Props.responseLength), CallerObjectId = tostring(Props.callerObjectId)
| summarize
    Requests   = count(),
    RequestMB  = round(sum(RequestBytes) / 1048576.0, 3),
    ResponseMB = round(sum(ResponseBytes) / 1048576.0, 3),
    Operations = make_set(OperationName, 5),
    FirstSeen  = min(TimeGenerated),
    LastSeen   = max(TimeGenerated)
  by Resource, CallerObjectId, CallerIPAddress
| where ResponseMB > threshold_mb
| extend Alert = strcat("High response volume: ", ResponseMB, " MB in the window")
| order by ResponseMB desc
