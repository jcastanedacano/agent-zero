// skill: detect-agent-identity-abuse
// workspace: {workspace-name} | connectors: AADServicePrincipalSignInLogs, AuditLogs-EntraID
// Validated on a Sentinel workspace (Oct 2026). The previous version identified agents by name (has_any "agent", "bot",
// "copilot", "sp-") in all four queries, and Q1 compared the IP with private prefixes (10., 172.16., 192.168.), which never appear
// as the source of a service principal sign-in. Agents now come from the Agent column of AADServicePrincipalSignInLogs
// (agentType: agenticAppInstance or agentIdentityBlueprintPrincipal, last 30 days) plus the known_agent_sps list for agents that are
// plain service principals (populate it from the watchlist in Step 5), and Q1 compares each sign-in with the IPs that service
// principal used before. Q2 counts only agent identities: creating agent identities is the documented function of the blueprint principal.
// Result on the validation account (90 days): 1 agent identity and 1 blueprint principal with 9 sign-ins. Q1, with a 20-day window instead of
// 1 hour so there was data, returns both as "no baseline" (the agent has 8 sign-ins in 90 days); Q2 returns 0 of 82 application-initiated creations (the name-based version
// returned 5 rows from Microsoft services); Q3 reads 47 role events with role and principal and none is from an agent; Q4 returns 0 rows
// (a single country). The "New IP" branch of Q1 and the logic of Q4 were checked with a test datatable.
// Query 5 (CA bypass) was removed: it counted reportOnlyFailure as a bypass, but a report-only result is never
// enforced, and a failure result means the policy blocks the sign-in (ResultType 53003), so it does not
// coexist with ResultType 0. The Conditional Access coverage of agent sign-ins is read with Query 1 of
// secure-ca-policy-agents (queries/sentinel-ca-agents.kql).

// ── Query 1: Agent signing in from an IP it had not used before ────────────────────────────────────────────
let lookback = 1h;
let baseline_window = 14d;
let known_agent_sps = dynamic([]);  // service principals of agents without Entra Agent ID: populate from the watchlist in Step 5
let agent_principals = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | where tostring(parse_json(Agent).agentType) in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
    | summarize by ServicePrincipalId;
let agent_sp_ids = set_union(coalesce(toscalar(agent_principals | summarize make_set(ServicePrincipalId)), dynamic([])), known_agent_sps);
let baseline = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(baseline_window) .. ago(lookback))
    | where ResultType == "0"
    | summarize KnownIPs = make_set(IPAddress, 200) by ServicePrincipalId;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| where ResultType == "0"  // successful only: failed ones are less concerning
| where ServicePrincipalId in (agent_sp_ids)
| join kind=leftouter baseline on ServicePrincipalId
| where isnull(KnownIPs) or not(set_has_element(KnownIPs, IPAddress))
| extend Baseline = iff(isnull(KnownIPs), "no baseline", "New IP")
| extend Severity = iff(Baseline == "New IP", "High", "Medium")
| project
    TimeGenerated,
    ServicePrincipalName,
    ServicePrincipalId,
    IPAddress,
    Location,
    ResourceDisplayName,
    ConditionalAccessStatus,
    Baseline,
    Severity
| extend Alert = iff(Baseline == "New IP",
    strcat("Agent signed in from an IP it had not used before: ", IPAddress, " (", Location, ")"),
    strcat("Agent with no IP baseline signed in from ", IPAddress, " (", Location, ")"))
| order by TimeGenerated desc

// ── Query 2: Agent spawning, an agent identity creates applications or service principals ──────────────────────
let lookback = 24h;
let known_agent_sps = dynamic([]);  // service principals of agents without Entra Agent ID: populate from the watchlist in Step 5
let agent_instances = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | where tostring(parse_json(Agent).agentType) == "agenticAppInstance"
    | summarize by ServicePrincipalId, AppId;
let agent_sp_ids = set_union(coalesce(toscalar(agent_instances | summarize make_set(ServicePrincipalId)), dynamic([])), known_agent_sps);
let agent_app_ids = coalesce(toscalar(agent_instances | summarize make_set(AppId)), dynamic([]));
// In AuditLogs the initiator carries servicePrincipalId in some events and appId in others (624 and 692 of 1,534 events initiated by an
// application in 90 days), so it is compared with both lists. "Create application" does not exist: the credentials operation
// (Certificates and secrets management) does not create an application.
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName in ("Add application", "Add service principal")
| extend
    InitiatorSpId = tostring(InitiatedBy.app.servicePrincipalId),
    InitiatorAppId = tostring(InitiatedBy.app.appId),
    InitiatedByApp = tostring(InitiatedBy.app.displayName)
| where InitiatorSpId in (agent_sp_ids) or InitiatorAppId in (agent_app_ids)
| extend
    NewEntityName = tostring(TargetResources[0].displayName),
    NewEntityType = tostring(TargetResources[0].type)
| project TimeGenerated, InitiatedByApp, NewEntityName, NewEntityType, Result
| extend Alert = strcat("AGENT SPAWNING: '", InitiatedByApp, "' created new SP/App '", NewEntityName, "'")
| extend Severity = "Critical"
| order by TimeGenerated desc

// ── Query 3: Privilege escalation, role assigned to an agent ───────────────────────────────────────────────────
let known_agent_sps = dynamic([]);  // service principals of agents without Entra Agent ID: populate from the watchlist in Step 5
let agent_principals = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | where tostring(parse_json(Agent).agentType) in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
    | summarize by ServicePrincipalId;
let agent_sp_ids = set_union(coalesce(toscalar(agent_principals | summarize make_set(ServicePrincipalId)), dynamic([])), known_agent_sps);
AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName has_any (
    "Add member to role",
    "Create role assignment",
    "Add eligible member to role"
)
// Validated: the previous version read the role in TargetResources[1] and the principal in TargetResources[0]. There are two
// event shapes: in PIM operations the role is a target of type Role with displayName; in direct assignments
// ("Add member to role", 19 of 47 events in 90 days) the Role target carries no name, the role comes in the
// Role.DisplayName property of the principal and a user carries userPrincipalName instead of displayName. With both
// shapes read, all 47 events come out with role and principal. The principal is compared by its id (TR.id), not by name.
| mv-apply TR = TargetResources on (
    summarize
        RoleElementName = take_anyif(tostring(TR.displayName), tostring(TR.type) == "Role"),
        AssignedTo      = take_anyif(coalesce(tostring(TR.displayName), tostring(TR.userPrincipalName)), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        AssignedToId    = take_anyif(tostring(TR.id), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        PrincipalProps  = take_anyif(TR.modifiedProperties, tostring(TR.type) in ("User", "ServicePrincipal", "Group")))
| mv-apply MP = iff(array_length(PrincipalProps) > 0, PrincipalProps, dynamic([null])) on (
    summarize RoleFromProps = take_anyif(tostring(parse_json(tostring(MP.newValue))), tostring(MP.displayName) == "Role.DisplayName"))
| extend RoleAssigned = coalesce(RoleElementName, RoleFromProps)
| extend AssignedBy = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
| where AssignedToId in (agent_sp_ids)
| extend RiskLevel = case(
    RoleAssigned has_any ("Global Administrator", "Privileged Role Administrator",
        "Application Administrator", "Owner", "Contributor"), "Critical",
    RoleAssigned has_any ("Security Administrator", "Exchange Administrator",
        "SharePoint Administrator"), "High",
    "Medium"
)
| project TimeGenerated, AssignedTo, RoleAssigned, AssignedBy, RiskLevel
| extend Alert = strcat("Role '", RoleAssigned, "' assigned to agent '", AssignedTo, "'")
| order by RiskLevel asc, TimeGenerated desc

// ── Query 4: Impossible travel for agents ──────────────────────────────────────────────────────────────────────
let detection_window = 2h;
let travel_minutes   = 60;
let known_agent_sps = dynamic([]);  // service principals of agents without Entra Agent ID: populate from the watchlist in Step 5
let agent_principals = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | where tostring(parse_json(Agent).agentType) in ("agenticAppInstance", "agentIdentityBlueprintPrincipal")
    | summarize by ServicePrincipalId;
let agent_sp_ids = set_union(coalesce(toscalar(agent_principals | summarize make_set(ServicePrincipalId)), dynamic([])), known_agent_sps);
let agent_signins = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(detection_window)
    | where ResultType == "0"
    | where ServicePrincipalId in (agent_sp_ids)
    | where isnotempty(Location)
    | project TimeGenerated, ServicePrincipalName, ServicePrincipalId, IPAddress, Location;
agent_signins
| join kind=inner (
    agent_signins
    | project TimeGenerated2 = TimeGenerated, ServicePrincipalId, IPAddress2 = IPAddress, Location2 = Location
) on ServicePrincipalId
| where Location != Location2
| where TimeGenerated < TimeGenerated2  // each pair only once
| where datetime_diff("minute", TimeGenerated2, TimeGenerated) < travel_minutes
| project
    ServicePrincipalName,
    FirstAuth  = TimeGenerated,  Location1 = Location,  IP1 = IPAddress,
    SecondAuth = TimeGenerated2, Location2, IP2 = IPAddress2,
    MinutesBetween = datetime_diff("minute", TimeGenerated2, TimeGenerated)
| extend Alert = strcat("Impossible travel: ", Location1, " → ", Location2, " in ", MinutesBetween, " min")
| order by MinutesBetween asc
