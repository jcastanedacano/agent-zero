// skill: detect-agent-identity-abuse
// workspace: {workspace-name} | conectores: AADServicePrincipalSignInLogs, AuditLogs-EntraID
// Validado en un workspace Sentinel (oct 2026): las 5 consultas se ejecutan sin errores (Q1, Q2, Q3, Q4 y Q5 con
// ventanas más largas que las de la regla, para tener datos). Q2 y Q3 se corrigieron; Q1, Q4 y Q5 no cambiaron.
// Q4 y Q5 no devolvieron filas (no hay actividad que coincida), por lo que su lógica solo está validada
// sintácticamente.

// ── Query 1: SP de agente autenticando desde IP desconocida ──────────────────
let corporate_prefixes = dynamic(["10.", "172.16.", "192.168.", "20.190."]);  // ajustar
let known_agent_sps = dynamic([]);  // poblar desde watchlist o hardcodear
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1h)
| where ResultType == 0  // solo exitosas — las fallidas son menos preocupantes
| where not(IPAddress has_any (corporate_prefixes))
| where ServicePrincipalName has_any ("agent", "bot", "copilot", "sp-agent")
    or ServicePrincipalId in (known_agent_sps)
| project
    TimeGenerated,
    ServicePrincipalName,
    ServicePrincipalId,
    IPAddress,
    Location,
    ResourceDisplayName,
    ConditionalAccessStatus
| extend Alert = strcat("SP de agente autenticó desde IP externa: ", IPAddress, " (", Location, ")")
| extend Severity = iff(ConditionalAccessStatus == "success", "High", "Medium")
| order by TimeGenerated desc

// ── Query 2: Agent spawning — SP creando nuevas aplicaciones o SPs ───────────
AuditLogs
| where TimeGenerated > ago(24h)
// Validado: la versión anterior devolvía 95 filas en 90 días, porque "or user == vacío" se cumple siempre que
// inicia una app, así que el filtro por nombre no filtraba nada (servicios de Azure creando service principals).
// Con el filtro por nombre aplicado quedan 5 filas, de servicios de Microsoft con "agent" en el nombre. Además,
// "Create application" también coincidía con la operación de credenciales (Certificates and secrets management),
// que no crea una aplicación.
| where OperationName in ("Add application", "Add service principal")
| extend
    InitiatorType = tostring(InitiatedBy.app.displayName)
| where isnotempty(InitiatorType)  // iniciado por una app (no por un usuario humano)
| where InitiatorType has_any ("agent", "bot", "copilot", "sp-", "PowerVirtual")
| extend
    NewEntityName = tostring(TargetResources[0].displayName),
    NewEntityType = tostring(TargetResources[0].type),
    InitiatedByApp = tostring(InitiatedBy.app.displayName)
| project TimeGenerated, InitiatedByApp, NewEntityName, NewEntityType
| extend Alert = strcat("AGENT SPAWNING: '", InitiatedByApp, "' creó nuevo SP/App '", NewEntityName, "'")
| extend Severity = "Critical"
| order by TimeGenerated desc

// ── Query 3: Escalada de privilegios — rol asignado a SP de agente ────────────
AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName has_any (
    "Add member to role",
    "Create role assignment",
    "Add eligible member to role"
)
// Validado: la versión anterior leía el rol en TargetResources[1] y el principal en TargetResources[0]. Hay dos
// formas de evento: en las operaciones de PIM el rol es un target de tipo Role con displayName; en las asignaciones
// directas ("Add member to role", 19 de 47 eventos en 90 días) el target Role no trae nombre, el rol viene en la
// propiedad Role.DisplayName del principal y un usuario trae userPrincipalName en lugar de displayName. Con ambas
// formas leídas, los 47 eventos salen con rol y principal.
| mv-apply TR = TargetResources on (
    summarize
        RoleElementName = take_anyif(tostring(TR.displayName), tostring(TR.type) == "Role"),
        AssignedTo      = take_anyif(coalesce(tostring(TR.displayName), tostring(TR.userPrincipalName)), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        PrincipalProps  = take_anyif(TR.modifiedProperties, tostring(TR.type) in ("User", "ServicePrincipal", "Group")))
| mv-apply MP = iff(array_length(PrincipalProps) > 0, PrincipalProps, dynamic([null])) on (
    summarize RoleFromProps = take_anyif(tostring(parse_json(tostring(MP.newValue))), tostring(MP.displayName) == "Role.DisplayName"))
| extend RoleAssigned = coalesce(RoleElementName, RoleFromProps)
| extend AssignedBy = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
| where AssignedTo has_any ("agent", "bot", "sp-", "copilot")
| extend RiskLevel = case(
    RoleAssigned has_any ("Global Administrator", "Privileged Role Administrator",
        "Application Administrator", "Owner", "Contributor"), "Critical",
    RoleAssigned has_any ("Security Administrator", "Exchange Administrator",
        "SharePoint Administrator"), "High",
    "Medium"
)
| project TimeGenerated, AssignedTo, RoleAssigned, AssignedBy, RiskLevel
| extend Alert = strcat("Rol '", RoleAssigned, "' asignado al agente '", AssignedTo, "'")
| order by RiskLevel asc, TimeGenerated desc

// ── Query 4: Impossible travel para service principals de agentes ─────────────
let detection_window = 2h;
let travel_minutes   = 60;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(detection_window)
| where ResultType == 0
| where ServicePrincipalName has_any ("agent", "bot", "sp-", "copilot")
| project TimeGenerated, ServicePrincipalName, IPAddress, Location
| join kind=inner (
    AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(detection_window)
    | where ResultType == 0
    | project TimeGenerated2 = TimeGenerated, ServicePrincipalName,
        IPAddress2 = IPAddress, Location2 = Location
) on ServicePrincipalName
| where Location != Location2
| where abs(datetime_diff("minute", TimeGenerated, TimeGenerated2)) < travel_minutes
| where IPAddress != IPAddress2
| project
    ServicePrincipalName,
    FirstAuth  = TimeGenerated,  Location1 = Location,  IP1 = IPAddress,
    SecondAuth = TimeGenerated2, Location2, IP2 = IPAddress2,
    MinutesBetween = abs(datetime_diff("minute", TimeGenerated, TimeGenerated2))
| where MinutesBetween > 0  // eliminar duplicados
| extend Alert = strcat("Impossible travel: ", Location, " → ", Location2, " en ", MinutesBetween, " min")
| order by MinutesBetween asc

// ── Query 5: CA policy bypass — autenticación de SP que debería estar bloqueada ─
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(24h)
| where ResultType == 0  // éxito
| extend Policies = parse_json(tostring(ConditionalAccessPolicies))
| mv-expand Policy = Policies
| where tostring(Policy.result) has_any ("failure", "reportOnlyFailure")
    and ResultType == 0  // CA falló pero el sign-in fue exitoso = bypass
| project
    TimeGenerated,
    ServicePrincipalName,
    IPAddress,
    PolicyName = tostring(Policy.displayName),
    PolicyResult = tostring(Policy.result)
| extend Alert = strcat("CA policy '", PolicyName, "' falló pero sign-in exitoso — posible bypass")
| order by TimeGenerated desc
