// skill: detect-respond-playbook-agent-containment
// workspace: {workspace-name}
// Uso: consultas de hunting durante la respuesta a incidentes y para preservar evidencia forense
// Validado en un workspace Sentinel (oct 2026): la version anterior leia CopilotStudio_CL y PurviewAuditLog, que no existen en ese workspace.
// Ahora usa CopilotActivity (por AgentName), AADServicePrincipalSignInLogs, MicrosoftGraphActivityLogs, AuditLogs y OfficeActivity. Todas compilan y se
// ejecutaron con valores reales sustituidos en las variables; Q1 devolvio actividad de Graph y de OfficeActivity de una aplicacion, y no devolvio filas de
// CopilotActivity ni de AuditLogs para ese valor. Sustituye {agent-name}, {agent-sp-id} (object id del service principal) y {agent-app-id} (appId).

// ── Query 1: Linea de tiempo completa de actividad de un agente (ultimas 72 h) ───────────────────────────────────
let agent_name = "{agent-name}";      // displayName del agente
let agent_sp   = "{agent-sp-id}";     // object ID del service principal
let agent_app  = "{agent-app-id}";    // appId del agente
let ir_window  = 72h;
union
    // Interacciones con el agente (Copilot Studio y Agent Builder)
    (CopilotActivity
    | where TimeGenerated > ago(ir_window)
    | where AgentName == agent_name
    | project TimeGenerated, Source = "CopilotActivity", Event = RecordType, Detail = strcat(AppIdentity, " ", AgentId), Actor = ActorName),
    // Inicios de sesion del service principal
    (AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | project TimeGenerated, Source = "EntraSignIn", Event = strcat("SignIn-", ResultType), Detail = ResourceDisplayName, Actor = IPAddress),
    // Cambios en el directorio hechos por el service principal
    (AuditLogs
    | where TimeGenerated > ago(ir_window)
    | where tostring(InitiatedBy.app.servicePrincipalId) == agent_sp
    | project TimeGenerated, Source = "AuditLog", Event = OperationName, Detail = tostring(TargetResources[0].displayName), Actor = "SP"),
    // Llamadas a Microsoft Graph del service principal
    (MicrosoftGraphActivityLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | project TimeGenerated, Source = "GraphApi", Event = strcat(RequestMethod, " ", ResponseStatusCode), Detail = tostring(split(RequestUri, "?")[0]), Actor = IPAddress),
    // Acceso a archivos y envio de correo con la identidad de la aplicacion
    (OfficeActivity
    | where TimeGenerated > ago(ir_window)
    | where ApplicationId == agent_app or ClientAppId == agent_app
    | project TimeGenerated, Source = "OfficeActivity", Event = Operation, Detail = coalesce(SourceFileName, OfficeObjectId), Actor = UserId)
| order by TimeGenerated asc

// ── Query 2: Todos los recursos a los que accedio el agente (alcance del impacto) ─────────────────────────────────
let agent_sp  = "{agent-sp-id}";
let ir_window = 72h;
union
    (AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | where ResultType == "0"
    | summarize FirstAccess = min(TimeGenerated), LastAccess = max(TimeGenerated), CallCount = count(), UniqueIPs = make_set(IPAddress, 10)
        by Resource = ResourceDisplayName
    | extend Channel = "EntraSignIn"),
    (MicrosoftGraphActivityLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | extend Resource = extract(@"graph\.microsoft\.com/(?:v1\.0|beta)/([^/?]+)", 1, RequestUri)
    | summarize FirstAccess = min(TimeGenerated), LastAccess = max(TimeGenerated), CallCount = count(), UniqueIPs = make_set(IPAddress, 10), Methods = make_set(RequestMethod, 5)
        by Resource
    | extend Channel = "GraphApi")
| order by CallCount desc

// ── Query 3: Archivos a los que accedio el agente despues del compromiso, con su etiqueta ───────────────────────
// SensitivityLabelId es un GUID. El nombre se resuelve con los eventos de MicrosoftPurviewInformationProtection que listan la etiqueta, y no todas
// resuelven: en el workspace de validacion 339 de 6,634 accesos tenian una etiqueta sin nombre resuelto, y el resto no tenia etiqueta. Resuelve los GUID
// restantes en Purview (Information protection, Labels).
let agent_app        = "{agent-app-id}";
let agent_name       = "{agent-name}";
let compromise_time  = datetime("{YYYY-MM-DDTHH:MM:SSZ}");  // sustituir por el momento del compromiso
let labels = MicrosoftPurviewInformationProtection
    | where isnotempty(SensitivityLabelId) and isnotempty(LabelName)
    | summarize LabelName = any(LabelName) by SensitivityLabelId;
OfficeActivity
| where TimeGenerated > compromise_time
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded", "FileCopied")
| where ApplicationId == agent_app or UserId has agent_name
| join kind=leftouter labels on SensitivityLabelId
| project
    TimeGenerated,
    FileName = SourceFileName,
    SiteUrl  = Site_Url,
    Operation,
    LabelId  = SensitivityLabelId,
    LabelName
| extend Sensitivity = case(
    isnotempty(LabelName), LabelName,
    isnotempty(LabelId), "Etiqueta sin nombre resuelto",
    "Sin clasificar")
| order by TimeGenerated asc

// ── Query 4: Entidades creadas por el agente comprometido (sub-agentes, aplicaciones, service principals) ─────────
// Un agente de Entra aparece en AuditLogs como "Add service principal" y su blueprint como "Add application"; la propiedad agentType de
// TargetResources distingue las entidades de agente (notAgentic para las demas).
let agent_sp  = "{agent-sp-id}";
let ir_window = 72h;
AuditLogs
| where TimeGenerated > ago(ir_window)
| where tostring(InitiatedBy.app.servicePrincipalId) == agent_sp
| where OperationName has_any ("Add application", "Add service principal", "Create application")
| project
    TimeGenerated,
    OperationName,
    CreatedEntity = tostring(TargetResources[0].displayName),
    EntityType    = tostring(TargetResources[0].type),
    EntityId      = tostring(TargetResources[0].id),
    AgentType     = tostring(TargetResources[0].agentType)
| extend Alert = "Entidad creada por el agente comprometido: revisar y revocar"

// ── Query 5: Verificar la contencion: inicios de sesion del service principal despues del bloqueo ────────────────
// Un service principal deshabilitado falla con AADSTS7000112 ("Application is disabled"), que en el registro aparece como ResultType 7000112 (Learn,
// error AADSTS7000112). Cualquier ResultType 0 despues de la contencion significa que la identidad todavia obtiene tokens (o que sigue usando uno emitido antes).
let agent_sp         = "{agent-sp-id}";
let containment_time = datetime("{YYYY-MM-DDTHH:MM:SSZ}");  // momento de la contencion
AADServicePrincipalSignInLogs
| where TimeGenerated > containment_time
| where ServicePrincipalId == agent_sp
| project TimeGenerated, ResultType, ResultDescription, IPAddress, ResourceDisplayName
| extend Status = case(
    ResultType == "0", "Acceso exitoso despues de la contencion: revisar",
    ResultType == "7000112", "Bloqueado: la aplicacion esta deshabilitada",
    strcat("Rechazado por otro motivo (", ResultType, ")"))
| order by TimeGenerated desc

// ── Query 6: Correo enviado con la identidad del agente (alcance de la exfiltracion por correo) ───────────────────
// Los destinatarios estan en Item.Recipients del evento Send de Exchange.
let agent_app        = "{agent-app-id}";
let compromise_time  = datetime("{YYYY-MM-DDTHH:MM:SSZ}");
OfficeActivity
| where TimeGenerated > compromise_time
| where OfficeWorkload == "Exchange"
| where Operation in ("Send", "SendAs", "SendOnBehalf")
| where ClientAppId == agent_app
| extend ItemJson = parse_json(Item)
| project
    TimeGenerated,
    Mailbox    = UserId,
    Subject    = tostring(ItemJson.Subject),
    Recipients = ItemJson.Recipients,
    MessageId  = tostring(ItemJson.InternetMessageId)
| order by TimeGenerated asc
