// skill: detect-respond-playbook-agent-containment
// workspace: {workspace-name}
// Use: hunting queries during incident response and to preserve forensic evidence
// Validated on a Sentinel workspace (Oct 2026): the previous version read CopilotStudio_CL and PurviewAuditLog, which do not exist in that workspace.
// It now uses CopilotActivity (by AgentName), AADServicePrincipalSignInLogs, MicrosoftGraphActivityLogs, AuditLogs and OfficeActivity. All compile and
// ran with real values substituted in the variables; Q1 returned Graph and OfficeActivity activity for an application, and returned no rows from
// CopilotActivity or AuditLogs for that value. Replace {agent-name}, {agent-sp-id} (service principal object id) and {agent-app-id} (appId).

// ── Query 1: Full activity timeline of an agent (last 72 h) ──────────────────────────────────────────────────────
let agent_name = "{agent-name}";      // agent displayName
let agent_sp   = "{agent-sp-id}";     // service principal object ID
let agent_app  = "{agent-app-id}";    // agent appId
let ir_window  = 72h;
union
    // Interactions with the agent (Copilot Studio and Agent Builder)
    (CopilotActivity
    | where TimeGenerated > ago(ir_window)
    | where AgentName == agent_name
    | project TimeGenerated, Source = "CopilotActivity", Event = RecordType, Detail = strcat(AppIdentity, " ", AgentId), Actor = ActorName),
    // Service principal sign-ins
    (AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | project TimeGenerated, Source = "EntraSignIn", Event = strcat("SignIn-", ResultType), Detail = ResourceDisplayName, Actor = IPAddress),
    // Directory changes made by the service principal
    (AuditLogs
    | where TimeGenerated > ago(ir_window)
    | where tostring(InitiatedBy.app.servicePrincipalId) == agent_sp
    | project TimeGenerated, Source = "AuditLog", Event = OperationName, Detail = tostring(TargetResources[0].displayName), Actor = "SP"),
    // Microsoft Graph calls by the service principal
    (MicrosoftGraphActivityLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | project TimeGenerated, Source = "GraphApi", Event = strcat(RequestMethod, " ", ResponseStatusCode), Detail = tostring(split(RequestUri, "?")[0]), Actor = IPAddress),
    // File access and mail sending with the application identity
    (OfficeActivity
    | where TimeGenerated > ago(ir_window)
    | where ApplicationId == agent_app or ClientAppId == agent_app
    | project TimeGenerated, Source = "OfficeActivity", Event = Operation, Detail = coalesce(SourceFileName, OfficeObjectId), Actor = UserId)
| order by TimeGenerated asc

// ── Query 2: All resources the agent accessed (scope of impact) ───────────────────────────────────────────────────
let agent_sp  = "{agent-sp-id}";
let ir_window = 72h;
union
    (AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | where ResultType == "0"
    | summarize FirstAccess = min(TimeGenerated), LastAccess = max(TimeGenerated), CallCount = count(), UniqueIPs = make_set(IPAddress, 10)
        by Resource = ResourceDisplayName
    | extend Channel = "EntraSignIn"),
    (MicrosoftGraphActivityLogs
    | where TimeGenerated > ago(ir_window)
    | where ServicePrincipalId == agent_sp
    | extend Resource = extract(@"graph\.microsoft\.com/(?:v1\.0|beta)/([^/?]+)", 1, RequestUri)
    | summarize FirstAccess = min(TimeGenerated), LastAccess = max(TimeGenerated), CallCount = count(), UniqueIPs = make_set(IPAddress, 10), Methods = make_set(RequestMethod, 5)
        by Resource
    | extend Channel = "GraphApi")
| order by CallCount desc

// ── Query 3: Files the agent accessed after the compromise, with their label ────────────────────────────────────
// SensitivityLabelId is a GUID. The name is resolved from the MicrosoftPurviewInformationProtection events that list the label, and not all labels
// resolve: in the validation workspace 339 of 6,634 accesses had a label with no resolved name, and the rest had no label. Resolve the remaining GUIDs
// in Purview (Information protection, Labels).
let agent_app        = "{agent-app-id}";
let agent_name       = "{agent-name}";
let compromise_time  = datetime("{YYYY-MM-DDTHH:MM:SSZ}");  // replace with the time of the compromise
let labels = MicrosoftPurviewInformationProtection
    | where isnotempty(SensitivityLabelId) and isnotempty(LabelName)
    | summarize LabelName = any(LabelName) by SensitivityLabelId;
OfficeActivity
| where TimeGenerated > compromise_time
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded", "FileCopied")
| where ApplicationId == agent_app or UserId has agent_name
| join kind=leftouter labels on SensitivityLabelId
| project
    TimeGenerated,
    FileName = SourceFileName,
    SiteUrl  = Site_Url,
    Operation,
    LabelId  = SensitivityLabelId,
    LabelName
| extend Sensitivity = case(
    isnotempty(LabelName), LabelName,
    isnotempty(LabelId), "Label with no resolved name",
    "Unclassified")
| order by TimeGenerated asc

// ── Query 4: Entities created by the compromised agent (sub-agents, applications, service principals) ─────────────
// An Entra agent appears in AuditLogs as "Add service principal" and its blueprint as "Add application"; the agentType property of
// TargetResources distinguishes agent entities (notAgentic for the rest).
let agent_sp  = "{agent-sp-id}";
let ir_window = 72h;
AuditLogs
| where TimeGenerated > ago(ir_window)
| where tostring(InitiatedBy.app.servicePrincipalId) == agent_sp
| where OperationName has_any ("Add application", "Add service principal", "Create application")
| project
    TimeGenerated,
    OperationName,
    CreatedEntity = tostring(TargetResources[0].displayName),
    EntityType    = tostring(TargetResources[0].type),
    EntityId      = tostring(TargetResources[0].id),
    AgentType     = tostring(TargetResources[0].agentType)
| extend Alert = "Entity created by the compromised agent: review and revoke"

// ── Query 5: Verify containment: service principal sign-ins after the block ──────────────────────────────────────
// A disabled service principal fails with AADSTS7000112 ("Application is disabled"), which appears in the log as ResultType 7000112 (Learn,
// error AADSTS7000112). Any ResultType 0 after containment means the identity still obtains tokens (or is still using one issued before).
let agent_sp         = "{agent-sp-id}";
let containment_time = datetime("{YYYY-MM-DDTHH:MM:SSZ}");  // time of containment
AADServicePrincipalSignInLogs
| where TimeGenerated > containment_time
| where ServicePrincipalId == agent_sp
| project TimeGenerated, ResultType, ResultDescription, IPAddress, ResourceDisplayName
| extend Status = case(
    ResultType == "0", "Successful access after containment: review",
    ResultType == "7000112", "Blocked: the application is disabled",
    strcat("Rejected for another reason (", ResultType, ")"))
| order by TimeGenerated desc

// ── Query 6: Mail sent with the agent identity (scope of email exfiltration) ──────────────────────────────────────
// The recipients are in Item.Recipients of the Exchange Send event.
let agent_app        = "{agent-app-id}";
let compromise_time  = datetime("{YYYY-MM-DDTHH:MM:SSZ}");
OfficeActivity
| where TimeGenerated > compromise_time
| where OfficeWorkload == "Exchange"
| where Operation in ("Send", "SendAs", "SendOnBehalf")
| where ClientAppId == agent_app
| extend ItemJson = parse_json(Item)
| project
    TimeGenerated,
    Mailbox    = UserId,
    Subject    = tostring(ItemJson.Subject),
    Recipients = ItemJson.Recipients,
    MessageId  = tostring(ItemJson.InternetMessageId)
| order by TimeGenerated asc
