// skill: detect-alert-prompt-injection-sentinel
// workspace: {workspace-name} | connectors: Microsoft Copilot (CopilotActivity), Defender for Cloud and Defender XDR (SecurityAlert), Application Insights (AppEvents, optional)
// PREREQUISITE: verify that the tables exist and receive data before creating the analytics rule (Step 1 of SKILL.md)
// Validated on a Sentinel workspace (Oct 2026): the previous version read CopilotStudio_CL and FoundryAgents_CL, custom tables that do not
// exist in that workspace, and looked for phrases in the prompt text. Learn says the Copilot audit record does not carry the prompt or the
// response text: it carries a JailbreakDetected flag per message and an XPIADetected flag per resource. Q1 to Q3 use those signals and the
// platform alerts; they compile and ran on the workspace. Q4 ran in Advanced Hunting (0 rows) and Q5 has no data
// (AppEvents is empty in the workspace): both NOT VERIFIED.

// ── Query 1: Platform-flagged jailbreak in Copilot interactions ───────────────────────────────────────────────
// The JailbreakDetected flag travels in LLMEventData.Messages (an array, hence mv-expand). It is the same signal as KQL Library P05-Q1.
// Validated: in 90 days there are 7 messages with the key and none is true, so the rule returns no rows (checked with == false).
// Recommended rule: frequency 5 min, window 1 h, severity by AttemptCount.
let lookback = 1h;
CopilotActivity
| where TimeGenerated > ago(lookback)
| where RecordType == "CopilotInteraction"
| mv-expand Message = LLMEventData.Messages
| where tobool(Message.JailbreakDetected) == true
| summarize
    AttemptCount = count(),
    FirstAttempt = min(TimeGenerated),
    LastAttempt  = max(TimeGenerated),
    Apps         = make_set(AppIdentity, 5)
    by ActorUserId, ActorName, AgentId, AgentName
| extend Severity = case(AttemptCount >= 10, "High", AttemptCount >= 3, "Medium", "Low")
| extend AtlasTechnique = "AML.T0051"
| project-reorder Severity, LastAttempt, ActorName, AgentName, AttemptCount

// ── Query 2: Indirect injection (XPIA) flagged by the platform: which resource carried it ────────────────────────
// The XPIADetected flag travels on each resource of LLMEventData.AccessedResources, not on the message: the injection arrives in content the
// user never typed. Same signal as KQL Library P05-Q10. Validated: the key exists on the 2 resources Copilot listed in 90 days, both false.
CopilotActivity
| where TimeGenerated > ago(1h)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| where tobool(Resource.XPIADetected) == true
| project
    TimeGenerated,
    ActorName,
    ActorUserId,
    AgentName,
    AgentId,
    AppIdentity,
    ResourceUrl  = tostring(Resource.SiteUrl),
    ResourceName = tostring(Resource.Name),
    ResourceType = tostring(Resource.Type),
    RecordId,
    AtlasTechnique = "AML.T0051",
    RiskNote = "Resource flagged as an indirect injection source: review and clean the content"
| sort by TimeGenerated desc

// ── Query 3: Defender jailbreak or prompt injection alerts (agents and models) and alerts from your own rules ───
// Covers three sources in SecurityAlert: Defender for Cloud alerts on Azure OpenAI and Foundry models (AlertType
// AI.Azure_Jailbreak.ContentFiltering.BlockedAttempt and .DetectedAttempt), Defender XDR alerts on agents managed with Agent 365
// (jailbreak, XPIA, LLM reconnaissance; preview) and your own Sentinel rules. Validated: it returned rows from a rule of the workspace itself;
// there were no Defender for Cloud or Defender XDR alerts of this type.
SecurityAlert
| where TimeGenerated > ago(24h)
| where AlertType startswith "AI.Azure_Jailbreak" or AlertName has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
| summarize arg_max(TimeGenerated, *) by SystemAlertId
| project TimeGenerated, ProductName, AlertName, AlertType, AlertSeverity, Status, CompromisedEntity
| order by TimeGenerated desc

// ── Query 4: Defender real-time protection events (Advanced Hunting) ────────────────────────────────────────────
// NOT VERIFIED: run it in the Defender portal (Advanced Hunting). Learn says Defender real-time protection rules record their audit and block
// events as behaviors in BehaviorInfo, including the Prompt Shields blocks from Foundry and Agent Builder (not yet from Copilot Studio). The
// validation tenant had no behaviors of this kind and the ActionType values were not seen, so the text filter is a guess: check ActionType and
// Title in your tenant and adjust it. In the Sentinel workspace this table has a different schema (no Title or Timestamp), which is why this
// query does not run there.
BehaviorInfo
| where Timestamp > ago(24h)
| where Title has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
    or Description has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
| project Timestamp, BehaviorId, ActionType, Title, Description, Categories, ServiceSource, DetectionSource, AccountUpn, AdditionalFields
| order by Timestamp desc

// ── Query 5: Phrase heuristic on own Copilot Studio agent telemetry (low fidelity) ───────────────────────────────
// NOT VERIFIED: AppEvents (workspace-based Application Insights) is empty in the validation workspace. It only works if the agent sends
// telemetry to Application Insights with "Log conversation details" enabled (Learn: the message text arrives in customDimensions.text of the
// BotMessageReceived event). It is a heuristic: the platform already has a classifier (Prompt Shields), and phrases do not cover encodings or other languages.
let injection_patterns = dynamic([
    "ignore previous instructions", "ignore all previous", "forget your instructions",
    "disregard your", "override your instructions",
    "you are now", "act as if", "pretend you are", "pretend to be",
    "you have no restrictions", "dan mode",
    "bypass your", "jailbreak", "override your constraints", "ignore your training",
    "repeat everything above", "what are your instructions",
    "show me your system prompt", "reveal your prompt"
]);
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "BotMessageReceived"
| extend Props = parse_json(Properties)
| where tostring(Props.designMode) =~ "false"
| extend UserText = tostring(Props.text), InputLower = tolower(tostring(Props.text))
| where InputLower has_any (injection_patterns)
| project TimeGenerated, UserId, SessionId, ChannelId = tostring(Props.channelId), UserText, AppRoleName
| order by TimeGenerated desc
