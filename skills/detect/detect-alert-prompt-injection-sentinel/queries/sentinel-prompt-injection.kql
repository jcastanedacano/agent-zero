// skill: detect-alert-prompt-injection-sentinel
// workspace: {workspace-name} | conectores: Microsoft Copilot (CopilotActivity), Defender for Cloud y Defender XDR (SecurityAlert), Application Insights (AppEvents, opcional)
// PREREQUISITO: verificar que las tablas existen y reciben datos antes de crear la regla de analitica (Paso 1 del SKILL.md)
// Validado en un workspace Sentinel (oct 2026): la version anterior leia CopilotStudio_CL y FoundryAgents_CL, tablas personalizadas que no
// existen en ese workspace, y buscaba frases en el texto del prompt. Learn dice que el registro de auditoria de Copilot no trae el texto del
// prompt ni de la respuesta: trae un flag JailbreakDetected por mensaje y un flag XPIADetected por recurso. Q1 a Q3 usan esas senales y las
// alertas de la plataforma; compilan y se ejecutaron en el workspace. Q4 se ejecuto en Advanced Hunting (0 filas) y Q5 no tiene datos
// (AppEvents esta vacia en el workspace): ambas NO VERIFICADO.

// ── Query 1: Jailbreak marcado por la plataforma en interacciones de Copilot ──────────────────────────────────
// El flag JailbreakDetected viaja en LLMEventData.Messages (un arreglo, por eso mv-expand). Es la misma senal que KQL Library P05-Q1.
// Validado: en 90 dias hay 7 mensajes con la clave y ninguno en true, asi que la regla no devuelve filas (se comprobo con == false).
// Regla recomendada: frecuencia 5 min, ventana 1 h, severidad segun AttemptCount.
let lookback = 1h;
CopilotActivity
| where TimeGenerated > ago(lookback)
| where RecordType == "CopilotInteraction"
| mv-expand Message = LLMEventData.Messages
| where tobool(Message.JailbreakDetected) == true
| summarize
    AttemptCount = count(),
    FirstAttempt = min(TimeGenerated),
    LastAttempt  = max(TimeGenerated),
    Apps         = make_set(AppIdentity, 5)
    by ActorUserId, ActorName, AgentId, AgentName
| extend Severity = case(AttemptCount >= 10, "High", AttemptCount >= 3, "Medium", "Low")
| extend AtlasTechnique = "AML.T0051"
| project-reorder Severity, LastAttempt, ActorName, AgentName, AttemptCount

// ── Query 2: Inyeccion indirecta (XPIA) marcada por la plataforma: que recurso la traia ─────────────────────────
// El flag XPIADetected viaja en cada recurso de LLMEventData.AccessedResources, no en el mensaje: la inyeccion llega en contenido que el
// usuario nunca escribio. Misma senal que KQL Library P05-Q10. Validado: la clave existe en los 2 recursos que Copilot listo en 90 dias, ambos false.
CopilotActivity
| where TimeGenerated > ago(1h)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| where tobool(Resource.XPIADetected) == true
| project
    TimeGenerated,
    ActorName,
    ActorUserId,
    AgentName,
    AgentId,
    AppIdentity,
    ResourceUrl  = tostring(Resource.SiteUrl),
    ResourceName = tostring(Resource.Name),
    ResourceType = tostring(Resource.Type),
    RecordId,
    AtlasTechnique = "AML.T0051",
    RiskNote = "Recurso marcado como fuente de inyeccion indirecta: revisar y limpiar el contenido"
| sort by TimeGenerated desc

// ── Query 3: Alertas de jailbreak o inyeccion de prompt de Defender (agentes y modelos) y de tus reglas ──────────
// Cubre tres origenes en SecurityAlert: alertas de Defender for Cloud sobre modelos de Azure OpenAI y Foundry (AlertType
// AI.Azure_Jailbreak.ContentFiltering.BlockedAttempt y .DetectedAttempt), alertas de Defender XDR sobre agentes administrados con Agent 365
// (jailbreak, XPIA, reconocimiento de LLM; preview) y reglas propias de Sentinel. Validado: devolvio filas de una regla propia del workspace;
// no habia alertas de Defender for Cloud ni de Defender XDR de este tipo.
SecurityAlert
| where TimeGenerated > ago(24h)
| where AlertType startswith "AI.Azure_Jailbreak" or AlertName has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
| summarize arg_max(TimeGenerated, *) by SystemAlertId
| project TimeGenerated, ProductName, AlertName, AlertType, AlertSeverity, Status, CompromisedEntity
| order by TimeGenerated desc

// ── Query 4: Eventos de proteccion en tiempo real de Defender (Advanced Hunting) ─────────────────────────────
// NO VERIFICADO: ejecutar en el portal de Defender (Advanced Hunting). Learn dice que las reglas de proteccion en tiempo real de Defender
// registran sus eventos de auditoria y bloqueo como comportamientos en BehaviorInfo, tambien los bloqueos de Prompt Shields de Foundry y de
// Agent Builder (todavia no los de Copilot Studio). En el tenant de validacion no habia comportamientos de ese tipo y no se vieron los valores de
// ActionType, asi que el filtro por texto es una conjetura: revisa ActionType y Title en tu tenant y ajustalo. En el workspace de Sentinel esta
// tabla tiene otro esquema (sin Title ni Timestamp), por eso esta consulta no corre ahi.
BehaviorInfo
| where Timestamp > ago(24h)
| where Title has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
    or Description has_any ("jailbreak", "prompt injection", "prompt attack", "XPIA")
| project Timestamp, BehaviorId, ActionType, Title, Description, Categories, ServiceSource, DetectionSource, AccountUpn, AdditionalFields
| order by Timestamp desc

// ── Query 5: Heuristica de frases en telemetria propia de agentes de Copilot Studio (baja fidelidad) ───────────
// NO VERIFICADO: AppEvents (Application Insights basado en workspace) esta vacia en el workspace de validacion. Solo sirve si el agente envia
// telemetria a Application Insights con "Log conversation details" activo (Learn: el texto del mensaje llega en customDimensions.text del evento
// BotMessageReceived). Es una heuristica: la plataforma ya tiene un clasificador (Prompt Shields), y las frases no cubren codificaciones ni otros idiomas.
let injection_patterns = dynamic([
    "ignore previous instructions", "ignore all previous", "forget your instructions",
    "disregard your", "override your instructions",
    "you are now", "act as if", "pretend you are", "pretend to be",
    "you have no restrictions", "dan mode",
    "bypass your", "jailbreak", "override your constraints", "ignore your training",
    "repeat everything above", "what are your instructions",
    "show me your system prompt", "reveal your prompt"
]);
AppEvents
| where TimeGenerated > ago(24h)
| where Name == "BotMessageReceived"
| extend Props = parse_json(Properties)
| where tostring(Props.designMode) =~ "false"
| extend UserText = tostring(Props.text), InputLower = tolower(tostring(Props.text))
| where InputLower has_any (injection_patterns)
| project TimeGenerated, UserId, SessionId, ChannelId = tostring(Props.channelId), UserText, AppRoleName
| order by TimeGenerated desc
