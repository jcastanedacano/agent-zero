// skill: detect-anomalous-agent-behavior
// workspace: {workspace-name} | connectors: Microsoft Entra ID (ServicePrincipalSignInLogs, MicrosoftGraphActivityLogs, RiskyAgents, AgentRiskEvents), Sentinel UEBA (BehaviorAnalytics)
// Validated on a Sentinel workspace (Oct 2026): the previous version read CopilotStudio_CL (a custom table that does not exist in that workspace) for
// the volume and time-of-day queries, and looked for agents in BehaviorAnalytics by text in the name (agent, sp-, bot) and by the word "Anomalous" in
// ActivityInsights, which is not a key: ActivityInsights stores True or False indicators such as FirstTimeUserAccessedResource.
// Now the baseline comes from Entra agent identities: AADServicePrincipalSignInLogs carries the Agent column (JSON with agentType:
// agenticAppInstance, agentIdentityBlueprintPrincipal or notAgentic) and MicrosoftGraphActivityLogs carries each Graph call by ServicePrincipalId.
// Q1 to Q4 compile and ran. In the validation tenant only 2 agent identities signed in over 30 days, with almost no calls to Graph, so with the agent
// filter they return 0 rows: the logic was exercised with all service principals (Q2 returned one service at 3.03x its baseline, Q4 returned two with
// off-hours activity). Q5 and Q6 have no rows in that workspace (NOT VERIFIED).

// ── Query 1: Daily baseline of Graph calls per agent identity (14 days) ──────────────────────────────────────────
// Requires Entra diagnostics: ServicePrincipalSignInLogs and MicrosoftGraphActivityLogs sent to the workspace.
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
MicrosoftGraphActivityLogs
| where TimeGenerated between (ago(14d) .. ago(1d))
| where ServicePrincipalId in (agent_ids)
| summarize DailyCalls = count() by ServicePrincipalId, bin(TimeGenerated, 1d)
| summarize
    AvgDailyCalls = avg(DailyCalls),
    StdDev        = stdev(DailyCalls),
    MaxDaily      = max(DailyCalls),
    DataDays      = dcount(TimeGenerated)
  by ServicePrincipalId
| where DataDays >= 7   // only agents with enough history
| extend Threshold3x = AvgDailyCalls * 3

// ── Query 2: Anomalous volume: agents above 3x their baseline in the last 24 h ─────────────────────────────────
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let names = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | summarize ServicePrincipalName = any(ServicePrincipalName) by ServicePrincipalId;
let baseline = MicrosoftGraphActivityLogs
    | where TimeGenerated between (ago(14d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | summarize DailyCalls = count() by ServicePrincipalId, bin(TimeGenerated, 1d)
    | summarize AvgDailyCalls = avg(DailyCalls), DataDays = dcount(TimeGenerated) by ServicePrincipalId
    | where DataDays >= 7;
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| summarize TodayCalls = count() by ServicePrincipalId
| join kind=inner baseline on ServicePrincipalId
| join kind=leftouter names on ServicePrincipalId
| extend Ratio = round(TodayCalls / AvgDailyCalls, 2), Threshold = AvgDailyCalls * 3
| where TodayCalls > Threshold
| extend Alert = strcat("Anomalous volume of Graph calls: ", Ratio, "x over baseline (", round(AvgDailyCalls, 0), " per day)")
| project Alert, ServicePrincipalName, ServicePrincipalId, TodayCalls, AvgDailyCalls, Ratio, Threshold

// ── Query 3: Access to a resource the identity had never used ───────────────────────────────────────────────────
// A resource is the service the token is requested for (ResourceDisplayName in the service principal sign-in).
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let known_resources = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | summarize by ServicePrincipalId, ResourceDisplayName;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| where ResultType == "0"
| join kind=leftanti known_resources on ServicePrincipalId, ResourceDisplayName
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPs = make_set(IPAddress, 5)
    by ServicePrincipalId, ServicePrincipalName, ResourceDisplayName
| extend Alert = "First access to this resource with no precedent in 30 days"
| order by FirstSeen desc

// ── Query 4: Sign-ins outside the usual hours of the identity ───────────────────────────────────────────────────
// Only evaluates identities with at least 20 sign-ins in the baseline.
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let typical_hours = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(14d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | extend HourUTC = datetime_part("hour", TimeGenerated)
    | summarize TypicalHours = make_set(HourUTC, 24), BaselineSignIns = count() by ServicePrincipalId;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| extend HourUTC = datetime_part("hour", TimeGenerated)
| join kind=inner typical_hours on ServicePrincipalId
| where BaselineSignIns >= 20
| where not(set_has_element(TypicalHours, HourUTC))
| summarize OffHoursSignIns = count(), Hours = make_set(HourUTC) by ServicePrincipalId, ServicePrincipalName
| extend Alert = strcat("Activity outside the usual hours: UTC hours ", tostring(Hours))
| order by OffHoursSignIns desc

// ── Query 5: Agent risk that Entra ID Protection already calculated (platform detection) ────────────────────────
// NOT VERIFIED: AADAgentRiskEvents exists in the workspace with the columns that Learn documents, but it is empty: the validation tenant does not
// export those categories (checked in Oct 2026). Requires the Entra diagnostic AgentRiskEvents (and RiskyAgents for the agent state) and that ID
// Protection for agents is active (Entra ID P2 in preview; Learn says it will start requiring a Microsoft Agent 365 license). The detections are
// offline: unfamiliarResourceAccess, signInSpike, failedAccessAttempt, entraDirectoryReconnaissance, earlyLifeMaliciousActivity,
// suspiciousCredentialUsage, threatIntelligenceAccount and adminConfirmedAgentCompromised.
AADAgentRiskEvents
| where TimeGenerated > ago(1d)
| where RiskState == "atRisk"
| summarize arg_max(DetectedDateTime, *) by Id
| project DetectedDateTime, AgentId, AgentDisplayName, IdentityType, RiskEventType, RiskLevel, RiskState, DetectionTimingType, RiskEvidence
| order by DetectedDateTime desc

// ── Query 6: UEBA anomalies on service principal sign-ins ───────────────────────────────────────────────────────
// NOT VERIFIED: Learn lists AADServicePrincipalSignInLogs and AADManagedIdentitySignInLogs as UEBA sources (preview), but BehaviorAnalytics in the
// validation workspace has no rows with that NativeTableName (it compiles and returns 0). InvestigationPriority ranges from 0 to 10. ActivityInsights
// stores True or False indicators (for example FirstTimeUserAccessedResource), not text.
BehaviorAnalytics
| where TimeGenerated > ago(1d)
| where NativeTableName == "AADServicePrincipalSignInLogs"
| where InvestigationPriority >= 5
| project TimeGenerated, ServicePrincipal = UserPrincipalName, ActivityType, ActionType, InvestigationPriority, ActivityInsights, SourceIPAddress
| order by InvestigationPriority desc
