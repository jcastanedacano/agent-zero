// skill: detect-anomalous-agent-behavior
// workspace: {workspace-name} | conectores: Microsoft Entra ID (ServicePrincipalSignInLogs, MicrosoftGraphActivityLogs, RiskyAgents, AgentRiskEvents), Sentinel UEBA (BehaviorAnalytics)
// Validado en un workspace Sentinel (oct 2026): la version anterior leia CopilotStudio_CL (tabla personalizada que no existe en ese workspace)
// para las consultas de volumen y horario, y buscaba agentes en BehaviorAnalytics por texto en el nombre (agent, sp-, bot) y por la palabra
// "Anomalous" en ActivityInsights, que no es una clave: ActivityInsights guarda indicadores True o False como FirstTimeUserAccessedResource.
// Ahora la linea base sale de las identidades de agente de Entra: AADServicePrincipalSignInLogs trae la columna Agent (JSON con agentType:
// agenticAppInstance, agentIdentityBlueprintPrincipal o notAgentic) y MicrosoftGraphActivityLogs trae cada llamada a Graph por ServicePrincipalId.
// Q1 a Q4 compilan y se ejecutaron. En el tenant de validacion solo 2 identidades de agente iniciaron sesion en 30 dias y casi sin llamadas a
// Graph, asi que con el filtro de agentes devuelven 0 filas: la logica se ejercito con todos los service principals (Q2 devolvio un servicio a
// 3.03x de su linea base, Q4 dos con actividad fuera de horario). Q5 y Q6 no tienen filas en ese workspace (NO VERIFICADO).

// ── Query 1: Linea base diaria de llamadas a Graph por identidad de agente (14 dias) ─────────────────────────────
// Requiere diagnosticos de Entra: ServicePrincipalSignInLogs y MicrosoftGraphActivityLogs hacia el workspace.
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
MicrosoftGraphActivityLogs
| where TimeGenerated between (ago(14d) .. ago(1d))
| where ServicePrincipalId in (agent_ids)
| summarize DailyCalls = count() by ServicePrincipalId, bin(TimeGenerated, 1d)
| summarize
    AvgDailyCalls = avg(DailyCalls),
    StdDev        = stdev(DailyCalls),
    MaxDaily      = max(DailyCalls),
    DataDays      = dcount(TimeGenerated)
  by ServicePrincipalId
| where DataDays >= 7   // solo agentes con historial suficiente
| extend Threshold3x = AvgDailyCalls * 3

// ── Query 2: Volumen anomalo: agentes por encima de 3x su linea base en las ultimas 24 h ───────────────────────
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let names = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | summarize ServicePrincipalName = any(ServicePrincipalName) by ServicePrincipalId;
let baseline = MicrosoftGraphActivityLogs
    | where TimeGenerated between (ago(14d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | summarize DailyCalls = count() by ServicePrincipalId, bin(TimeGenerated, 1d)
    | summarize AvgDailyCalls = avg(DailyCalls), DataDays = dcount(TimeGenerated) by ServicePrincipalId
    | where DataDays >= 7;
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| summarize TodayCalls = count() by ServicePrincipalId
| join kind=inner baseline on ServicePrincipalId
| join kind=leftouter names on ServicePrincipalId
| extend Ratio = round(TodayCalls / AvgDailyCalls, 2), Threshold = AvgDailyCalls * 3
| where TodayCalls > Threshold
| extend Alert = strcat("Volumen anomalo de llamadas a Graph: ", Ratio, "x sobre la linea base (", round(AvgDailyCalls, 0), " por dia)")
| project Alert, ServicePrincipalName, ServicePrincipalId, TodayCalls, AvgDailyCalls, Ratio, Threshold

// ── Query 3: Acceso a un recurso que la identidad nunca habia usado ─────────────────────────────────────────────
// Un recurso es el servicio al que se pide el token (ResourceDisplayName en el inicio de sesion del service principal).
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let known_resources = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | summarize by ServicePrincipalId, ResourceDisplayName;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| where ResultType == "0"
| join kind=leftanti known_resources on ServicePrincipalId, ResourceDisplayName
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPs = make_set(IPAddress, 5)
    by ServicePrincipalId, ServicePrincipalName, ResourceDisplayName
| extend Alert = "Primer acceso a este recurso sin precedente en 30 dias"
| order by FirstSeen desc

// ── Query 4: Inicios de sesion fuera del horario habitual de la identidad ───────────────────────────────────────
// Solo evalua identidades con al menos 20 inicios de sesion en la linea base.
let agent_ids = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(30d)
    | extend AgentType = tostring(parse_json(Agent).agentType)
    | where isnotempty(AgentType) and AgentType != "notAgentic"
    | distinct ServicePrincipalId;
let typical_hours = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(14d) .. ago(1d))
    | where ServicePrincipalId in (agent_ids)
    | extend HourUTC = datetime_part("hour", TimeGenerated)
    | summarize TypicalHours = make_set(HourUTC, 24), BaselineSignIns = count() by ServicePrincipalId;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1d)
| where ServicePrincipalId in (agent_ids)
| extend HourUTC = datetime_part("hour", TimeGenerated)
| join kind=inner typical_hours on ServicePrincipalId
| where BaselineSignIns >= 20
| where not(set_has_element(TypicalHours, HourUTC))
| summarize OffHoursSignIns = count(), Hours = make_set(HourUTC) by ServicePrincipalId, ServicePrincipalName
| extend Alert = strcat("Actividad fuera del horario habitual: horas UTC ", tostring(Hours))
| order by OffHoursSignIns desc

// ── Query 5: Riesgo de agentes que Entra ID Protection ya calculo (deteccion de la plataforma) ──────────────────
// NO VERIFICADO: AADAgentRiskEvents existe en el workspace con las columnas que documenta Learn, pero esta vacia: el tenant de validacion no exporta esas categorias (se comprobo en oct 2026). Requiere el diagnostico de Entra
// AgentRiskEvents (y RiskyAgents para el estado del agente) y que ID Protection para agentes este activa (Entra ID P2 en preview; Learn dice
// que pasara a requerir una licencia de Microsoft Agent 365). Las detecciones son offline: unfamiliarResourceAccess, signInSpike, failedAccessAttempt,
// entraDirectoryReconnaissance, earlyLifeMaliciousActivity, suspiciousCredentialUsage, threatIntelligenceAccount y adminConfirmedAgentCompromised.
AADAgentRiskEvents
| where TimeGenerated > ago(1d)
| where RiskState == "atRisk"
| summarize arg_max(DetectedDateTime, *) by Id
| project DetectedDateTime, AgentId, AgentDisplayName, IdentityType, RiskEventType, RiskLevel, RiskState, DetectionTimingType, RiskEvidence
| order by DetectedDateTime desc

// ── Query 6: Anomalias de UEBA sobre inicios de sesion de service principals ────────────────────────────────────
// NO VERIFICADO: Learn lista AADServicePrincipalSignInLogs y AADManagedIdentitySignInLogs como fuentes de UEBA (preview), pero BehaviorAnalytics
// en el workspace de validacion no tiene filas con ese NativeTableName (compila y devuelve 0). InvestigationPriority va de 0 a 10. ActivityInsights
// guarda indicadores True o False (por ejemplo FirstTimeUserAccessedResource), no texto.
BehaviorAnalytics
| where TimeGenerated > ago(1d)
| where NativeTableName == "AADServicePrincipalSignInLogs"
| where InvestigationPriority >= 5
| project TimeGenerated, ServicePrincipal = UserPrincipalName, ActivityType, ActionType, InvestigationPriority, ActivityInsights, SourceIPAddress
| order by InvestigationPriority desc
