// skill: discover-enumerate-foundry-agents
// workspace: {workspace-name} | connectors: Foundry account diagnostics (AzureDiagnostics); Q4 runs in Advanced Hunting (AgentsInfo)
// Validated on a Sentinel workspace (Oct 2026): the previous version read FoundryAgents_CL, a custom table from a connector that does not exist in
// that workspace. What does exist is the Foundry account diagnostics (RequestResponse and Audit categories of MICROSOFT.COGNITIVESERVICES in
// AzureDiagnostics): operation, caller IP, status and sizes, with no content, no tokens and no agent name. That is why Q1 to Q3 look at the account,
// not the agent. Q1 to Q3 compile and ran (598 records in 30 days from one account; Q3 returned no rows). Q4 ran in Advanced Hunting and returned the
// 6 Foundry agents of the tenant.

// ── Query 1: Activity per Foundry account (30 days) ─────────────────────────────────────────────────────────────
let lookback = 30d;
AzureDiagnostics
| where TimeGenerated > ago(lookback)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize
    Requests           = count(),
    DistinctOperations = dcount(OperationName),
    Callers            = dcount(CallerIPAddress),
    LastActivity       = max(TimeGenerated),
    Operations         = make_set(OperationName, 8)
  by Resource
| extend DaysSinceActivity = datetime_diff("day", now(), LastActivity)
| order by Requests desc

// ── Query 2: Calls without an Entra identifier in the record (key authentication hint) ────────────────────────────────
// HEURISTIC: the RequestResponse record carries callerObjectId inside properties_s. On the validation account 100% of the 598 records have it empty,
// and the account has key authentication enabled (disableLocalAuth false). An empty field does not prove key use: the control that decides it is
// disableLocalAuth on the account (step 2 of the skill).
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| extend Props = parse_json(properties_s)
| extend CallerObjectId = tostring(Props.callerObjectId)
| summarize
    Total              = count(),
    WithoutEntraCaller = countif(isempty(CallerObjectId)),
    IPs                = make_set(CallerIPAddress, 5)
  by Resource
| extend ShareWithoutCaller = round(100.0 * WithoutEntraCaller / Total, 1)
| order by Total desc

// ── Query 3: Unusual call volume to the account (anomaly over 14 days) ──────────────────────────────────────────────
let baseline_window = 14d;
let alert_window    = 1d;
let baseline = AzureDiagnostics
    | where TimeGenerated between (ago(baseline_window) .. ago(alert_window))
    | where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
    | summarize DailyRequests = count() by Resource, bin(TimeGenerated, 1d)
    | summarize AvgDailyRequests = avg(DailyRequests), DataDays = dcount(TimeGenerated) by Resource
    | where DataDays >= 7;
AzureDiagnostics
| where TimeGenerated > ago(alert_window)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize TodayRequests = count() by Resource
| join kind=inner baseline on Resource
| extend Ratio = round(TodayRequests / AvgDailyRequests, 2)
| where Ratio > 3   // more than triple the daily average
| extend Alert = strcat("Anomalous volume: ", Ratio, "x over baseline")
| project Alert, Resource, TodayRequests, AvgDailyRequests, Ratio
| order by Ratio desc

// ── Query 4: Foundry agents in the Defender inventory with their owner and identity (Advanced Hunting) ───────────────────
// AgentsInfo carries Platform, EntraAgentID, EntraBlueprintID, Owners, PublishedStatus and LifecycleStatus. An owner with a null GUID (00000000-...)
// is not a real owner: here it counts as "No owner".
AgentsInfo
| where Timestamp > ago(30d)
| summarize arg_max(Timestamp, *) by AgentId
| where Platform == "Microsoft Foundry" and LifecycleStatus != "Deleted"
| extend RealOwners = array_length(set_difference(parse_json(Owners), dynamic(["00000000-0000-0000-0000-000000000000"])))
| project Name, AgentId, PublishedStatus, LifecycleStatus, EntraAgentID, EntraBlueprintID, RealOwners, ToolsAuthenticationType, CreatedDateTime, LastUpdatedDateTime
| extend Gap = case(RealOwners == 0, "No owner", isempty(EntraAgentID), "No Entra Agent ID identity", "Has owner and identity")
| order by Gap asc, LastUpdatedDateTime desc
