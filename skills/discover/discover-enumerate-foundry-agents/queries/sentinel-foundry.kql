// skill: discover-enumerate-foundry-agents
// workspace: {workspace-name} | conectores: diagnosticos de la cuenta Foundry (AzureDiagnostics); Q4 corre en Advanced Hunting (AgentsInfo)
// Validado en un workspace Sentinel (oct 2026): la version anterior leia FoundryAgents_CL, una tabla personalizada de un conector que no existe en ese
// workspace. Lo que si existe es el diagnostico de la cuenta Foundry (categorias RequestResponse y Audit de MICROSOFT.COGNITIVESERVICES en AzureDiagnostics):
// operacion, IP del llamador, estado y tamanos, sin contenido, sin tokens y sin nombre de agente. Por eso Q1 a Q3 miran la cuenta, no el agente. Q1 a Q3
// compilan y se ejecutaron (598 registros en 30 dias de una cuenta; Q3 sin filas). Q4 se ejecuto en Advanced Hunting y devolvio los 6 agentes de Foundry del tenant.

// ── Query 1: Actividad por cuenta Foundry (30 dias) ─────────────────────────────────────────────────────────────
let lookback = 30d;
AzureDiagnostics
| where TimeGenerated > ago(lookback)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize
    Requests           = count(),
    DistinctOperations = dcount(OperationName),
    Callers            = dcount(CallerIPAddress),
    LastActivity       = max(TimeGenerated),
    Operations         = make_set(OperationName, 8)
  by Resource
| extend DaysSinceActivity = datetime_diff("day", now(), LastActivity)
| order by Requests desc

// ── Query 2: Llamadas sin identificador de Entra en el registro (pista de autenticacion por clave) ────────────────────
// HEURISTICA: el registro RequestResponse trae callerObjectId dentro de properties_s. En la cuenta de validacion el 100% de los 598 registros lo trae vacio, y la
// cuenta tiene la autenticacion por clave activa (disableLocalAuth false). Que el campo este vacio no prueba el uso de claves: el control que lo decide es
// disableLocalAuth en la cuenta (paso 2 del skill).
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| extend Props = parse_json(properties_s)
| extend CallerObjectId = tostring(Props.callerObjectId)
| summarize
    Total              = count(),
    WithoutEntraCaller = countif(isempty(CallerObjectId)),
    IPs                = make_set(CallerIPAddress, 5)
  by Resource
| extend ShareWithoutCaller = round(100.0 * WithoutEntraCaller / Total, 1)
| order by Total desc

// ── Query 3: Volumen inusual de llamadas a la cuenta (anomalia sobre 14 dias) ───────────────────────────────────────
let baseline_window = 14d;
let alert_window    = 1d;
let baseline = AzureDiagnostics
    | where TimeGenerated between (ago(baseline_window) .. ago(alert_window))
    | where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
    | summarize DailyRequests = count() by Resource, bin(TimeGenerated, 1d)
    | summarize AvgDailyRequests = avg(DailyRequests), DataDays = dcount(TimeGenerated) by Resource
    | where DataDays >= 7;
AzureDiagnostics
| where TimeGenerated > ago(alert_window)
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize TodayRequests = count() by Resource
| join kind=inner baseline on Resource
| extend Ratio = round(TodayRequests / AvgDailyRequests, 2)
| where Ratio > 3   // mas del triple del promedio diario
| extend Alert = strcat("Volumen anomalo: ", Ratio, "x sobre la linea base")
| project Alert, Resource, TodayRequests, AvgDailyRequests, Ratio
| order by Ratio desc

// ── Query 4: Agentes de Foundry del inventario de Defender y su propietario e identidad (Advanced Hunting) ───────────────
// AgentsInfo trae Platform, EntraAgentID, EntraBlueprintID, Owners, PublishedStatus y LifecycleStatus. Un propietario con GUID nulo (00000000-...) no es un
// propietario real: aqui se cuenta como "Sin propietario".
AgentsInfo
| where Timestamp > ago(30d)
| summarize arg_max(Timestamp, *) by AgentId
| where Platform == "Microsoft Foundry" and LifecycleStatus != "Deleted"
| extend RealOwners = array_length(set_difference(parse_json(Owners), dynamic(["00000000-0000-0000-0000-000000000000"])))
| project Name, AgentId, PublishedStatus, LifecycleStatus, EntraAgentID, EntraBlueprintID, RealOwners, ToolsAuthenticationType, CreatedDateTime, LastUpdatedDateTime
| extend Gap = case(RealOwners == 0, "Sin propietario", isempty(EntraAgentID), "Sin identidad Entra Agent ID", "Con propietario e identidad")
| order by Gap asc, LastUpdatedDateTime desc
