// skill: discover-inventory-agents-copilot-studio
// workspace: {workspace-name} | tenant: {tenant-domain}
// connectors: Microsoft Power Platform Admin Activity (PowerPlatformAdminActivity), Microsoft Copilot (CopilotActivity)
// Validated on a Sentinel workspace (Oct 2026): the previous version read CopilotStudio_CL, a custom table that
// does not exist in that workspace (Q1 and Q3 could not run), and used the export of the Requests tab as the list of
// "approved" agents, but Requests only shows what is awaiting approval. The queries now read documented tables.
// All three compile and ran on the workspace; Q1 and Q2 returned no rows (the Power Platform tables are
// empty and no interaction carries AgentId or AgentName), Q3 was tested with a sample table.

// ── Query 1: Copilot Studio agents created, published or shared in 30 days ────────────────────────────────────
// NOT VERIFIED: PowerPlatformAdminActivity exists with the columns that Learn documents, but it has no rows. The
// operation names are the ones from Learn ("Audit Copilot Studio activities in Microsoft Purview"); the keys inside
// Properties were not seen in real events. Same query as KQL Library P02-Q2.
PowerPlatformAdminActivity
| where TimeGenerated > ago(30d)
| where EventOriginalType in (
    "BotCreate",
    "BotUpdateOperation-BotPublish",
    "BotUpdateOperation-BotShare")
| where EventResult == "Succeeded"
| project
    TimeGenerated,
    EventOriginalType,
    ActorName,
    ActorUserType,
    EnvironmentId,
    Properties
| order by TimeGenerated desc

// ── Query 2: Agents that people actually use (Copilot audit record) ─────────────────────────────────────────────
// Covers the Copilot Studio and Agent Builder agents that receive interactions: AgentName and AgentId are documented
// columns of CopilotActivity (for example AgentId CopilotStudio.Declarative.<guid>). NOT VERIFIED: in the
// validation workspace no interaction carries AgentName or AgentId, so a real agent was not seen.
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentId) or isnotempty(AgentName)
| summarize
    Interactions = count(),
    Users        = dcount(ActorUserId),
    FirstSeen    = min(TimeGenerated),
    LastSeen     = max(TimeGenerated),
    Apps         = make_set(AppIdentity, 5)
    by AgentId, AgentName
| order by Interactions desc

// ── Query 3: Review priority: agents shared by their creator that are in use ─────────────────────────────────────
// Paste into SharedByCreator the names exported from Microsoft 365 admin center → Agents → All agents → Registry
// (filter "Shared by creator"). It returns which of them are in use and how much, so the most used are reviewed first.
// Tested with a sample table: it only returns the agents that are in the list and have interactions.
let SharedByCreator = datatable(AgentName: string) [
    // populate from the Registry export (Shared by creator)
    "__placeholder__"
];
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentName)
| summarize
    Interactions = count(),
    Users        = dcount(ActorUserId),
    LastSeen     = max(TimeGenerated)
    by AgentId, AgentName
| join kind=inner SharedByCreator on AgentName
| project AgentName, AgentId, Interactions, Users, LastSeen
| extend Classification = "Shared by its creator and in use: review owner, data and connectors"
| order by Interactions desc
