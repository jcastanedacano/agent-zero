// skill: discover-inventory-agents-copilot-studio
// workspace: {workspace-name} | tenant: {tenant-domain}
// conectores: Microsoft Power Platform Admin Activity (PowerPlatformAdminActivity), Microsoft Copilot (CopilotActivity)
// Validado en un workspace Sentinel (oct 2026): la version anterior leia CopilotStudio_CL, una tabla personalizada que
// no existe en ese workspace (Q1 y Q3 no podian ejecutarse), y usaba el export de la pestana Requests como lista de
// agentes "aprobados", pero Requests solo muestra lo que espera aprobacion. Las consultas ahora leen tablas documentadas.
// Las tres compilan y se ejecutaron en el workspace; Q1 y Q2 no devolvieron filas (las tablas de Power Platform estan
// vacias y ninguna interaccion trae AgentId o AgentName), Q3 se probo con una tabla de ejemplo.

// ── Query 1: Agentes de Copilot Studio creados, publicados o compartidos en 30 dias ───────────────────────────
// NO VERIFICADO: PowerPlatformAdminActivity existe con las columnas que documenta Learn, pero no tiene filas. Los
// nombres de operacion son los de Learn ("Audit Copilot Studio activities in Microsoft Purview"); las claves dentro de
// Properties no se vieron en eventos reales. Misma consulta que KQL Library P02-Q2.
PowerPlatformAdminActivity
| where TimeGenerated > ago(30d)
| where EventOriginalType in (
    "BotCreate",
    "BotUpdateOperation-BotPublish",
    "BotUpdateOperation-BotShare")
| where EventResult == "Succeeded"
| project
    TimeGenerated,
    EventOriginalType,
    ActorName,
    ActorUserType,
    EnvironmentId,
    Properties
| order by TimeGenerated desc

// ── Query 2: Agentes que la gente usa de verdad (registro de auditoria de Copilot) ──────────────────────────────
// Cubre los agentes de Copilot Studio y de Agent Builder que reciben interacciones: AgentName y AgentId son columnas
// documentadas de CopilotActivity (por ejemplo AgentId CopilotStudio.Declarative.<guid>). NO VERIFICADO: en el
// workspace de validacion ninguna interaccion trae AgentName ni AgentId, asi que no se vio un agente real.
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentId) or isnotempty(AgentName)
| summarize
    Interactions = count(),
    Users        = dcount(ActorUserId),
    FirstSeen    = min(TimeGenerated),
    LastSeen     = max(TimeGenerated),
    Apps         = make_set(AppIdentity, 5)
    by AgentId, AgentName
| order by Interactions desc

// ── Query 3: Prioridad de revision, agentes compartidos por su creador que estan en uso ──────────────────────────
// Pegar en SharedByCreator los nombres exportados de Microsoft 365 admin center → Agents → All agents → Registry
// (filtro "Shared by creator"). Devuelve cuales de ellos se usan y cuanto, para revisar primero los mas usados.
// Probada con una tabla de ejemplo: solo devuelve los agentes que estan en la lista y tienen interacciones.
let SharedByCreator = datatable(AgentName: string) [
    // poblar desde el export del Registry (Shared by creator)
    "__placeholder__"
];
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentName)
| summarize
    Interactions = count(),
    Users        = dcount(ActorUserId),
    LastSeen     = max(TimeGenerated)
    by AgentId, AgentName
| join kind=inner SharedByCreator on AgentName
| project AgentName, AgentId, Interactions, Users, LastSeen
| extend Classification = "Compartido por su creador y en uso: revisar propietario, datos y conectores"
| order by Interactions desc
