// skill: discover-shadow-ai-entra-principals
// workspace: {workspace-name} | connectors: Microsoft Entra ID (AuditLogs, AADServicePrincipalSignInLogs)
// Validated on a Sentinel workspace (Oct 2026). The previous version read the AppId in modifiedProperties[0] (the position changes: "Add application"
// carries 14 different properties and "Add service principal" 11), looked for the permissions in AdditionalDetails, which does not carry them
// (delegated scopes are in DelegatedPermissionGrant.Scope and application roles in AppRole.Value), and the "Inactive" status of Q3 could not occur
// because the window and the threshold were both 30 days. Q1 to Q3 compile and ran; the validation account result is next to each query.

// ── Query 1: Recently created applications and service principals ─────────────────────────────────────────────────
// The AppId is in the AppId property (Add application) or AppPrincipalId (Add service principal). Managed identities are excluded through the
// ManagedIdentityResourceId property.
// Result on the validation account (90 days): 70 objects without managed identities (5 applications and 8 service principals created by people, 12
// and 45 created by an application), all with an AppId.
let lookback = 30d;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName in ("Add service principal", "Add application")
| where Result == "success"
| extend Target = TargetResources[0]
| mv-apply MP = Target.modifiedProperties on (
    summarize
        AppId = take_anyif(trim('"', tostring(MP.newValue)), tostring(MP.displayName) in ("AppId", "AppPrincipalId")),
        IsManagedIdentity = max(iff(tostring(MP.displayName) == "ManagedIdentityResourceId", 1, 0)))
| where IsManagedIdentity == 0
| extend
    ObjectName = tostring(Target.displayName),
    ObjectType = tostring(Target.type),
    CreatedBy  = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorType  = iff(isnotempty(tostring(InitiatedBy.user.userPrincipalName)), "person", "application")
| project TimeGenerated, OperationName, ObjectName, ObjectType, AppId, CreatedBy, ActorType
| order by TimeGenerated desc

// ── Query 2: Permissions granted with sensitive access (delegated and application) ─────────────────────────────────
// Delegated: "Add delegated permission grant" carries the scopes in DelegatedPermissionGrant.Scope. Application: "Add app role assignment to service
// principal" carries the role in AppRole.Value and the principal that receives it in ServicePrincipal.DisplayName. An administrator grant also leaves
// "Consent to application"; it is not counted here to avoid duplicates.
// Result on the validation account (90 days): 31 grants (24 delegated and 7 application), 13 with sensitive access (delegated: 9 High and 1 Medium;
// application: 1 High and 2 Medium), all in the last 30 days.
let sensitive_permissions = dynamic([
    "Mail.ReadWrite", "Mail.Send", "Mail.Read",
    "Files.ReadWrite.All", "Files.Read.All", "Sites.ReadWrite.All",
    "Directory.ReadWrite.All", "Directory.Read.All",
    "Calendars.ReadWrite", "Contacts.ReadWrite",
    "User.ReadWrite.All", "Group.ReadWrite.All", "Policy.ReadWrite"
]);
let delegated = AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add delegated permission grant" and Result == "success"
    | extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)), AppName = tostring(TargetResources[0].displayName)
    | mv-expand TR = TargetResources
    | mv-expand MP = TR.modifiedProperties
    | summarize Permission = take_anyif(trim('" ', tostring(MP.newValue)), tostring(MP.displayName) == "DelegatedPermissionGrant.Scope") by Id, TimeGenerated, Actor, AppName
    | extend Kind = "delegated";
let app_roles = AuditLogs
    | where TimeGenerated > ago(lookback)
    | where OperationName == "Add app role assignment to service principal" and Result == "success"
    | extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | mv-expand TR = TargetResources
    | mv-expand MP = TR.modifiedProperties
    | summarize
        Permission = take_anyif(trim('" ', tostring(MP.newValue)), tostring(MP.displayName) == "AppRole.Value"),
        AppName    = take_anyif(trim('" ', tostring(MP.newValue)), tostring(MP.displayName) == "ServicePrincipal.DisplayName")
      by Id, TimeGenerated, Actor
    | extend Kind = "application";
union delegated, app_roles
| where Permission has_any (sensitive_permissions)
| extend RiskLevel = case(
    Permission has "ReadWrite.All", "High",
    Permission has "Mail.Send",     "High",
    "Medium"
)
| project TimeGenerated, Kind, AppName, Permission, Actor, RiskLevel
| order by RiskLevel asc, TimeGenerated desc

// ── Query 3: Service principals with recent sign-in, and those that stopped being used ────────────────────────────
// The window (90 days) is longer than the inactivity threshold (30 days); otherwise the Inactive status cannot occur. A principal that never signed
// in does not appear here: use the Graph sign-in activity report (Step 4 of the skill). Result on the validation account: 10 service principals, 5
// normally active, 4 with more than 5 source IPs and 1 inactive.
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(90d)
| summarize
    LastSignIn  = max(TimeGenerated),
    SignInCount = count(),
    UniqueIPs   = dcount(IPAddress),
    Resources   = make_set(ResourceDisplayName, 10)
  by ServicePrincipalName, ServicePrincipalId
| extend DaysSinceLastSignIn = datetime_diff("day", now(), LastSignIn)
| extend Status = case(
    DaysSinceLastSignIn > 30, "Inactive: decommission candidate",
    UniqueIPs > 5,            "Active: several source IPs",
    "Active: normal"
)
| order by DaysSinceLastSignIn desc
