// skill: govern-dlp-policy-copilot-prompts
// workspace: {workspace-name} | connectors: Microsoft 365 (OfficeActivity), Defender XDR or Purview (SecurityAlert), Microsoft Copilot (CopilotActivity)
// Validated on a Sentinel workspace (Oct 2026): the previous version read MicrosoftDataLossPrevention, a table that does not exist in that workspace, and expected Workload
// "CopilotExperiences". The DLP matches for Exchange, SharePoint and OneDrive are in OfficeActivity (operation DLPRuleMatch or DlpRuleMatch), and the Purview
// DLP alerts arrive in SecurityAlert (ProductName "Microsoft Data Loss Prevention", the policy is inside AlertName). The DLP matches during
// Copilot interactions are in the DSPM for AI activity explorer, not in a Sentinel table: the Copilot audit record only shows the
// resources restricted by a policy in AccessedResources.PolicyDetails (Q4). Q1 to Q3 compile and returned rows; Q4 compiles and has no rows (NOT VERIFIED).

// ── Query 1: DLP rule matches by workload (30 days) ──────────────────────────────────────────
OfficeActivity
| where TimeGenerated > ago(30d)
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| summarize Matches = count(), Users = dcount(UserId), LastMatch = max(TimeGenerated) by Workload = OfficeWorkload, RecordType
| order by Matches desc

// ── Query 2: Users with the most DLP matches (possible exfiltration) ───────────────────────────────────────────
OfficeActivity
| where TimeGenerated > ago(30d)
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| summarize
    ViolationCount = count(),
    Workloads      = make_set(OfficeWorkload),
    LastViolation  = max(TimeGenerated)
  by User = tolower(UserId)
| where ViolationCount >= 3
| extend RiskLevel = case(
    ViolationCount >= 10, "High",
    ViolationCount >= 5,  "Medium",
    "Low")
| order by ViolationCount desc

// ── Query 3: Purview DLP alerts by policy ──────────────────────────────────────────────────────────────
// The policy name is inside AlertName: "DLP policy (<policy>) matched for ...".
SecurityAlert
| where TimeGenerated > ago(30d)
| where ProductName == "Microsoft Data Loss Prevention"
| summarize arg_max(TimeGenerated, *) by SystemAlertId
| extend PolicyName = extract(@"DLP policy \((.+?)\) matched", 1, AlertName)
| summarize Alerts = count(), LastAlert = max(TimeGenerated) by PolicyName, AlertSeverity
| order by Alerts desc

// ── Query 4: Resources Copilot could not use because of a policy (DLP for Copilot) ──────────────────────────────────
// NOT VERIFIED: Learn says AccessedResources[].PolicyDetails is used when Copilot's access to a resource was blocked or restricted by a policy, and
// Status distinguishes success and failure. In the validation workspace the PolicyDetails key exists and is empty on the 2 resources listed in 90 days.
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| extend PolicyDetails = tostring(Resource.PolicyDetails), ResourceStatus = tostring(Resource.Status)
| where isnotempty(PolicyDetails) or ResourceStatus =~ "failure"
| project
    TimeGenerated,
    ActorName,
    AgentName,
    AppIdentity,
    ResourceUrl = tostring(Resource.SiteUrl),
    LabelId     = tostring(Resource.SensitivityLabelId),
    ResourceStatus,
    PolicyDetails
| order by TimeGenerated desc
