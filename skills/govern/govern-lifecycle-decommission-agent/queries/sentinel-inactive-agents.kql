// skill: govern-lifecycle-decommission-agent
// workspace: {workspace-name} | Q2 y Q5 corren en Advanced Hunting (AgentsInfo, IdentityInfo)
// Validado en un workspace Sentinel y en Advanced Hunting (oct 2026): la version anterior leia CopilotStudio_CL y FoundryAgents_CL, tablas personalizadas que no
// existen en el workspace de validacion, y buscaba service principals de agentes por texto en AuditLogs. Ahora: Q1 usa CopilotActivity (por AgentId), Q3 el
// diagnostico de la cuenta Foundry, Q4 la columna Agent de AADServicePrincipalSignInLogs, y Q2 y Q5 el inventario AgentsInfo y IdentityInfo. Todas compilan y se
// ejecutaron; Q1 y Q3 no devolvieron filas (ningun agente ni cuenta inactivos en el tenant de validacion), Q4 y Q5 se ejercitaron con filas.
// Ninguna consulta mide "uso" de un agente que nunca aparece en una tabla de actividad: cruza siempre con el inventario.

// ── Query 1: Agentes con interacciones registradas que llevan 30 dias sin actividad (Copilot Studio y Agent Builder) ───────
// CopilotActivity solo conoce a los agentes que tuvieron al menos una interaccion dentro de la retencion del workspace.
let inactive_days = 30;
CopilotActivity
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentId)
| summarize LastInteraction = max(TimeGenerated), Interactions = count() by AgentId, AgentName
| extend DaysInactive = datetime_diff("day", now(), LastInteraction)
| where DaysInactive > inactive_days
| order by DaysInactive desc

// ── Query 2: Agentes activos sin cambios en 90 dias (Advanced Hunting) ───────────────────────────────────────────
// LastUpdatedDateTime es el ultimo cambio de configuracion, no el ultimo uso: sirve como candidatos a revisar, no como prueba de inactividad. Se limita a las
// plataformas que administras: en el tenant de validacion la mayoria del inventario es el catalogo de agentes de Microsoft y de partners (Platform "Other").
AgentsInfo
| where Timestamp > ago(30d)
| summarize arg_max(Timestamp, *) by AgentId
| where Platform in ("Copilot Studio", "Microsoft Foundry")
| where LifecycleStatus == "Active"
| where LastUpdatedDateTime < ago(90d)
| project Name, Platform, AgentId, PublishedStatus, LastUpdatedDateTime, LastPublishedDateTime, OwnerCount = array_length(parse_json(Owners))
| order by LastUpdatedDateTime asc

// ── Query 3: Cuentas Foundry sin llamadas en 30 dias ───────────────────────────────────────────────────────────
// El diagnostico no trae nombre de agente: la inactividad es de la cuenta Foundry, no de un agente.
AzureDiagnostics
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize LastCall = max(TimeGenerated), Requests = count() by Resource
| extend DaysInactive = datetime_diff("day", now(), LastCall)
| where DaysInactive > 30
| order by DaysInactive desc

// ── Query 4: Identidades de agente de Entra sin inicio de sesion en 30 dias ─────────────────────────────────────────
// La columna Agent de AADServicePrincipalSignInLogs es un JSON con agentType (agenticAppInstance, agentIdentityBlueprintPrincipal o notAgentic).
// Solo ve identidades que iniciaron sesion dentro de la retencion: una identidad que nunca inicio sesion no aparece, comparala con la lista de Entra.
AADServicePrincipalSignInLogs
| extend AgentType = tostring(parse_json(Agent).agentType)
| where isnotempty(AgentType) and AgentType != "notAgentic"
| summarize LastSignIn = max(TimeGenerated), SignIns = count() by ServicePrincipalId, ServicePrincipalName, AgentType
| extend DaysSinceSignIn = datetime_diff("day", now(), LastSignIn)
| where DaysSinceSignIn > 30
| order by DaysSinceSignIn desc

// ── Query 5: Agentes cuyo propietario ya no es una cuenta activa (Advanced Hunting) ──────────────────────────────────
// Une AgentsInfo.Owners (ids de objeto de usuario) con IdentityInfo. Un GUID nulo no es un propietario. En el tenant de validacion la consulta devolvio agentes
// locales y de Copilot Studio con propietario de GUID nulo, y ninguna cuenta de propietario deshabilitada o eliminada.
let agents = AgentsInfo
    | where Timestamp > ago(30d)
    | summarize arg_max(Timestamp, *) by AgentId
    | where LifecycleStatus != "Deleted"
    | mv-expand Owner = parse_json(Owners)
    | extend OwnerId = tostring(Owner)
    | where isnotempty(OwnerId);
let people = IdentityInfo
    | where Timestamp > ago(30d)
    | summarize arg_max(Timestamp, *) by AccountObjectId
    | project OwnerId = AccountObjectId, OwnerUpn = AccountUpn, IsAccountEnabled, DeletedDateTime;
agents
| join kind=leftouter people on OwnerId
| extend OwnerState = case(
    OwnerId == "00000000-0000-0000-0000-000000000000", "Sin propietario real (identificador nulo)",
    isempty(OwnerUpn), "Propietario no resuelto en el directorio",
    IsAccountEnabled == false, "Cuenta del propietario deshabilitada",
    isnotnull(DeletedDateTime), "Cuenta del propietario eliminada",
    "Activo")
| where OwnerState != "Activo"
| project Name, Platform, AgentId, OwnerId, OwnerUpn, OwnerState, LastUpdatedDateTime
| order by Platform asc, Name asc
