// skill: govern-lifecycle-decommission-agent
// workspace: {workspace-name} | Q2 and Q5 run in Advanced Hunting (AgentsInfo, IdentityInfo)
// Validated on a Sentinel workspace and in Advanced Hunting (Oct 2026): the previous version read CopilotStudio_CL and FoundryAgents_CL, custom tables that do not
// exist in the validation workspace, and looked for agent service principals by text in AuditLogs. Now: Q1 uses CopilotActivity (by AgentId), Q3 the
// diagnostics of the Foundry account, Q4 the Agent column of AADServicePrincipalSignInLogs, and Q2 and Q5 the AgentsInfo and IdentityInfo inventory. All compile and
// ran; Q1 and Q3 returned no rows (no inactive agent or account in the validation tenant), Q4 and Q5 were exercised with rows.
// No query measures the "use" of an agent that never appears in an activity table: always cross-check with the inventory.

// ── Query 1: Agents with recorded interactions that have had no activity for 30 days (Copilot Studio and Agent Builder) ────
// CopilotActivity only knows the agents that had at least one interaction within the workspace retention.
let inactive_days = 30;
CopilotActivity
| where RecordType == "CopilotInteraction"
| where isnotempty(AgentId)
| summarize LastInteraction = max(TimeGenerated), Interactions = count() by AgentId, AgentName
| extend DaysInactive = datetime_diff("day", now(), LastInteraction)
| where DaysInactive > inactive_days
| order by DaysInactive desc

// ── Query 2: Active agents with no changes in 90 days (Advanced Hunting) ─────────────────────────────────────────
// LastUpdatedDateTime is the last configuration change, not the last use: it serves as candidates to review, not as proof of inactivity. It is limited to the
// platforms you manage: in the validation tenant most of the inventory is the catalog of Microsoft and partner agents (Platform "Other").
AgentsInfo
| where Timestamp > ago(30d)
| summarize arg_max(Timestamp, *) by AgentId
| where Platform in ("Copilot Studio", "Microsoft Foundry")
| where LifecycleStatus == "Active"
| where LastUpdatedDateTime < ago(90d)
| project Name, Platform, AgentId, PublishedStatus, LastUpdatedDateTime, LastPublishedDateTime, OwnerCount = array_length(parse_json(Owners))
| order by LastUpdatedDateTime asc

// ── Query 3: Foundry accounts with no calls in 30 days ─────────────────────────────────────────────────────────
// The diagnostics carry no agent name: the inactivity is of the Foundry account, not of an agent.
AzureDiagnostics
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES" and Category == "RequestResponse"
| summarize LastCall = max(TimeGenerated), Requests = count() by Resource
| extend DaysInactive = datetime_diff("day", now(), LastCall)
| where DaysInactive > 30
| order by DaysInactive desc

// ── Query 4: Entra agent identities with no sign-in in 30 days ──────────────────────────────────────────────────────
// The Agent column of AADServicePrincipalSignInLogs is a JSON with agentType (agenticAppInstance, agentIdentityBlueprintPrincipal or notAgentic).
// It only sees identities that signed in within the retention: an identity that never signed in does not appear, compare it with the Entra list.
AADServicePrincipalSignInLogs
| extend AgentType = tostring(parse_json(Agent).agentType)
| where isnotempty(AgentType) and AgentType != "notAgentic"
| summarize LastSignIn = max(TimeGenerated), SignIns = count() by ServicePrincipalId, ServicePrincipalName, AgentType
| extend DaysSinceSignIn = datetime_diff("day", now(), LastSignIn)
| where DaysSinceSignIn > 30
| order by DaysSinceSignIn desc

// ── Query 5: Agents whose owner is no longer an active account (Advanced Hunting) ────────────────────────────────────
// Joins AgentsInfo.Owners (user object ids) with IdentityInfo. A null GUID is not an owner. In the validation tenant the query returned local agents
// and Copilot Studio agents with a null-GUID owner, and no disabled or deleted owner account.
let agents = AgentsInfo
    | where Timestamp > ago(30d)
    | summarize arg_max(Timestamp, *) by AgentId
    | where LifecycleStatus != "Deleted"
    | mv-expand Owner = parse_json(Owners)
    | extend OwnerId = tostring(Owner)
    | where isnotempty(OwnerId);
let people = IdentityInfo
    | where Timestamp > ago(30d)
    | summarize arg_max(Timestamp, *) by AccountObjectId
    | project OwnerId = AccountObjectId, OwnerUpn = AccountUpn, IsAccountEnabled, DeletedDateTime;
agents
| join kind=leftouter people on OwnerId
| extend OwnerState = case(
    OwnerId == "00000000-0000-0000-0000-000000000000", "No real owner (null identifier)",
    isempty(OwnerUpn), "Owner not resolved in the directory",
    IsAccountEnabled == false, "Owner account disabled",
    isnotnull(DeletedDateTime), "Owner account deleted",
    "Active")
| where OwnerState != "Active"
| project Name, Platform, AgentId, OwnerId, OwnerUpn, OwnerState, LastUpdatedDateTime
| order by Platform asc, Name asc
