// skill: govern-pim-agent-roles
// workspace: {workspace-name} | required connector: AuditLogs-EntraID, AzureActivity
// Validated on a Sentinel workspace (Oct 2026): Q1 to Q4 rewritten.
//  - In PIM events the role and the principal arrive in TargetResources in an order that changes with the operation:
//    they are selected by type, not by index. Direct assignments outside PIM ("Add member to role") have a different
//    shape (the role comes in the Role.DisplayName property and the user in userPrincipalName): they are read in Q3 of
//    sentinel-identity-abuse.kql, and these queries only use the PIM operations.
//  - AdditionalDetails is an array of {key, value} (Justification, StartTime, ExpirationTime): it is read by key.
//  - Each activation generates three events (requested, completed, expired) and the completed event is initiated by an
//    application (the PIM service), not by the person: the principal is the target of type User, ServicePrincipal or Group.

// ── Query 1: Completed PIM activations, by principal and role ─────────────────
// To see only agents, filter PrincipalType == "ServicePrincipal". The previous version mixed the
// eligible assignments ("Add eligible member to role") with the activations and read the principal and the role by
// index; the justification came out as the full AdditionalDetails array.
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Add member to role completed (PIM activation)"
| mv-apply TR = TargetResources on (
    summarize
        RoleName        = take_anyif(tostring(TR.displayName), tostring(TR.type) == "Role"),
        TargetPrincipal = take_anyif(tostring(TR.displayName), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        PrincipalType   = take_anyif(tostring(TR.type), tostring(TR.type) in ("User", "ServicePrincipal", "Group")))
| mv-apply AD = AdditionalDetails on (
    summarize
        Justification  = take_anyif(tostring(AD.value), tostring(AD.key) == "Justification"),
        StartTime      = take_anyif(todatetime(AD.value), tostring(AD.key) == "StartTime"),
        ExpirationTime = take_anyif(todatetime(AD.value), tostring(AD.key) == "ExpirationTime"))
| project TimeGenerated, TargetPrincipal, PrincipalType, RoleName, Justification, StartTime, ExpirationTime
| order by TimeGenerated desc

// ── Query 2: Activations outside business hours (possible anomaly) ────────────
let business_hours_start = 8;
let business_hours_end   = 20;
// Only the completed event: with "has PIM activation" each activation was counted three times (requested,
// completed, expired), and the initiator of the completed event is the PIM service, not the person.
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Add member to role completed (PIM activation)"
| extend HourUTC = datetime_part("Hour", TimeGenerated)
| where HourUTC < business_hours_start or HourUTC > business_hours_end
| mv-apply TR = TargetResources on (
    summarize
        RoleName        = take_anyif(tostring(TR.displayName), tostring(TR.type) == "Role"),
        TargetPrincipal = take_anyif(tostring(TR.displayName), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        PrincipalType   = take_anyif(tostring(TR.type), tostring(TR.type) in ("User", "ServicePrincipal", "Group")))
| project TimeGenerated, HourUTC, TargetPrincipal, RoleName
| extend Alert = "PIM activation outside business hours: review"
| order by TimeGenerated desc

// ── Query 3: Service principals with direct Azure RBAC roles (no PIM) ─────────
// Detect permanent assignments that should be eligible
// Azure RBAC role assignments are not in AuditLogs (Entra): they are in AzureActivity. The previous version
// read a "Create role assignment" operation and an AdditionalDetails that do not exist in AuditLogs, so it never
// returned rows. The request body (principalType, roleDefinitionId) only comes in the "Start" event;
// the "Success" event does not carry it. The role is resolved by the GUID of the built-in role.
let HighPrivilegeRoles = datatable(RoleGuid: string, RoleAssigned: string) [
    "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "Owner",
    "b24988ac-6180-42a0-ab88-20f7382dd24c", "Contributor",
    "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9", "User Access Administrator"
];
AzureActivity
| where TimeGenerated > ago(90d)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
| where ActivityStatusValue == "Start"
| extend Props = parse_json(Properties)
| extend Body = parse_json(tostring(Props.requestbody))
| extend
    AssignedTo    = tostring(Body.properties.principalId),
    PrincipalType = tostring(Body.properties.principalType),
    RoleGuid      = tolower(extract(@"roleDefinitions/([0-9a-fA-F-]{36})", 1, tostring(Body.properties.roleDefinitionId)))
| where PrincipalType == "ServicePrincipal"
| join kind=inner HighPrivilegeRoles on RoleGuid
| extend
    Scope      = extract(@"^(.*)/providers/Microsoft\.Authorization/roleAssignments", 1, tostring(Props.entity)),
    AssignedBy = Caller
| project TimeGenerated, AssignedTo, RoleAssigned, Scope, AssignedBy
| extend Risk = "High-privilege role assigned directly: evaluate migration to PIM"
| order by TimeGenerated desc

// ── Query 4: Duration and frequency of PIM activations (detect long activations) ───────
// The previous version computed the duration with toint(tostring(AdditionalDetails)), which is not a number (it is an
// array of {key, value}), and grouped by the initiator, which in the completed event is the PIM service. The duration
// comes from StartTime and ExpirationTime. In the validation workspace there is 1 activation in 90 days (1 hour), so
// no threshold is met: the threshold logic was not exercised with data.
let long_activation_hrs = 8;  // adjust to the maximum duration configured in the role policy
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Add member to role completed (PIM activation)"
| mv-apply TR = TargetResources on (
    summarize
        RoleName        = take_anyif(tostring(TR.displayName), tostring(TR.type) == "Role"),
        TargetPrincipal = take_anyif(tostring(TR.displayName), tostring(TR.type) in ("User", "ServicePrincipal", "Group")),
        PrincipalType   = take_anyif(tostring(TR.type), tostring(TR.type) in ("User", "ServicePrincipal", "Group")))
| mv-apply AD = AdditionalDetails on (
    summarize
        Justification  = take_anyif(tostring(AD.value), tostring(AD.key) == "Justification"),
        StartTime      = take_anyif(todatetime(AD.value), tostring(AD.key) == "StartTime"),
        ExpirationTime = take_anyif(todatetime(AD.value), tostring(AD.key) == "ExpirationTime"))
| extend DurationHrs = datetime_diff("minute", ExpirationTime, StartTime) / 60.0
| summarize
    ActivationCount = count(),
    AvgDurationHrs  = avg(DurationHrs),
    MaxDurationHrs  = max(DurationHrs),
    LastActivation  = max(TimeGenerated)
  by TargetPrincipal, RoleName
| where ActivationCount > 5 or MaxDurationHrs > long_activation_hrs
| order by ActivationCount desc
