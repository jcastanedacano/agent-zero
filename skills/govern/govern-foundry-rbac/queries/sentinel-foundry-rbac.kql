// skill: govern-foundry-rbac
// workspace: {workspace-name} | connectors: Azure Activity; Q1 and Q2 run in Azure Resource Graph (not in Log Analytics)
// Validated on a Sentinel workspace and in Azure Resource Graph (Oct 2026): the previous version of the skill pointed to a file that did not exist and its query read MICROSOFT.MACHINELEARNINGSERVICES and an
// agentId property that the Activity Log does not carry. Foundry is Microsoft.CognitiveServices/accounts (kind AIServices) and its projects are child resources. Connections and deployments are NOT in Resource Graph (only
// accounts and projects): they are read with the CLI (steps 3 and 4 of the skill). Q1 to Q4 compile and ran; the result on the validation account is next to each query.

// ── Query 1 (Azure Resource Graph): matrix of Foundry-relevant roles by scope level and principal type ────────────────
// The IDs are those of the built-in roles (the Foundry roles were renamed: that is why the ID is used). A Foundry role at Resource group or Subscription level applies to all Foundry accounts in that scope.
// Result on the validation account: 10 rows (includes Foundry User at subscription level, Azure AI Developer on the account, and Contributor and Owner for several service principals).
authorizationresources
| where type =~ "microsoft.authorization/roleassignments"
| extend Scope = tolower(tostring(properties.scope)), RoleId = tolower(tostring(split(tostring(properties.roleDefinitionId), "/")[-1])), PrincipalType = tostring(properties.principalType)
| extend Role = case(
    RoleId == "53ca6127-db72-4b80-b1b0-d745d6d5456d", "Foundry User",
    RoleId == "eed3b665-ab3a-47b6-8f48-c9382fb1dad6", "Foundry Agent Consumer",
    RoleId == "eadc314b-1a2d-4efa-be10-5d325db5065e", "Foundry Project Manager",
    RoleId == "e47c6f54-e4a2-4754-9501-8e0985b135e1", "Foundry Account Owner",
    RoleId == "c883944f-8b7b-4483-af10-35834be79c4a", "Foundry Owner",
    RoleId == "a97b65f3-24c7-4388-baec-2e87135dc908", "Cognitive Services User",
    RoleId == "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68", "Cognitive Services Contributor",
    RoleId == "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd", "Cognitive Services OpenAI User",
    RoleId == "a001fd3d-188f-4b5d-821b-7da978bf7442", "Cognitive Services OpenAI Contributor",
    RoleId == "64702f94-c441-49e6-a78b-ef80e0188fee", "Azure AI Developer",
    RoleId == "3afb7f49-54cb-416e-8c09-6dc049efa503", "Azure AI Inference Deployment Operator",
    RoleId == "b78c5d69-af96-48a3-bf8d-a8b4d589de94", "Azure AI Administrator",
    RoleId == "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "Owner",
    RoleId == "b24988ac-6180-42a0-ab88-20f7382dd24c", "Contributor",
    RoleId == "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9", "User Access Administrator",
    "")
| where isnotempty(Role)
| extend ScopeLevel = case(
    Scope contains "/agents/", "Agent",
    Scope contains "/projects/", "Project",
    Scope contains "microsoft.cognitiveservices/accounts", "Foundry account",
    Scope contains "/resourcegroups/", "Resource group",
    "Subscription")
| summarize Assignments = count() by Role, ScopeLevel, PrincipalType
| order by ScopeLevel asc, Role asc

// ── Query 2 (Azure Resource Graph): assignments that require a decision ─────────────────────────────────────────────
// Flags Cognitive Services roles (list keys), Azure AI Developer (belongs to Azure Machine Learning), Azure AI Inference Deployment Operator (creates deployments, does not call), Owner and Contributor (manage the account
// and, with keys enabled, can list them), and any Foundry role with a scope broader than the account. Owner and Contributor at subscription level are not specific to Foundry: they are expected noise in a lab tenant.
// Result on the validation account: 13 rows in 3 resource groups and the subscription; PrincipalId is the Entra object (resolve it in the directory).
authorizationresources
| where type =~ "microsoft.authorization/roleassignments"
| extend Scope = tolower(tostring(properties.scope)), RoleId = tolower(tostring(split(tostring(properties.roleDefinitionId), "/")[-1])), PrincipalType = tostring(properties.principalType), PrincipalId = tostring(properties.principalId), CreatedOn = todatetime(properties.createdOn)
| extend Role = case(
    RoleId == "53ca6127-db72-4b80-b1b0-d745d6d5456d", "Foundry User",
    RoleId == "eed3b665-ab3a-47b6-8f48-c9382fb1dad6", "Foundry Agent Consumer",
    RoleId == "eadc314b-1a2d-4efa-be10-5d325db5065e", "Foundry Project Manager",
    RoleId == "e47c6f54-e4a2-4754-9501-8e0985b135e1", "Foundry Account Owner",
    RoleId == "c883944f-8b7b-4483-af10-35834be79c4a", "Foundry Owner",
    RoleId == "a97b65f3-24c7-4388-baec-2e87135dc908", "Cognitive Services User",
    RoleId == "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68", "Cognitive Services Contributor",
    RoleId == "64702f94-c441-49e6-a78b-ef80e0188fee", "Azure AI Developer",
    RoleId == "3afb7f49-54cb-416e-8c09-6dc049efa503", "Azure AI Inference Deployment Operator",
    RoleId == "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "Owner",
    RoleId == "b24988ac-6180-42a0-ab88-20f7382dd24c", "Contributor",
    "")
| where isnotempty(Role)
| extend ScopeLevel = case(
    Scope contains "/agents/", "Agent",
    Scope contains "/projects/", "Project",
    Scope contains "microsoft.cognitiveservices/accounts", "Foundry account",
    Scope contains "/resourcegroups/", "Resource group",
    "Subscription")
| extend Risk = case(
    RoleId in ("a97b65f3-24c7-4388-baec-2e87135dc908", "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68"), "Cognitive Services role: can list the account keys",
    RoleId == "64702f94-c441-49e6-a78b-ef80e0188fee", "Azure AI Developer: belongs to Azure Machine Learning and hubs, not to Foundry projects",
    RoleId == "3afb7f49-54cb-416e-8c09-6dc049efa503", "Creates deployments, it is not a role for calling agents or models",
    RoleId in ("8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "b24988ac-6180-42a0-ab88-20f7382dd24c"), "Manages the account; with keys enabled it can list them and call without going through RBAC",
    ScopeLevel in ("Resource group", "Subscription"), "Foundry role with a scope broader than the account: applies to all Foundry accounts in that scope",
    "")
| where isnotempty(Risk)
| project CreatedOn, Role, ScopeLevel, PrincipalType, PrincipalId, Scope, Risk
| order by ScopeLevel asc, Role asc

// ── Query 3: Management changes in Foundry (accounts, projects, connections and model deployments) ──────────────────
// A new connection or a new deployment changes what an agent can reach. Whoever makes them should be someone with a management role (Foundry Account Owner or Foundry Owner), not an unexpected application identity.
// The Activity Log does not carry the body of these operations in the validation workspace: it says who, when and on which resource, not which property changed. The name is read from Properties.entity.
// Result on the validation account: 6 rows in 90 days (the account, a deployment, two connections and two project writes).
let lookback = 90d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where ActivityStatusValue == "Success"
| where OperationNameValue in~ (
    "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/DELETE",
    "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PROJECTS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PROJECTS/DELETE",
    "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/CONNECTIONS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/CONNECTIONS/DELETE",
    "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PROJECTS/CONNECTIONS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/PROJECTS/CONNECTIONS/DELETE",
    "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/DEPLOYMENTS/WRITE", "MICROSOFT.COGNITIVESERVICES/ACCOUNTS/DEPLOYMENTS/DELETE")
| extend Entity = tostring(parse_json(Properties).entity)
| extend Kind = case(
        OperationNameValue has "CONNECTIONS", "Connection",
        OperationNameValue has "DEPLOYMENTS", "Model deployment",
        OperationNameValue has "PROJECTS", "Project",
        "Foundry account"),
    Action = iff(OperationNameValue endswith "DELETE", "Deletion", "Creation or change"),
    Name = tostring(split(Entity, "/")[-1]),
    CallerKind = case(Caller matches regex @"^[0-9a-fA-F-]{36}$", "Application identity", Caller has "@", "User", "Other")
| project TimeGenerated, Caller, CallerKind, Kind, Action, Name, CallerIpAddress
| order by TimeGenerated desc

// ── Query 4: Role assignments and removals under the scope of a Foundry account ─────────────────────────────────────
// It only covers the assignments made on the account, a project or an agent; those at resource group or subscription level appear in Q2 of Resource Graph, not here. The specific role of a new
// assignment is in the Start event (see Q3 of the skill secure-managed-identity-foundry); a removal carries no body.
// Result on the validation account: 3 assignments in 180 days (two on the account and one on the project), no removals.
let lookback = 180d;
AzureActivity
| where TimeGenerated > ago(lookback)
| where OperationNameValue in~ ("MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/DELETE") and ActivityStatusValue == "Success"
| extend Entity = tostring(parse_json(Properties).entity)
| where tolower(Entity) contains "microsoft.cognitiveservices/accounts"
| extend Scope = tolower(tostring(split(Entity, "/providers/Microsoft.Authorization")[0]))
| extend ScopeLevel = case(Scope contains "/agents/", "Agent", Scope contains "/projects/", "Project", "Foundry account"),
         Action = iff(OperationNameValue endswith "DELETE", "Removal", "Assignment")
| project TimeGenerated, Caller, Action, ScopeLevel, Scope, CallerIpAddress
| order by TimeGenerated desc
