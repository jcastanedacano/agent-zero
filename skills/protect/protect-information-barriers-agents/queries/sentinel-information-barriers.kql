// skill: protect-information-barriers-agents
// workspace: {workspace-name} | connector: Microsoft 365 (OfficeActivity)
// Validated on a Sentinel workspace (Oct 2026): the previous version read PurviewAuditLog and looked for InformationBarrierPolicyViolation, IBPolicyViolation and
// CrossSegmentAccess operations, which are not in the Learn list of audit activities. The documented Information Barriers activities are from SharePoint and
// OneDrive: SPOIBIsEnabled, SPOIBIsDisabled, SiteIBModeSet, SiteIBModeChanged, SiteIBSegmentsSet, SiteIBSegmentsChanged, SiteIBSegmentsRemoved and
// AppBypassInformationBarrier (Q1). Learn does not document a "violation" event: an access blocked by IB does not arrive as an event. That is why Q2 and Q3 cross-reference the accesses
// from OfficeActivity with YOUR segment map. Q2 and Q3 compile and ran with a sample map; Q1 compiles and has no rows (NOT VERIFIED).

// ── Query 1: Administrative changes to Information Barriers in SharePoint and OneDrive ────────────────────────────────
// SPOIBIsDisabled and AppBypassInformationBarrier are the two that weaken the control: always alert.
OfficeActivity
| where TimeGenerated > ago(90d)
| where Operation in (
    "SPOIBIsEnabled", "SPOIBIsDisabled",
    "SiteIBModeSet", "SiteIBModeChanged",
    "SiteIBSegmentsSet", "SiteIBSegmentsChanged", "SiteIBSegmentsRemoved",
    "AppBypassInformationBarrier")
| project TimeGenerated, UserId, Operation, Site_Url, Parameters
| order by TimeGenerated desc

// ── Query 2: Users in one segment who access sites in a blocked segment ──────────────────────────────────────────────
// Replace the three datatables with your map: user to segment, site to segment and blocked pairs. The site name is the fourth fragment of the URL
// (https://tenant.sharepoint.com/sites/<site>/). For long lists, use a Sentinel Watchlist with _GetWatchlist().
let UserSegment = datatable(UserId: string, Segment: string) [
    "user1@contoso.com", "Finance",
    "user2@contoso.com", "Legal"
];
let SiteSegment = datatable(SiteName: string, Segment: string) [
    "finance-reports", "Finance",
    "legal-cases",     "Legal"
];
let BlockedPairs = datatable(SegmentA: string, SegmentB: string) [
    "Finance", "Legal",
    "Legal",   "Finance"
];
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded")
| where UserType == "Regular"
| extend SiteName = tostring(split(Site_Url, "/")[4])
| join kind=inner UserSegment on UserId
| join kind=inner (SiteSegment | project SiteName, SiteSegmentName = Segment) on SiteName
| join kind=inner BlockedPairs on $left.Segment == $right.SegmentA and $left.SiteSegmentName == $right.SegmentB
| summarize AccessCount = count(), Files = dcount(OfficeObjectId), Operations = make_set(Operation, 5)
    by UserId, UserSegment = Segment, SiteName, SiteSegment = SiteSegmentName
| extend Alert = "Access to a site in a segment that the Information Barriers policy separates from the segment of the user"
| order by AccessCount desc

// ── Query 3: Applications or agents with access to sites in more than one segment ───────────────────────────────────
// Information Barriers segments users and groups (Entra or Exchange attributes): Learn does not document a segment for a service principal or for an agent
// identity. This query lists the applications that touch sites in more than one segment, which are the ones IB does not separate. It uses the same SiteSegment as Q2.
let SiteSegment = datatable(SiteName: string, Segment: string) [
    "finance-reports", "Finance",
    "legal-cases",     "Legal"
];
OfficeActivity
| where TimeGenerated > ago(30d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where UserType == "Application"
| extend SiteName = tostring(split(Site_Url, "/")[4])
| join kind=inner SiteSegment on SiteName
| summarize Segments = make_set(Segment), Sites = dcount(SiteName), Events = count(), Files = dcount(OfficeObjectId) by ApplicationId
| extend SegmentCount = array_length(Segments)
| where SegmentCount > 1
| extend Alert = "Application with access to sites in more than one segment: IB does not separate it"
| order by Events desc
