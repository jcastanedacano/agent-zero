// skill: protect-purview-ai-hub-monitoring
// workspace: {workspace-name} | connector: Microsoft Copilot (CopilotActivity)
// Validated on a Sentinel workspace (Oct 2026): the previous version read PurviewAuditLog and MicrosoftDataLossPrevention, tables that do not exist in that workspace, and
// looked for Workload "AIHub". The interactions of Copilot, agents and AI applications arrive in CopilotActivity (Microsoft Copilot connector): RecordType
// CopilotInteraction and AIAppInteraction, Workload, AppIdentity, AppHost and the resources Copilot accessed (AccessedResources). What only lives in the
// DSPM for AI activity explorer is the text of prompts and responses, the sensitive information types detected and the DLP matches:
// they are not in any Sentinel table. All queries compile and ran on the workspace (245 rows in CopilotActivity); Q3 returned no rows
// because the 2 resources listed in 90 days carry no label.

// ── Query 1: Interaction volume by AI application (30 days) ──────────────────────────────────────────────────────
let lookback = 30d;
CopilotActivity
| where TimeGenerated > ago(lookback)
| where RecordType in ("CopilotInteraction", "AIAppInteraction")
| summarize
    Interactions = count(),
    Users        = dcount(ActorUserId),
    LastActivity = max(TimeGenerated)
  by RecordType, Workload, AppIdentity
| order by Interactions desc

// ── Query 2: Users with the highest volume of AI interactions ────────────────────────────────────────────────────
CopilotActivity
| where TimeGenerated > ago(lookback)
| where RecordType in ("CopilotInteraction", "AIAppInteraction")
| summarize
    TotalInteractions = count(),
    UniqueApps        = dcount(AppIdentity),
    UniqueAgents      = dcount(AgentId),
    LastSeen          = max(TimeGenerated)
  by ActorName
| top 20 by TotalInteractions

// ── Query 3: Sensitivity labels of the resources Copilot read ────────────────────────────────────────────────────
// The audit record carries SensitivityLabelId per resource (the GUID, not the name). It replaces the detection of sensitive information types, which the
// record does not carry. Same source as KQL Library P04-Q6.
CopilotActivity
| where TimeGenerated > ago(lookback)
| where RecordType == "CopilotInteraction"
| mv-expand Resource = LLMEventData.AccessedResources
| extend LabelId = tostring(Resource.SensitivityLabelId)
| where isnotempty(LabelId)
| summarize Reads = count(), Users = dcount(ActorUserId), LastRead = max(TimeGenerated) by LabelId
| order by Reads desc

// ── Query 4: AI interactions outside working hours (UTC) ────────────────────────────────────────────────────────
CopilotActivity
| where TimeGenerated > ago(7d)
| where RecordType in ("CopilotInteraction", "AIAppInteraction")
| extend HourUTC = datetime_part("hour", TimeGenerated)
| where HourUTC < 6 or HourUTC > 22
| summarize OffHoursCount = count(), UniqueUsers = dcount(ActorUserId) by Day = bin(TimeGenerated, 1d), Workload
| order by Day desc

// ── Query 5: Daily interaction trend (baseline of normal activity) ───────────────────────────────────────────────
CopilotActivity
| where TimeGenerated > ago(30d)
| where RecordType in ("CopilotInteraction", "AIAppInteraction")
| summarize DailyCount = count() by Day = bin(TimeGenerated, 1d)
| order by Day asc
