// skill: protect-sensitivity-labels-ai-outputs
// workspace: {workspace-name} | connectors: Microsoft 365 (OfficeActivity), Microsoft Purview Information Protection (MicrosoftPurviewInformationProtection)
// Validated on a Sentinel workspace (Oct 2026): the previous version read PurviewAuditLog and MicrosoftDataLossPrevention, tables that do not exist in that workspace.
// The labeling events are in MicrosoftPurviewInformationProtection (Operation FileSensitivityLabelApplied, SensitivityLabelApplied and
// AutoSensitivityLabelRuleMatch, with SensitivityLabelId, ActionSource and sometimes LabelName) and the label of each file that is touched is in OfficeActivity
// (SensitivityLabelId). An application or agent with application permissions appears with UserType Application. The label name only comes in some Purview
// events: the rest stays as a GUID and is resolved in Purview (Information protection, Labels). All compile and ran: Q1 to Q3 and Q5 returned rows, and Q4
// returned rows with a real label GUID (with the empty list it returns nothing).
// hc_label_ids is the list of GUIDs of your Highly Confidential labels: replace it.

// ── Query 1: Labels applied or auto-labeling matches in 30 days ──────────────────────────────────────────────────────
MicrosoftPurviewInformationProtection
| where TimeGenerated > ago(30d)
| where Operation in ("FileSensitivityLabelApplied", "SensitivityLabelApplied", "AutoSensitivityLabelRuleMatch")
| summarize Events = count(), Files = dcount(ObjectId), LastEvent = max(TimeGenerated)
    by Workload, Operation, ActionSource, SensitivityLabelId, LabelName
| order by Events desc

// ── Query 2: Files touched by applications or agents without a label ────────────────────────────────────────────────
// A file with no SensitivityLabelId that an application reads or writes in SharePoint or OneDrive.
OfficeActivity
| where TimeGenerated > ago(30d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileModified", "FileUploaded", "FileAccessed")
| where UserType == "Application"
| where isempty(SensitivityLabelId)
| summarize UnlabeledEvents = count(), Files = dcount(OfficeObjectId) by Site_Url, ApplicationId
| order by UnlabeledEvents desc
| take 50

// ── Query 3: Distribution of labels on the content that applications touch ──────────────────────────────────────────
let labels = MicrosoftPurviewInformationProtection
    | where isnotempty(SensitivityLabelId) and isnotempty(LabelName)
    | summarize LabelName = any(LabelName) by SensitivityLabelId;
OfficeActivity
| where TimeGenerated > ago(30d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where UserType == "Application"
| where isnotempty(SensitivityLabelId)
| join kind=leftouter labels on SensitivityLabelId
| extend LabelShown = iff(isnotempty(LabelName), LabelName, "Label with no resolved name")
| summarize Events = count(), Files = dcount(OfficeObjectId) by SensitivityLabelId, LabelShown
| order by Events desc

// ── Query 4: Applications or agents that accessed Highly Confidential files ─────────────────────────────────────────
// High priority: an agent should not access Highly Confidential without explicit approval.
let hc_label_ids = dynamic([]);   // GUIDs of your Highly Confidential labels
OfficeActivity
| where TimeGenerated > ago(30d)
| where Operation in ("FileAccessed", "FileDownloaded")
| where UserType == "Application"
| where SensitivityLabelId in (hc_label_ids)
| summarize Events = count(), Files = dcount(OfficeObjectId), LastSeen = max(TimeGenerated) by ApplicationId
| extend Alert = "Application or agent accessed Highly Confidential content: review"
| order by Events desc

// ── Query 5: Label coverage (% of file events on labeled content), by day and actor type ─────────────────────────────────
OfficeActivity
| where TimeGenerated > ago(30d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileModified", "FileUploaded", "FileAccessed")
| summarize Total = count(), Labeled = countif(isnotempty(SensitivityLabelId))
    by Day = bin(TimeGenerated, 1d), Initiator = iff(UserType == "Application", "Application", "User")
| extend CoveragePct = round(100.0 * Labeled / Total, 1)
| order by Day asc, Initiator asc
