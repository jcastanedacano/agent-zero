// skill: protect-data-loss-prevention-agent-outputs
// workspace: {workspace-name} | conector: Microsoft 365 (OfficeActivity)
// Validado en un workspace Sentinel (oct 2026): la version anterior leia MicrosoftDataLossPrevention y PurviewAuditLog, tablas que no existen en ese workspace.
// Todo sale de OfficeActivity: las coincidencias DLP son operaciones DLPRuleMatch (SharePoint y OneDrive) o DlpRuleMatch (Exchange), la etiqueta de un archivo va
// en SensitivityLabelId, y los destinatarios de un correo van en Item.Recipients. Un evento DLP trae el usuario y el tipo de registro, no el nombre de la politica
// (el nombre llega en las alertas de SecurityAlert: ver govern-dlp-policy-copilot-prompts Q3). Todas compilan y se ejecutaron: Q1, Q2, Q4 y Q5 devolvieron filas, y Q3
// devolvio filas con un GUID de etiqueta real (con la lista vacia no devuelve nada).
// ai_label_ids es la lista de GUID de tus etiquetas para contenido de IA: sustituyela.
let ai_label_ids = dynamic([]);   // GUID de la etiqueta Confidential \ AI-Generated y sus equivalentes

// ── Query 1: Coincidencias DLP en SharePoint, OneDrive y Exchange (7 dias) ──────────────────────────────────────────
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive", "Exchange")
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| project TimeGenerated, UserId, UserType, Workload = OfficeWorkload, RecordType, OfficeObjectId
| order by TimeGenerated desc

// ── Query 2: Enlaces anonimos o invitaciones a invitados creados en SharePoint y OneDrive (7 dias) ────────────────────
// Validado: los eventos AnonymousLinkCreated existen en el workspace y traen el archivo. La etiqueta no viaja en el evento de compartir: cruza el archivo con
// la etiqueta por Query 3 o con el inventario de etiquetas.
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("SharingInvitationCreated", "AnonymousLinkCreated", "SecureLinkCreated", "SharingSet", "AddedToSecureLink")
| where TargetUserOrGroupType =~ "Guest" or Operation == "AnonymousLinkCreated"
| project TimeGenerated, UserId, Operation, FileName = SourceFileName, Site = Site_Url, SharedWith = TargetUserOrGroupName
| order by TimeGenerated desc

// ── Query 3: Volumen de acceso a archivos con etiqueta de IA por usuario o aplicacion (ventana de 30 minutos) ─────────────
// Un usuario o una aplicacion que lee muchos archivos con la etiqueta de IA en poco tiempo. Para vigilar solo agentes, filtra por UserType == "Application".
OfficeActivity
| where TimeGenerated > ago(1d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded")
| where SensitivityLabelId in (ai_label_ids)
| extend Actor = iff(UserType == "Application", strcat("app:", ApplicationId), UserId)
| summarize FileCount = dcount(OfficeObjectId), Events = count(), LastSeen = max(TimeGenerated) by Actor, Window = bin(TimeGenerated, 30m)
| where FileCount > 20   // ajustar segun la linea base del tenant
| extend Alert = strcat("Volumen anomalo: ", FileCount, " archivos con etiqueta de IA en la ventana")
| order by FileCount desc

// ── Query 4: Correo con coincidencia DLP enviado a dominios externos ─────────────────────────────────────────────────
// Une el evento Send (Item.InternetMessageId, Item.Recipients) con el DlpRuleMatch de Exchange (OfficeObjectId). Incluye correo de usuarios y de aplicaciones:
// para solo aplicaciones, filtra por SenderType == "Application".
let lookback = 7d;
let internal_domains = dynamic(["contoso.com"]);   // ajustar al tenant
let sent = OfficeActivity
    | where TimeGenerated > ago(lookback)
    | where OfficeWorkload == "Exchange" and Operation in ("Send", "SendAs", "SendOnBehalf")
    | extend ItemJson = parse_json(Item)
    | mv-expand Recipient = ItemJson.Recipients
    | extend RecipientAddress = tolower(tostring(Recipient.Address))
    | extend RecipientDomain = tostring(split(RecipientAddress, "@")[1])
    | where RecipientDomain !in (internal_domains)
    | summarize ExternalRecipients = make_set(RecipientAddress, 10)
        by SentTime = TimeGenerated, Sender = UserId, SenderType = UserType, Subject = tostring(ItemJson.Subject), MessageId = tostring(ItemJson.InternetMessageId);
OfficeActivity
| where TimeGenerated > ago(lookback)
| where OfficeWorkload == "Exchange" and Operation in ("DlpRuleMatch", "DLPRuleMatch")
| project DlpTime = TimeGenerated, MessageId = OfficeObjectId
| join kind=inner sent on MessageId
| project SentTime, DlpTime, Sender, SenderType, Subject, ExternalRecipients
| extend Risk = "Correo con coincidencia DLP enviado a un dominio externo"
| order by SentTime desc

// ── Query 5: Objetos con mas coincidencias DLP (7 dias) ──────────────────────────────────────────────────────────
// OfficeObjectId es el identificador del archivo en SharePoint y OneDrive y el InternetMessageId en Exchange.
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive", "Exchange")
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| summarize Matches = count(), UniqueUsers = dcount(UserId) by OfficeObjectId, Workload = OfficeWorkload
| order by Matches desc
| take 20
