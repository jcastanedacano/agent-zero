// skill: protect-data-loss-prevention-agent-outputs
// workspace: {workspace-name} | connector: Microsoft 365 (OfficeActivity)
// Validated on a Sentinel workspace (Oct 2026): the previous version read MicrosoftDataLossPrevention and PurviewAuditLog, tables that do not exist in that workspace.
// Everything comes from OfficeActivity: DLP matches are DLPRuleMatch operations (SharePoint and OneDrive) or DlpRuleMatch (Exchange), the label of a file goes
// in SensitivityLabelId, and the recipients of an email go in Item.Recipients. A DLP event carries the user and the record type, not the policy name
// (the name arrives in the SecurityAlert alerts: see govern-dlp-policy-copilot-prompts Q3). All of them compile and ran: Q1, Q2, Q4 and Q5 returned rows, and Q3
// returned rows with a real label GUID (with the empty list it returns nothing).
// ai_label_ids is the list of GUIDs of your labels for AI content: replace it.
let ai_label_ids = dynamic([]);   // GUID of the Confidential \ AI-Generated label and its equivalents

// ── Query 1: DLP matches in SharePoint, OneDrive and Exchange (7 days) ──────────────────────────────────────────────
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive", "Exchange")
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| project TimeGenerated, UserId, UserType, Workload = OfficeWorkload, RecordType, OfficeObjectId
| order by TimeGenerated desc

// ── Query 2: Anonymous links or guest invitations created in SharePoint and OneDrive (7 days) ─────────────────────────
// Validated: AnonymousLinkCreated events exist in the workspace and carry the file. The label does not travel in the sharing event: cross-reference the file with
// the label through Query 3 or with the label inventory.
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("SharingInvitationCreated", "AnonymousLinkCreated", "SecureLinkCreated", "SharingSet", "AddedToSecureLink")
| where TargetUserOrGroupType =~ "Guest" or Operation == "AnonymousLinkCreated"
| project TimeGenerated, UserId, Operation, FileName = SourceFileName, Site = Site_Url, SharedWith = TargetUserOrGroupName
| order by TimeGenerated desc

// ── Query 3: Access volume to files with an AI label per user or application (30-minute window) ───────────────────────────
// A user or an application that reads many files with the AI label in a short time. To watch only agents, filter by UserType == "Application".
OfficeActivity
| where TimeGenerated > ago(1d)
| where OfficeWorkload in ("SharePoint", "OneDrive")
| where Operation in ("FileAccessed", "FileDownloaded")
| where SensitivityLabelId in (ai_label_ids)
| extend Actor = iff(UserType == "Application", strcat("app:", ApplicationId), UserId)
| summarize FileCount = dcount(OfficeObjectId), Events = count(), LastSeen = max(TimeGenerated) by Actor, Window = bin(TimeGenerated, 30m)
| where FileCount > 20   // adjust to the tenant baseline
| extend Alert = strcat("Anomalous volume: ", FileCount, " files with an AI label in the window")
| order by FileCount desc

// ── Query 4: Email with a DLP match sent to external domains ─────────────────────────────────────────────────────────
// Joins the Send event (Item.InternetMessageId, Item.Recipients) with the Exchange DlpRuleMatch (OfficeObjectId). Includes email from users and from applications:
// for applications only, filter by SenderType == "Application".
let lookback = 7d;
let internal_domains = dynamic(["contoso.com"]);   // adjust to the tenant
let sent = OfficeActivity
    | where TimeGenerated > ago(lookback)
    | where OfficeWorkload == "Exchange" and Operation in ("Send", "SendAs", "SendOnBehalf")
    | extend ItemJson = parse_json(Item)
    | mv-expand Recipient = ItemJson.Recipients
    | extend RecipientAddress = tolower(tostring(Recipient.Address))
    | extend RecipientDomain = tostring(split(RecipientAddress, "@")[1])
    | where RecipientDomain !in (internal_domains)
    | summarize ExternalRecipients = make_set(RecipientAddress, 10)
        by SentTime = TimeGenerated, Sender = UserId, SenderType = UserType, Subject = tostring(ItemJson.Subject), MessageId = tostring(ItemJson.InternetMessageId);
OfficeActivity
| where TimeGenerated > ago(lookback)
| where OfficeWorkload == "Exchange" and Operation in ("DlpRuleMatch", "DLPRuleMatch")
| project DlpTime = TimeGenerated, MessageId = OfficeObjectId
| join kind=inner sent on MessageId
| project SentTime, DlpTime, Sender, SenderType, Subject, ExternalRecipients
| extend Risk = "Email with a DLP match sent to an external domain"
| order by SentTime desc

// ── Query 5: Objects with the most DLP matches (7 days) ──────────────────────────────────────────────────────────
// OfficeObjectId is the file identifier in SharePoint and OneDrive and the InternetMessageId in Exchange.
OfficeActivity
| where TimeGenerated > ago(7d)
| where OfficeWorkload in ("SharePoint", "OneDrive", "Exchange")
| where Operation in ("DLPRuleMatch", "DlpRuleMatch")
| summarize Matches = count(), UniqueUsers = dcount(UserId) by OfficeObjectId, Workload = OfficeWorkload
| order by Matches desc
| take 20
